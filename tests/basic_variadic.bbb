type VariadicPair = struct
{
    left: s64,
    right: s64,
}

type VariadicLarge = struct
{
    first: s64,
    second: s64,
    third: s64,
}

code first_two : fn (first: s32, ...) s32
{
    data arguments = @va_start();
    data copy = @va_copy(&arguments);
    data second: s32 = @va_arg(&copy, s32);
    @va_end(&copy);
    @va_end(&arguments);
    return first + second;
}

code take_float : fn (...) f64
{
    data arguments = @va_start();
    data value: f64 = @va_arg(&arguments, f64);
    @va_end(&arguments);
    return value;
}

code take_pair : fn (...) s64
{
    data arguments = @va_start();
    data value: VariadicPair = @va_arg(&arguments, VariadicPair);
    @va_end(&arguments);
    return value.left + value.right;
}

code take_large : fn (...) s64
{
    data arguments = @va_start();
    data value: VariadicLarge = @va_arg(&arguments, VariadicLarge);
    @va_end(&arguments);
    return value.first + value.second + value.third;
}

code main[export] : fn [cc(c)] (argument_count: u32, argv: &&u8, envp: &&u8) s32
{
    data pair: VariadicPair = { .left = 19, .right = 23 };
    data large: VariadicLarge = { .first = 7, .second = 11, .third = 13 };
    data floating: f32 = 5.25;
    data small: u8 = 2;
    return first_two(1, small, 100) +
        @cast(take_float(floating)) +
        @cast(take_pair(pair)) +
        @cast(take_large(large)) -
        81;
}
