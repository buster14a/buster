data $this_is_a_constant: u64 = 5;

code identity : fn ($value: $T) $T
{
    return value;
}

code main : fn () s32
{
    data $local: u64 = 3;
    data first: s32 = identity(5);
    data reused: s32 = identity(5);
    data distinct_value: s32 = identity(6);
    data distinct_type: u64 = identity(this_is_a_constant);
    return first + reused + distinct_value +
        @cast(distinct_type + local);
}
