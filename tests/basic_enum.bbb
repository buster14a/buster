type Implicit = enum
{
    a,
    b,
    c,
}

type Explicit = enum
{
    a = 0,
    b = 1,
    c = 2,
}

code main[export] : fn [cc(c)] (argument_count: u32, argv: &&u8, envp: &&u8) s32
{
    data a_e : Explicit = .a;
    data b_e : Implicit = .a;
    data a: s32 = @cast(a_e);
    data b: s32 = @cast(b_e);
    data result = a + b;
    return result;
}
