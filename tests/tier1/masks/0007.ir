function (ptr, i64) -> void {
b0:
  %0 = param.ptr 0
  %1 = param.i64 1
  %2 = load.m32 %0 align=4
  %3 = address.ptr %0 offset=4
  %4 = load.m8 %3 align=1
  %5 = const.i64 0x00000000000000000000000000000000
  %6 = br.void b1
b1:
  %7 = phi.m32 [%2, b0], [%10, b1]
  %8 = phi.i64 [%5, b0], [%9, b1]
  %9 = call.i64 @9(%8) fixed=(i64) variadic=0
  %10 = not.m32 %7
  %11 = icmp.i1 %9, %1 ult
  %12 = cbr.void %11, b1, b2
b2:
  %13 = address.ptr %0 offset=128
  %14 = store.void %13, %10 align=4
  %15 = address.ptr %0 offset=132
  %16 = store.void %15, %4 align=1
  %17 = address.ptr %0 offset=136
  %18 = store.void %17, %9 align=8
  %19 = ret.void
}
