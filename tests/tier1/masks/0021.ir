function (ptr, i64) -> void {
b0:
  %0 = param.ptr 0
  %1 = param.i64 1
  %2 = load.v8i32 %0 align=1
  %3 = address.ptr %0 offset=32
  %4 = load.v8i32 %3 align=1
  %5 = address.ptr %0 offset=64
  %6 = load.v16i32 %5 align=1
  %7 = const.i64 0x00000000000000000000000000000000
  %8 = br.void b1
b1:
  %9 = phi.v8i32 [%2, b0], [%10, b1]
  %10 = phi.v8i32 [%4, b0], [%9, b1]
  %11 = phi.v16i32 [%6, b0], [%15, b1]
  %12 = phi.i64 [%7, b0], [%17, b1]
  %13 = address.ptr %0 + %12 * 4 offset=0
  %14 = load.v16i32 %13 align=4
  %15 = add.v16i32 %11, %14
  %16 = const.i64 0x00000000000000000000000000000001
  %17 = add.i64 %12, %16
  %18 = icmp.i1 %17, %1 ult
  %19 = cbr.void %18, b1, b2
b2:
  %20 = address.ptr %0 offset=128
  %21 = store.void %20, %9 align=1
  %22 = address.ptr %0 offset=160
  %23 = store.void %22, %10 align=1
  %24 = address.ptr %0 offset=192
  %25 = store.void %24, %15 align=1
  %26 = ret.void
}
