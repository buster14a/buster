function (ptr, i32, i64) -> i32 {
b0:
  %0 = param.ptr 0
  %1 = param.i32 1
  %2 = param.i64 2
  %3 = load.v4i32 %0 align=16
  %4 = load.v8i32 %0 align=32
  %5 = load.v16i32 %0 align=64
  %6 = intrinsic.i32 %3 lane_extract 2
  %7 = intrinsic.i32 %3 lane_extract 60
  %8 = intrinsic.i32 %4 lane_extract 61
  %9 = intrinsic.i64 %5 lane_extract 31
  %10 = intrinsic.v4i32 %3, %1 lane_insert 14
  %11 = intrinsic.v16i32 %5, %2 lane_insert 27
  %12 = intrinsic.i32 %3 movemask 0
  %13 = intrinsic.i32 %4 movemask 2
  %14 = intrinsic.i32 %4 movemask 3
  %15 = ret.void %6
}
