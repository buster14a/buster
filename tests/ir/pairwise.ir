function (ptr) -> void {
b0:
  %0 = param.ptr 0
  %1 = load.v4i32 %0 align=16
  %2 = load.v8i32 %0 align=32
  %3 = load.v16i32 %0 align=64
  %4 = intrinsic.v4i32 %1, %1 pairwise 0
  %5 = intrinsic.v8i32 %2, %2 pairwise 1
  %6 = intrinsic.v16i32 %3, %3 pairwise 5
  %7 = intrinsic.v4i32 %4, %1 pairwise 2
  %8 = intrinsic.v16i32 %3, %6, %3 dot 0
  %9 = intrinsic.v8i32 %5, %2, %2 dot 3
  %10 = ret.void
}
