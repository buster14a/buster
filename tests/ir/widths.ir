function (ptr) -> void {
b0:
  %0 = param.ptr 0
  %1 = load.v4i32 %0 align=16
  %2 = load.v8i32 %0 align=32
  %3 = load.v16i32 %0 align=64
  %4 = intrinsic.v4i32 %2 extract 0
  %5 = intrinsic.v4i32 %2 extract 1
  %6 = intrinsic.v4i32 %3 extract 0
  %7 = intrinsic.v4i32 %3 extract 3
  %8 = intrinsic.v8i32 %3 extract 1
