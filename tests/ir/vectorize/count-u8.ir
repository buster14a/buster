function (ptr, i64, i8) -> i64 {
b0:
  %0 = param.ptr 0
  %1 = param.i64 1
  %2 = param.i8 2
  %3 = const.i64 0x00000000000000000000000000000000
  %4 = br.void b1
b1:
  %5 = phi.i64 [%3, b0], [%16, b2]
  %6 = phi.i64 [%3, b0], [%18, b2]
  %7 = icmp.i1 %6, %1 ult
  %8 = cbr.void %7, b2, b3
b2:
  %9 = address.ptr %0 + %6 * 1 offset=0
  %10 = load.i8 %9 align=1
  %11 = zext.i32 %10
  %12 = zext.i32 %2
  %13 = icmp.i1 %11, %12 eq
  %14 = zext.i32 %13
  %15 = sext.i64 %14
  %16 = add.i64 %5, %15
  %17 = const.i64 0x00000000000000000000000000000001
  %18 = add.i64 %6, %17
  %19 = br.void b1
b3:
  %20 = ret.void %5
}
