function (ptr, i64) -> i64 {
b0:
  %0 = param.ptr 0
  %1 = param.i64 1
  %2 = const.i64 0x00000000000000000000000000000000
  %3 = br.void b1
b1:
  %4 = phi.i64 [%2, b0], [%11, b2]
  %5 = phi.i64 [%2, b0], [%13, b2]
  %6 = icmp.i1 %5, %1 ult
  %7 = cbr.void %6, b2, b3
b2:
  %8 = address.ptr %0 + %5 * 4 offset=0
  %9 = load.i32 %8 align=1
  %10 = sext.i64 %9
  %11 = add.i64 %4, %10
  %12 = const.i64 0x00000000000000000000000000000001
  %13 = add.i64 %5, %12
  %14 = br.void b1
b3:
  %15 = ret.void %4
}
