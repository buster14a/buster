function (ptr, ptr, ptr, i64) -> void {
b0:
  %0 = param.ptr 0
  %1 = param.ptr 1
  %2 = param.ptr 2
  %3 = param.i64 3
  %4 = const.i64 0x00000000000000000000000000000000
  %5 = br.void b1
b1:
  %6 = phi.i64 [%4, b0], [%17, b2]
  %7 = icmp.i1 %6, %3 ult
  %8 = cbr.void %7, b2, b3
b2:
  %9 = address.ptr %1 + %6 * 2 offset=0
  %10 = load.i16 %9 align=1
  %11 = address.ptr %2 + %6 * 2 offset=0
  %12 = load.i16 %11 align=1
  %13 = sub.i16 %10, %12
  %14 = address.ptr %0 + %6 * 2 offset=0
  %15 = store.void %14, %13 align=1
  %16 = const.i64 0x00000000000000000000000000000001
  %17 = add.i64 %6, %16
