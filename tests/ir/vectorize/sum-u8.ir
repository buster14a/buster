function (ptr, i64, i32) -> i32 {
b0:
  %0 = param.ptr 0
  %1 = param.i64 1
  %2 = param.i32 2
  %3 = const.i64 0x00000000000000000000000000000000
  %4 = br.void b1
b1:
  %5 = phi.i32 [%2, b0], [%12, b2]
  %6 = phi.i64 [%3, b0], [%14, b2]
  %7 = icmp.i1 %6, %1 ult
  %8 = cbr.void %7, b2, b3
b2:
  %9 = address.ptr %0 + %6 * 1 offset=0
  %10 = load.i8 %9 align=1
  %11 = zext.i32 %10
  %12 = add.i32 %11, %5
  %13 = const.i64 0x00000000000000000000000000000001
  %14 = add.i64 %6, %13
  %15 = br.void b1
b3:
  %16 = ret.void %5
}
