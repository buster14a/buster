function (ptr, ptr, f64, i64) -> void {
b0:
  %0 = param.ptr 0
  %1 = param.ptr 1
  %2 = param.f64 2
  %3 = param.i64 3
  %4 = const.i64 0x00000000000000000000000000000000
  %5 = br.void b1
b1:
  %6 = phi.i64 [%4, b0], [%16, b2]
  %7 = icmp.i1 %6, %3 ult
  %8 = cbr.void %7, b2, b3
b2:
  %9 = address.ptr %0 + %6 * 8 offset=0
  %10 = load.f64 %9 align=1
  %11 = address.ptr %1 + %6 * 8 offset=0
  %12 = load.f64 %11 align=1
  %13 = fma.f64 %2, %12, %10
  %14 = store.void %9, %13 align=1
  %15 = const.i64 0x00000000000000000000000000000001
  %16 = add.i64 %6, %15
  %17 = br.void b1
b3:
  %18 = ret.void
}
