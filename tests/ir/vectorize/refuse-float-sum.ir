function (ptr, i64) -> f32 {
b0:
  %0 = param.ptr 0
  %1 = param.i64 1
  %2 = const.f32 0x00000000000000000000000000000000
  %3 = const.i64 0x00000000000000000000000000000000
  %4 = br.void b1
b1:
  %5 = phi.f32 [%2, b0], [%11, b2]
  %6 = phi.i64 [%3, b0], [%13, b2]
  %7 = icmp.i1 %6, %1 ult
  %8 = cbr.void %7, b2, b3
b2:
  %9 = address.ptr %0 + %6 * 4 offset=0
  %10 = load.f32 %9 align=1
  %11 = fadd.f32 %5, %10
  %12 = const.i64 0x00000000000000000000000000000001
  %13 = add.i64 %6, %12
  %14 = br.void b1
b3:
  %15 = ret.void %5
}
