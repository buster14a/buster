  %1 = param.i64 1
  %2 = const.i64 0x00000000000000000000000000000000
  %3 = const.i32 0x00000000000000000000000000000001
  %4 = const.i32 0x000000000000000000000000ffffffff
  %5 = const.i32 0x00000000000000000000000000000000
  %6 = const.i32 0x00000000000000000000000000005a5a
  %7 = br.void b1
b1:
  %8 = phi.i32 [%3, b0], [%18, b2]
