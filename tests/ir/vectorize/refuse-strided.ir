function (ptr, ptr, i64) -> void {
b0:
  %0 = param.ptr 0
  %1 = param.ptr 1
  %2 = param.i64 2
  %3 = const.i64 0x00000000000000000000000000000000
  %4 = br.void b1
b1:
  %5 = phi.i64 [%3, b0], [%13, b2]
  %6 = icmp.i1 %5, %2 ult
  %7 = cbr.void %6, b2, b3
b2:
  %8 = address.ptr %1 + %5 * 4 offset=0
  %9 = load.i32 %8 align=1
  %10 = address.ptr %0 + %5 * 8 offset=0
  %11 = store.void %10, %9 align=1
  %12 = const.i64 0x00000000000000000000000000000001
  %13 = add.i64 %5, %12
  %14 = br.void b1
b3:
  %15 = ret.void
}
