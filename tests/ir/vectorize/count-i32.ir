function (ptr, i64, i32, i32) -> i32 {
b0:
  %0 = param.ptr 0
  %1 = param.i64 1
  %2 = param.i32 2
  %3 = param.i32 3
  %4 = const.i64 0x00000000000000000000000000000000
  %5 = br.void b1
b1:
  %6 = phi.i32 [%3, b0], [%14, b2]
  %7 = phi.i64 [%4, b0], [%16, b2]
  %8 = icmp.i1 %7, %1 ult
  %9 = cbr.void %8, b2, b3
b2:
  %10 = address.ptr %0 + %7 * 4 offset=0
  %11 = load.i32 %10 align=1
  %12 = icmp.i1 %2, %11 lt
  %13 = zext.i32 %12
  %14 = add.i32 %13, %6
  %15 = const.i64 0x00000000000000000000000000000001
  %16 = add.i64 %7, %15
  %17 = br.void b1
b3:
  %18 = ret.void %6
}
