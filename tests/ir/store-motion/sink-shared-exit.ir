function (i64, i64) -> i64 {
b0:
  %0 = param.i64 0
  %1 = param.i64 1
  %2 = const.i64 0x00000000000000000000000000000000
  %3 = icmp.i1 %1, %2 ne
  %4 = cbr.void %3, b1, b4
b1:
  %5 = br.void b2
b2:
  %6 = phi.i64 [%2, b1], [%14, b3]
  %7 = icmp.i1 %6, %0 ult
  %8 = cbr.void %7, b3, b4
b3:
  %9 = symbol_addr.ptr @1
  %10 = load.i64 %9 align=8
  %11 = add.i64 %10, %6
  %12 = symbol_addr.ptr @1
  %13 = store.void %12, %11 align=8
  %14 = add.i64 %6, %1
  %15 = br.void b2
b4:
  %16 = symbol_addr.ptr @1
  %17 = load.i64 %16 align=8
  %18 = ret.void %17
}
