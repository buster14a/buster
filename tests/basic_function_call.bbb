code compute : fn (a: s32, b: s32) s32
{
    return a + b;
}

code consume : fn (v: s32) void
{
}

code final_result : fn (v: s32) s32
{
    return v - v;
}

code main[export] : fn [cc(c)] (argument_count: u32, argv: &&u8, envp: &&u8) s32
{
    data value: s32 = calculate(1, 2 + 3);
    consume(value);
    return final_result(value);
}
