{
  "type": "object",
  "properties": {
    "format": {
      "const": "buster-benchmark"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "kind": {
      "enum": [
        "measured",
        "imported",
        "synthetic_example"
      ]
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "aborted",
        "planned"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/context"
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "scopes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scope"
      }
    },
    "instruments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/instrument"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/table"
      }
    },
    "traces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trace"
      }
    },
    "census": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "format",
    "version",
    "id",
    "kind",
    "status",
    "recorded_at",
    "producer",
    "resources",
    "limitations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thin Buster benchmark manifest v1 — Perfetto plus Arrow/JSONL",
  "description": "Benchmark semantics and immutable resource links only. Physical schemas are Apache Arrow; sampling, clocks, stacks and traces are Perfetto-native. Supersedes the unpublished BMF profile-table proposal.",
  "$defs": {
    "unit": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string"
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": -32,
            "maximum": 32
          }
        },
        "scale": {
          "type": "object",
          "properties": {
            "numerator": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "denominator": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          "required": [
            "numerator",
            "denominator"
          ],
          "additionalProperties": false
        },
        "offset": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      },
      "required": [
        "symbol",
        "dimensions",
        "scale"
      ],
      "additionalProperties": false
    },
    "sample_count_binding": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "column": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "column"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "constant": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
                }
              ]
            }
          },
          "required": [
            "constant"
          ],
          "additionalProperties": false
        }
      ]
    },
    "interval": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "observed_range",
            "quantile_range",
            "confidence_interval",
            "credible_interval"
          ]
        },
        "low_column": {
          "type": "string",
          "minLength": 1
        },
        "high_column": {
          "type": "string",
          "minLength": 1
        },
        "population": {
          "type": "string"
        },
        "probabilities": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "coverage": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "method": {
          "type": "string"
        },
        "resampling_unit": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "low_column",
        "high_column",
        "population"
      ],
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "properties": {
        "metric_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "scope_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "instrument_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "statistic": {
          "type": "string"
        },
        "sample_level": {
          "type": "string"
        },
        "sample_count": {
          "$ref": "#/$defs/sample_count_binding"
        },
        "raw_retained": {
          "type": "boolean"
        },
        "status_column": {
          "type": "string",
          "minLength": 1
        },
        "reason_column": {
          "type": "string",
          "minLength": 1
        },
        "intervals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interval"
          }
        },
        "derivation": {
          "type": "object"
        },
        "counter_quality_columns": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "metric_id",
        "scope_id",
        "instrument_id",
        "statistic",
        "sample_level",
        "raw_retained"
      ],
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "name": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "definition_version": {
          "type": "string"
        },
        "quantity": {
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "direction": {
          "enum": [
            "lower",
            "higher",
            "neutral",
            "target"
          ]
        },
        "target": {
          "type": "object"
        },
        "aggregation": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "definition",
        "definition_version",
        "quantity",
        "unit",
        "direction",
        "aggregation"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "kind": {
          "type": "string"
        },
        "facts": {
          "type": "object"
        },
        "unknowns": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "facts"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "subject": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "includes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "subject",
        "level",
        "description",
        "includes",
        "excludes"
      ],
      "additionalProperties": false
    },
    "instrument": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "kind": {
          "type": "string"
        },
        "facts": {
          "type": "object"
        },
        "unknowns": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "facts"
      ],
      "additionalProperties": false
    },
    "foreign_key": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "target_table": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "target_columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "columns",
        "target_table",
        "target_columns"
      ],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "format": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#\\s]+(?:[/?#][^\\s]*)?(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "rows": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "media_type": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "repository",
            "commit",
            "path"
          ],
          "additionalProperties": false
        },
        "role": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "format",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "path"
          ],
          "not": {
            "required": [
              "url"
            ]
          }
        },
        {
          "required": [
            "url"
          ],
          "not": {
            "required": [
              "path"
            ]
          }
        }
      ]
    },
    "table": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "data": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
          },
          "minItems": 1
        },
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
            },
            "minItems": 1
          }
        },
        "primary_key": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "foreign_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/foreign_key"
          }
        },
        "order_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "measurements": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/measurement"
          }
        },
        "bindings": {
          "type": "object"
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "data"
      ],
      "additionalProperties": false
    },
    "trace": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "resource": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "execution_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "profiler": {
          "type": "object"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "resource",
        "execution_id",
        "limitations"
      ],
      "additionalProperties": false
    }
  }
}
