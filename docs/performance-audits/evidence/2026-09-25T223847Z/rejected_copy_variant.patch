+// A function's construction rows are sized before its body is lowered, from
+// its body tokens: three instruction, source and value slots per token and one
+// block slot per token. Most of that capacity is never written (the self-host
+// unit fills about a quarter of its instruction and value slots and a tenth of
+// its block slots), so the construction arrays live in the per-function
+// lowering scratch and only the written prefix is published into the result
+// arena once the function is finished. Consecutive functions' published rows
+// are then contiguous: no unwritten capacity tail sits between them, so no
+// page -- 4 KiB or transparent huge page -- is faulted and cleared for slots
+// nothing wrote, and every canonical pass that sweeps the rows walks dense
+// memory. The instruction rows start on a cache line, so a 64-byte row never
+// spans two lines. Capacities become the counts; the few later appends take
+// ir.c's ordinary doubling growth, exactly as any full array does.
+#define C_IR_PUBLISHED_ROW_ALIGNMENT 64
+BUSTER_CT_CHECK(sizeof(void*) != 8 || sizeof(IrInstruction) == C_IR_PUBLISHED_ROW_ALIGNMENT);
+
+BUSTER_GLOBAL_LOCAL void c_ir_publish_function_rows(Arena* arena, IrFunction* function)
+{
+    IrBlock* blocks = arena_allocate(arena, IrBlock, function->block_count);
+    IrInstruction* instructions = (IrInstruction*)arena_allocate_bytes(
+        arena, arena_array_size(sizeof(IrInstruction), function->instruction_count), C_IR_PUBLISHED_ROW_ALIGNMENT);
+    IrSourceRange* sources = function->instruction_canonical_sources ? arena_allocate(arena, IrSourceRange, function->instruction_count) : 0;
+    IrValue* values = arena_allocate(arena, IrValue, function->value_count);
+    if (function->block_count)
+    {
+        memcpy(blocks, function->blocks, sizeof(*blocks) * function->block_count);
+    }
+    if (function->instruction_count)
+    {
+        memcpy(instructions, function->instructions, sizeof(*instructions) * function->instruction_count);
+    }
+    if (sources && function->instruction_count)
+    {
+        memcpy(sources, function->instruction_canonical_sources, sizeof(*sources) * function->instruction_count);
+    }
+    if (function->value_count)
+    {
+        memcpy(values, function->values, sizeof(*values) * function->value_count);
+    }
+    function->blocks = blocks;
+    function->block_capacity = function->block_count;
+    function->instructions = instructions;
+    function->instruction_canonical_sources = sources;
+    function->instruction_capacity = function->instruction_count;
+    function->values = values;
+    function->value_capacity = function->value_count;
+}
