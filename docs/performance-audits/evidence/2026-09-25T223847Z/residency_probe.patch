+// DISPOSABLE PROBE (never merge): redundancy counters for derived-fact queries.
+#include <stdio.h>
+typedef struct ProbeKeyTable ProbeKeyTable;
+struct ProbeKeyTable { u64* keys; u32* counts; u64 capacity; u64 unique; u64 calls; u64 repeat_calls; u64 tokens; u64 repeat_tokens; };
+static ProbeKeyTable probe_tables[12];
+static char const* probe_table_names[12] = {"type_query_all", "type_query_top_nonmemo", "type_query_nested", "infer_array_count_core",
+                                           "initializer_expression_constraint", "type_query_memo_eligible", "type_query_memo_hit", "validate_initializer_shape", "type_query_relaxed_no_checked_bit", "infer_array_count_no_diagnostic_bit", "infer_array_count_range_only", "infer_array_count_range_element"};
+static void probe_key(u32 table_index, u64 a, u64 b, u64 c, u64 tokens)
+{
+    ProbeKeyTable* t = &probe_tables[table_index];
+    if (!t->keys) { t->capacity = (u64)1 << 23; t->keys = calloc(t->capacity, 8); t->counts = calloc(t->capacity, 4); }
+    u64 key = (a * 0x9E3779B97F4A7C15ull) ^ (b * 0xC2B2AE3D27D4EB4Full) ^ (c * 0x165667B19E3779F9ull) ^ 1;
+    u64 slot = (key >> 17) & (t->capacity - 1);
+    while (t->keys[slot] && t->keys[slot] != key) { slot = (slot + 1) & (t->capacity - 1); }
+    t->calls += 1; t->tokens += tokens;
+    if (!t->keys[slot]) { t->keys[slot] = key; t->unique += 1; }
+    else { t->repeat_calls += 1; t->repeat_tokens += tokens; }
+    t->counts[slot] += 1;
+}
+// Direction census on the key with the CHECKED bit removed. Bit 0: a checked
+// answer was computed before; bit 1: an unchecked one was. Split by where the
+// root query ran: 0 = no per-body memo (file scope), 1 = inside a memo window.
+typedef struct ProbeDirection ProbeDirection;
+struct ProbeDirection { u64* keys; u8* seen; u64 capacity; u64 calls[2]; u64 first[2]; u64 same_mode_repeat[2]; u64 checked_then_unchecked[2]; u64 unchecked_then_checked[2]; };
+static ProbeDirection probe_direction_table;
+static void probe_direction(u32 window, u64 a, u64 b, bool checked)
+{
+    ProbeDirection* t = &probe_direction_table;
+    if (!t->keys) { t->capacity = (u64)1 << 23; t->keys = calloc(t->capacity, 8); t->seen = calloc(t->capacity, 1); }
+    u64 key = (a * 0x9E3779B97F4A7C15ull) ^ (b * 0xC2B2AE3D27D4EB4Full) ^ ((u64)window * 0x165667B19E3779F9ull) ^ 1;
+    u64 slot = (key >> 17) & (t->capacity - 1);
+    while (t->keys[slot] && t->keys[slot] != key) { slot = (slot + 1) & (t->capacity - 1); }
+    u8 bit = checked ? 1 : 2;
+    t->calls[window] += 1;
+    if (!t->keys[slot]) { t->keys[slot] = key; t->first[window] += 1; }
+    else if (t->seen[slot] & bit) { t->same_mode_repeat[window] += 1; }
+    else if (checked) { t->unchecked_then_checked[window] += 1; }
+    else { t->checked_then_unchecked[window] += 1; }
+    t->seen[slot] |= bit;
+}
+void buster_probe_frontend_dump(FILE* file);
+void buster_probe_frontend_dump(FILE* file)
+{
+    for (u32 w = 0; w < 2; w += 1)
+    {
+        ProbeDirection* t = &probe_direction_table;
+        fprintf(file, "FRONTEND\tdirection_%s\tcalls=%lu\tfirst=%lu\tsame_mode_repeat=%lu\tchecked_then_unchecked=%lu\tunchecked_then_checked=%lu\n",
+                w ? "memo_window" : "no_memo", (unsigned long)t->calls[w], (unsigned long)t->first[w], (unsigned long)t->same_mode_repeat[w],
+                (unsigned long)t->checked_then_unchecked[w], (unsigned long)t->unchecked_then_checked[w]);
+    }
+    for (u32 i = 0; i < 12; i += 1)
+    {
+        ProbeKeyTable* t = &probe_tables[i];
+        u32 max = 0;
+        for (u64 k = 0; t->counts && k < t->capacity; k += 1) { if (t->counts[k] > max) max = t->counts[k]; }
+        fprintf(file, "FRONTEND\t%s\tcalls=%lu\tunique=%lu\trepeat_calls=%lu\ttokens=%lu\trepeat_tokens=%lu\tmax_same_key=%u\n", probe_table_names[i],
+                (unsigned long)t->calls, (unsigned long)t->unique, (unsigned long)t->repeat_calls, (unsigned long)t->tokens, (unsigned long)t->repeat_tokens, max);
+    }
+}
