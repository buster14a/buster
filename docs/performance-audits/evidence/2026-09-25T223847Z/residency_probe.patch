+// DISPOSABLE PROBE (never merge): log large allocation ranges for residency attribution.
+#include <stdio.h>
+#include <stdlib.h>
+#include <fcntl.h>
+#include <unistd.h>
+typedef struct ProbeRange ProbeRange;
+struct ProbeRange { u64 address; u64 size; u32 line; char site[120]; };
+static ProbeRange* probe_ranges;
+static u64 probe_range_count;
+static u64 probe_range_capacity;
+static FILE* probe_file;
+static int probe_state;
+static void probe_initialize(void)
+{
+    if (!probe_state)
+    {
+        char const* path = getenv("BUSTER_PROBE_ALLOC");
+        probe_state = path ? 1 : 2;
+        if (path) { probe_file = fopen(path, "w"); }
+    }
+}
+typedef struct ProbeSmall ProbeSmall;
+struct ProbeSmall { u8 const* file; u8 const* function; u32 file_length; u32 function_length; u32 line; u64 calls; u64 bytes; u64 last_calls; u64 last_bytes; };
+static ProbeSmall probe_small[16384];
+Arena* buster_probe_tu_arena;
+static void probe_small_record(Arena* arena, u64 size, String8 file, String8 function, u32 line)
+{
+    if (arena != buster_probe_tu_arena || size >= 65536) { return; }
+    u64 hash = ((u64)file.pointer * 0x9E3779B97F4A7C15ull) ^ ((u64)line * 0xC2B2AE3D27D4EB4Full);
+    u64 slot = (hash >> 20) & 16383;
+    while (probe_small[slot].file && !(probe_small[slot].file == (u8 const*)file.pointer && probe_small[slot].line == line)) { slot = (slot + 1) & 16383; }
+    ProbeSmall* e = &probe_small[slot];
+    if (!e->file) { e->file = (u8 const*)file.pointer; e->file_length = (u32)file.length; e->function = (u8 const*)function.pointer; e->function_length = (u32)function.length; e->line = line; }
+    e->calls += 1; e->bytes += size;
+}
+static void probe_small_dump(char const* label)
+{
+    for (u64 i = 0; i < 16384; i += 1)
+    {
+        ProbeSmall* e = &probe_small[i];
+        if (e->file && e->bytes != e->last_bytes)
+        {
+            u64 slash = 0;
+            for (u64 k = 0; k < e->file_length; k += 1) { if (e->file[k] == '/') slash = k + 1; }
+            fprintf(probe_file, "S\t%s\t%.*s:%u:%.*s\t%lu\t%lu\n", label, (int)(e->file_length - slash), (char const*)e->file + slash, e->line,
+                    (int)e->function_length, (char const*)e->function, (unsigned long)(e->calls - e->last_calls), (unsigned long)(e->bytes - e->last_bytes));
+            e->last_calls = e->calls; e->last_bytes = e->bytes;
+        }
+    }
+    if (buster_probe_tu_arena) { fprintf(probe_file, "P\t%s\t%lu\n", label, (unsigned long)buster_probe_tu_arena->position); }
+}
+static void probe_record(void* address, u64 size, String8 file, String8 function, u32 line)
+{
+    probe_initialize();
+    if (probe_state == 1 && size >= 65536)
+    {
+        if (probe_range_count == probe_range_capacity)
+        {
+            probe_range_capacity = probe_range_capacity ? probe_range_capacity * 2 : 4096;
+            probe_ranges = realloc(probe_ranges, probe_range_capacity * sizeof(ProbeRange));
+        }
+        ProbeRange* r = &probe_ranges[probe_range_count++];
+        r->address = (u64)address; r->size = size; r->line = line;
+        u64 slash = 0;
+        for (u64 i = 0; i < file.length; i += 1) { if (file.pointer[i] == '/') slash = i + 1; }
+        snprintf(r->site, sizeof(r->site), "%.*s:%u:%.*s", (int)(file.length - slash), (char const*)file.pointer + slash, line,
+                 (int)function.length, (char const*)function.pointer);
+    }
+}
+void buster_probe_residency_snapshot(char const* label);
+void buster_probe_residency_snapshot(char const* label)
+{
+    probe_initialize();
+    if (probe_state != 1) { return; }
+    int fd = open("/proc/self/pagemap", O_RDONLY);
+    fprintf(probe_file, "SNAPSHOT\t%s\n", label);
+    probe_small_dump(label);
+    static u64 buffer[65536];
+    for (u64 i = 0; i < probe_range_count; i += 1)
+    {
+        ProbeRange* r = &probe_ranges[i];
+        u64 first = r->address / 4096, last = (r->address + r->size + 4095) / 4096;
+        u64 present = 0;
+        for (u64 page = first; page < last;)
+        {
+            u64 chunk = last - page; if (chunk > 65536) chunk = 65536;
+            ssize_t got = pread(fd, buffer, chunk * 8, (off_t)(page * 8));
+            if (got <= 0) break;
+            u64 n = (u64)got / 8;
+            for (u64 k = 0; k < n; k += 1) { present += (buffer[k] >> 63) & 1; }
+            page += n;
+        }
+        fprintf(probe_file, "R\t%s\t%lu\t0x%lx\t%lu\t%lu\n", label, (unsigned long)i, (unsigned long)r->address, (unsigned long)r->size,
+                (unsigned long)(present * 4096));
+    }
+    fprintf(probe_file, "RANGES\t%s\t%lu\n", label, (unsigned long)probe_range_count);
+    for (u64 i = 0; i < probe_range_count; i += 1)
+    {
+        fprintf(probe_file, "D\t%lu\t%s\n", (unsigned long)i, probe_ranges[i].site);
+    }
+    fflush(probe_file);
+    close(fd);
+}
+
