@@ -582,6 +686,8 @@ void* arena_benchmark_allocate(Arena* arena, u64 size, u64 alignment, bool zeroe
     u64 clear_end = BUSTER_MIN(dirty, arena->position);
     u64 written = clear_end > begin ? clear_end - begin : 0;
     arena_benchmark_event(ARENA_BENCHMARK_ARENA, file, function, line, size, begin - start, zeroed ? size : 0, written, true);
+    probe_record(result, size, file, function, line);
+    if (probe_state == 1) { probe_small_record(arena, size, file, function, line); }
     return result;
 }
 
