@@ -93,6 +93,282 @@
 #include "c_internal.h"
 #include <buster/lib/compiler/ir/ir_construction.h>
 
+// DISPOSABLE #531 PROVENANCE PROBE -- measurement checkout only, never merged
+// into a production path. Records, per function body, what the body publishes
+// into the shared program/module tables (by site), which body-published
+// entities it consumes (through interner/import lookups and through the ids
+// stored in its own rows), and how many shared lazy memos it fills, to
+// $BUSTER_LOWER_PROVENANCE_PATH. Deterministic counts only; no timing.
+#include <stdio.h>
+#include <stdlib.h>
+typedef enum CLowerProvCounter
+{
+    C_PROV_SITE_POINTER_TYPE,
+    C_PROV_SITE_ARRAY_TYPE,
+    C_PROV_SITE_QUALIFIED_TYPE,
+    C_PROV_SITE_ATOMIC_ACCESS_TYPE,
+    C_PROV_SITE_ALIGNED_TYPE,
+    C_PROV_SITE_SCALAR_TYPE,
+    C_PROV_SITE_STRING_LITERAL,
+    C_PROV_SITE_RUNTIME_IMPORT,
+    C_PROV_SITE_STATIC_LOCAL,
+    C_PROV_SITE_COMPOUND_LITERAL,
+    C_PROV_SITE_CLEANUP_SYMBOL,
+    C_PROV_SITE_CLEANUP_FUNCTION,
+    C_PROV_HIT_POINTER_CROSS,
+    C_PROV_HIT_ARRAY_CROSS,
+    C_PROV_HIT_QUALIFIED_CROSS,
+    C_PROV_HIT_RUNTIME_CROSS,
+    C_PROV_HIT_ENTITY_SYMBOL_CROSS,
+    C_PROV_HIT_CLEANUP_CROSS,
+    C_PROV_HIT_TYPE_PREFIX,
+    C_PROV_HIT_TYPE_SELF,
+    C_PROV_HIT_SYMBOL_PREFIX,
+    C_PROV_HIT_SYMBOL_SELF,
+    C_PROV_FILL_POINTER_CACHE,
+    C_PROV_FILL_ARRAY_CACHE,
+    C_PROV_COUNTER_COUNT,
+} CLowerProvCounter;
+typedef struct CLowerProv CLowerProv;
+struct CLowerProv
+{
+    FILE* file;
+    bool active;
+    u32 body;
+    u32 preamble_types;
+    u32 preamble_symbols;
+    u32 preamble_globals;
+    u32 body_types_start;
+    u32 body_symbols_start;
+    u32 body_globals_start;
+    u32* type_producer;
+    u32* symbol_producer;
+    u32* global_producer;
+    u32 type_producer_capacity;
+    u32 symbol_producer_capacity;
+    u32 global_producer_capacity;
+    u32 min_producer;
+    u32 max_producer;
+    u64 counters[C_PROV_COUNTER_COUNT];
+};
+static CLowerProv c_lower_prov;
+BUSTER_C_INTERNAL FILE* c_lower_prov_file(void)
+{
+    static bool opened;
+    if (!opened)
+    {
+        opened = true;
+        char const* path = getenv("BUSTER_LOWER_PROVENANCE_PATH");
+        c_lower_prov.file = path ? fopen(path, "a") : 0;
+    }
+    return c_lower_prov.file;
+}
+BUSTER_C_INTERNAL void c_lower_prov_count(CLowerProvCounter counter)
+{
+    if (c_lower_prov.active)
+    {
+        c_lower_prov.counters[counter] += 1;
+    }
+}
+// 0 = preamble/prefix or invalid, 1 = published by an earlier body (cross), 2 = published by this body (self).
+BUSTER_C_INTERNAL u32 c_lower_prov_class(u32 id, u32 preamble, u32 body_start, u32 const* producers)
+{
+    u32 result = 0;
+    if (id != IR_ID_UNDERLYING_INVALID && id >= preamble)
+    {
+        if (id >= body_start)
+        {
+            result = 2;
+        }
+        else
+        {
+            u32 producer = producers[id - preamble];
+            c_lower_prov.min_producer = BUSTER_MIN(c_lower_prov.min_producer, producer);
+            c_lower_prov.max_producer = c_lower_prov.max_producer == UINT32_MAX ? producer : BUSTER_MAX(c_lower_prov.max_producer, producer);
+            result = 1;
+        }
+    }
+    return result;
+}
+BUSTER_C_INTERNAL void c_lower_prov_hit_type(IrTypeId id, CLowerProvCounter cross_counter)
+{
+    if (c_lower_prov.active)
+    {
+        u32 kind = c_lower_prov_class(id.value, c_lower_prov.preamble_types, c_lower_prov.body_types_start, c_lower_prov.type_producer);
+        c_lower_prov.counters[kind == 1 ? cross_counter : kind == 2 ? C_PROV_HIT_TYPE_SELF : C_PROV_HIT_TYPE_PREFIX] += 1;
+    }
+}
+BUSTER_C_INTERNAL void c_lower_prov_hit_symbol(IrSymbolId id, CLowerProvCounter cross_counter)
+{
+    if (c_lower_prov.active)
+    {
+        u32 kind = c_lower_prov_class(id.value, c_lower_prov.preamble_symbols, c_lower_prov.body_symbols_start, c_lower_prov.symbol_producer);
+        c_lower_prov.counters[kind == 1 ? cross_counter : kind == 2 ? C_PROV_HIT_SYMBOL_SELF : C_PROV_HIT_SYMBOL_PREFIX] += 1;
+    }
+}
+BUSTER_C_INTERNAL void c_lower_prov_stamp_range(u32** producers, u32* capacity, u32 preamble, u32 start, u32 end, u32 body)
+{
+    if (end > preamble && end - preamble > *capacity)
+    {
+        u32 grown = BUSTER_MAX((end - preamble) * 2, (u32)1024);
+        *producers = (u32*)realloc(*producers, sizeof(**producers) * grown);
+        *capacity = grown;
+    }
+    for (u32 id = BUSTER_MAX(start, preamble); id < end; id += 1)
+    {
+        (*producers)[id - preamble] = body;
+    }
+}
+BUSTER_C_INTERNAL u64 c_lower_prov_abi_classified(IrProgram* program)
+{
+    u64 sum = 0;
+    for (u32 convention = 0; convention < IR_ABI_CONVENTION_COUNT; convention += 1)
+    {
+        sum += program->abi_contexts[convention].classified_values;
+    }
+    return sum;
+}
+typedef struct CLowerProvScan CLowerProvScan;
+struct CLowerProvScan
+{
+    u64 kinds[3];
+};
+BUSTER_C_INTERNAL void c_lower_prov_scan_type(CLowerProvScan* scan, IrTypeId id)
+{
+    if (id.value != IR_ID_UNDERLYING_INVALID)
+    {
+        scan->kinds[c_lower_prov_class(id.value, c_lower_prov.preamble_types, c_lower_prov.body_types_start, c_lower_prov.type_producer)] += 1;
+    }
+}
+BUSTER_C_INTERNAL void c_lower_prov_scan_symbol(CLowerProvScan* scan, IrSymbolId id)
+{
+    if (id.value != IR_ID_UNDERLYING_INVALID)
+    {
+        scan->kinds[c_lower_prov_class(id.value, c_lower_prov.preamble_symbols, c_lower_prov.body_symbols_start, c_lower_prov.symbol_producer)] += 1;
+    }
+}
+// One F row per definition: publication deltas and sites, lookup hits by
+// origin, memo fills, the origin classes of every type/symbol id stored in
+// the body's own rows, and the origin classes referenced by the entities the
+// body itself published. Then stamps this body as the producer of them.
+BUSTER_C_INTERNAL void c_lower_prov_emit(IrProgram* program, IrModule* module, IrFunction* function, u32 declaration_index, CDeclaration declaration,
+                                         char const* status, int direct_ssa, u32 functions_start, u64 abi_start)
+{
+    FILE* file = c_lower_prov.file;
+    if (file && c_lower_prov.active)
+    {
+        CLowerProvScan row_types = {0};
+        CLowerProvScan row_symbols = {0};
+        CLowerProvScan tail_types = {0};
+        CLowerProvScan tail_symbols = {0};
+        CLowerProvScan tail_globals = {0};
+        if (function && function->instructions)
+        {
+            for (u32 index = 0; index < function->instruction_count; index += 1)
+            {
+                c_lower_prov_scan_type(&row_types, function->instructions[index].canonical_type);
+                c_lower_prov_scan_symbol(&row_symbols, function->instructions[index].symbol);
+            }
+        }
+        if (function && function->values)
+        {
+            for (u32 index = 0; index < function->value_count; index += 1)
+            {
+                c_lower_prov_scan_type(&row_types, function->values[index].canonical_type);
+            }
+        }
+        if (function && function->blocks)
+        {
+            for (u32 index = 0; index < function->block_count; index += 1)
+            {
+                for (IrBlockParameter* parameter = function->blocks[index].first_parameter; parameter; parameter = parameter->next)
+                {
+                    c_lower_prov_scan_type(&row_types, parameter->canonical_type);
+                }
+            }
+        }
+        if (function && function->debug_locals)
+        {
+            for (u32 index = 0; index < function->debug_local_count; index += 1)
+            {
+                c_lower_prov_scan_type(&row_types, function->debug_locals[index].type);
+            }
+        }
+        for (u32 index = c_lower_prov.body_types_start; index < program->types.count; index += 1)
+        {
+            IrType* type = program->types.types + index;
+            c_lower_prov_scan_type(&tail_types, type->element_type);
+            c_lower_prov_scan_type(&tail_types, type->return_type);
+            c_lower_prov_scan_type(&tail_types, type->unqualified_type);
+            for (u32 parameter = 0; type->parameter_types && parameter < type->parameter_count; parameter += 1)
+            {
+                c_lower_prov_scan_type(&tail_types, type->parameter_types[parameter]);
+            }
+            for (u32 field = 0; type->fields && field < type->field_count; field += 1)
+            {
+                c_lower_prov_scan_type(&tail_types, type->fields[field].type);
+            }
+        }
+        for (u32 index = c_lower_prov.body_symbols_start; index < program->symbols.count; index += 1)
+        {
+            c_lower_prov_scan_type(&tail_symbols, program->symbols.symbols[index].type);
+        }
+        for (u32 index = c_lower_prov.body_globals_start; index < module->global_count; index += 1)
+        {
+            IrGlobal* global = module->globals + index;
+            c_lower_prov_scan_symbol(&tail_globals, global->symbol);
+            c_lower_prov_scan_symbol(&tail_globals, global->initializer_symbol);
+            c_lower_prov_scan_type(&tail_globals, global->type);
+            for (u32 relocation = 0; global->relocations && relocation < global->relocation_count; relocation += 1)
+            {
+                c_lower_prov_scan_symbol(&tail_globals, global->relocations[relocation].symbol);
+            }
+        }
+        u64* c = c_lower_prov.counters;
+        fprintf(file, "F\t%u\t%.*s\t%s\t%d\t%u\t%u\t%u\t%u", declaration_index, (int)declaration.name.length, (char const*)declaration.name.pointer, status,
+                direct_ssa, declaration.body_token_count, function ? function->instruction_count : 0, function ? function->value_count : 0,
+                function ? function->block_count : 0);
+        fprintf(file, "\t%u\t%u\t%u\t%u", program->types.count - c_lower_prov.body_types_start, program->symbols.count - c_lower_prov.body_symbols_start,
+                module->global_count - c_lower_prov.body_globals_start, module->function_count - functions_start);
+        for (u32 counter = 0; counter < C_PROV_COUNTER_COUNT; counter += 1)
+        {
+            fprintf(file, "\t%llu", (unsigned long long)c[counter]);
+        }
+        fprintf(file, "\t%llu", (unsigned long long)(c_lower_prov_abi_classified(program) - abi_start));
+        fprintf(file, "\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu", (unsigned long long)row_types.kinds[1], (unsigned long long)row_types.kinds[2],
+                (unsigned long long)row_types.kinds[0], (unsigned long long)row_symbols.kinds[1], (unsigned long long)row_symbols.kinds[2],
+                (unsigned long long)row_symbols.kinds[0]);
+        fprintf(file, "\t%llu\t%llu\t%llu", (unsigned long long)tail_types.kinds[1], (unsigned long long)tail_symbols.kinds[1],
+                (unsigned long long)tail_globals.kinds[1]);
+        fprintf(file, "\t%d\t%d\t%u\n", c_lower_prov.min_producer == UINT32_MAX ? -1 : (int)c_lower_prov.min_producer,
+                c_lower_prov.max_producer == UINT32_MAX ? -1 : (int)c_lower_prov.max_producer, module->label_address_relocation_count);
+        c_lower_prov_stamp_range(&c_lower_prov.type_producer, &c_lower_prov.type_producer_capacity, c_lower_prov.preamble_types,
+                                 c_lower_prov.body_types_start, program->types.count, declaration_index);
+        c_lower_prov_stamp_range(&c_lower_prov.symbol_producer, &c_lower_prov.symbol_producer_capacity, c_lower_prov.preamble_symbols,
+                                 c_lower_prov.body_symbols_start, program->symbols.count, declaration_index);
+        c_lower_prov_stamp_range(&c_lower_prov.global_producer, &c_lower_prov.global_producer_capacity, c_lower_prov.preamble_globals,
+                                 c_lower_prov.body_globals_start, module->global_count, declaration_index);
+    }
+}
+BUSTER_C_INTERNAL void c_lower_prov_begin_body(IrProgram* program, IrModule* module, u32 declaration_index)
+{
+    c_lower_prov.body = declaration_index;
+    c_lower_prov.body_types_start = program->types.count;
+    c_lower_prov.body_symbols_start = program->symbols.count;
+    c_lower_prov.body_globals_start = module->global_count;
+    c_lower_prov.min_producer = UINT32_MAX;
+    c_lower_prov.max_producer = UINT32_MAX;
+    memset(c_lower_prov.counters, 0, sizeof(c_lower_prov.counters));
+}
+BUSTER_C_INTERNAL char const* c_lower_prov_header(void)
+{
+    return "H\tdecl\tname\tstatus\tdirect_ssa\tbody_tokens\tinstructions\tvalues\tblocks\td_types\td_symbols\td_globals\td_functions"
+           "\ts_ptr\ts_array\ts_qual\ts_atomic\ts_aligned\ts_scalar\ts_literal\ts_import\ts_static\ts_compound\ts_cleanup_sym\ts_cleanup_fn"
+           "\th_ptr_x\th_array_x\th_qual_x\th_import_x\th_entity_x\th_cleanup_x\th_type_prefix\th_type_self\th_symbol_prefix\th_symbol_self"
+           "\tfill_ptr\tfill_array\tabi_miss\tr_type_x\tr_type_self\tr_type_prefix\tr_sym_x\tr_sym_self\tr_sym_prefix\tt_type_x\tt_sym_x\tt_global_x"
+           "\tmin_producer\tmax_producer\tlabel_relocs\n";
+}
