diff --git a/tools/clang_analyze_shadow.c b/tools/clang_analyze_shadow.c
new file mode 100644
index 0000000..d15e292
--- /dev/null
+++ b/tools/clang_analyze_shadow.c
@@ -0,0 +1,909 @@
+// Shadow-only observations for repeated Clang analyzer runs. This file never
+// changes analyzer scheduling or accepts prior evidence as a verdict.
+// clang_analyze_shadow_main always invokes clang_analyze_main for a complete
+// fresh run, then writes a separate observation record and optional state.
+// Linux tree snapshots are iterative, bounded, and include directory entries
+// so additions/removals that affect negative include lookup change the digest.
+#if BUSTER_LINUX
+#include <errno.h>
+#endif
+
+#define BUSTER_ANALYZE_SHADOW_MAX_ENTRIES 20000
+#define BUSTER_ANALYZE_SHADOW_MAX_BYTES (128ull * 1024ull * 1024ull)
+#define BUSTER_ANALYZE_SHADOW_MAX_STATE_BYTES 256
+#define BUSTER_ANALYZE_SHADOW_STATE_VERSION "BUSTER_CLANG_ANALYZE_SHADOW_STATE_V1\n"
+#define BUSTER_ANALYZE_SHADOW_RECORD_VERSION "BUSTER_CLANG_ANALYZE_SHADOW_V1\n"
+
+typedef struct ClangAnalyzeShadowSnapshot ClangAnalyzeShadowSnapshot;
+struct ClangAnalyzeShadowSnapshot
+{
+    String8 digest;
+    String8 reason;
+    String8 environment_digest;
+    String8 tree_digest;
+    u64 entries;
+    u64 bytes;
+    bool complete;
+};
+
+typedef struct ClangAnalyzeShadowState ClangAnalyzeShadowState;
+struct ClangAnalyzeShadowState
+{
+    String8 digest;
+    String8 status;
+    u64 elapsed_us;
+    bool valid;
+    bool complete;
+};
+
+BUSTER_GLOBAL_LOCAL void clang_analyze_shadow_hash_string(Sha256* hash, String8 value)
+{
+    u8 separator = 0;
+    if (value.length) sha256_add(hash, (u8*)value.pointer, value.length);
+    sha256_add(hash, &separator, sizeof(separator));
+}
+
+BUSTER_GLOBAL_LOCAL bool clang_analyze_shadow_string_less(String8 left, String8 right)
+{
+    u64 count = BUSTER_MIN(left.length, right.length);
+    bool less = false;
+    bool decided = false;
+    for (u64 index = 0; !decided && index < count; index += 1)
+    {
+        u8 a = (u8)left.pointer[index];
+        u8 b = (u8)right.pointer[index];
+        if (a != b)
+        {
+            less = a < b;
+            decided = true;
+        }
+    }
+    if (!decided) less = left.length < right.length;
+    return less;
+}
+
+BUSTER_GLOBAL_LOCAL void clang_analyze_shadow_heap_down(String8* values, u64 root, u64 count)
+{
+    bool done = false;
+    while (!done && root < count / 2)
+    {
+        u64 child = root * 2 + 1;
+        if (child + 1 < count && clang_analyze_shadow_string_less(values[child], values[child + 1])) child += 1;
+        if (clang_analyze_shadow_string_less(values[root], values[child]))
+        {
+            String8 temporary = values[root];
+            values[root] = values[child];
+            values[child] = temporary;
+            root = child;
+        }
+        else done = true;
+    }
+}
+
+BUSTER_GLOBAL_LOCAL void clang_analyze_shadow_sort(String8* values, u64 count)
+{
+    for (u64 index = count / 2; index > 0; index -= 1) clang_analyze_shadow_heap_down(values, index - 1, count);
+    for (u64 end = count; end > 1; end -= 1)
+    {
+        String8 temporary = values[0];
+        values[0] = values[end - 1];
+        values[end - 1] = temporary;
+        clang_analyze_shadow_heap_down(values, 0, end - 1);
+    }
+}
+
+BUSTER_GLOBAL_LOCAL bool clang_analyze_shadow_environment_key(String8 key)
+{
+    String8 relevant[] = {S8("PATH"), S8("CPATH"), S8("C_INCLUDE_PATH"), S8("CPLUS_INCLUDE_PATH"), S8("OBJC_INCLUDE_PATH"),
+                          S8("OBJCPLUS_INCLUDE_PATH"), S8("COMPILER_PATH"), S8("GCC_EXEC_PREFIX"), S8("LIBRARY_PATH"), S8("SDKROOT"),
+                          S8("DEVELOPER_DIR"), S8("MACOSX_DEPLOYMENT_TARGET"), S8("SOURCE_DATE_EPOCH"), S8("CCC_OVERRIDE_OPTIONS"),
+                          S8("LANG"), S8("LC_ALL"), S8("LC_CTYPE"), S8("LC_MESSAGES"), S8("HOME"), S8("TMPDIR"), S8("TMP"),
+                          S8("TEMP"), S8("TZ"), S8("LD_LIBRARY_PATH"), S8("LD_PRELOAD"), S8("DYLD_LIBRARY_PATH"),
+                          S8("DYLD_INSERT_LIBRARIES"), S8("CLANG_CONFIG_FILE_SYSTEM_DIR"), S8("CLANG_CONFIG_FILE_USER_DIR"),
+                          S8("CLANG_MODULE_CACHE_PATH"), S8("CLANG_RESOURCE_DIR")};
+    bool result = false;
+    for (u64 index = 0; index < BUSTER_ARRAY_LENGTH(relevant); index += 1) result = result || string_equal(key, relevant[index]);
+    result = result || string_starts_with_sequence(key, S8("CLANG_")) || string_starts_with_sequence(key, S8("LLVM_")) ||
+             string_starts_with_sequence(key, S8("GCC_")) || string_starts_with_sequence(key, S8("LD_")) ||
+             string_starts_with_sequence(key, S8("DYLD_"));
+    return result;
+}
+
+BUSTER_GLOBAL_LOCAL void clang_analyze_shadow_root_add(Arena* arena, String8List* roots, String8 directory)
+{
+    if (directory.length)
+    {
+        String8 absolute = os_path_absolute_lexical(arena, directory, true);
+        bool found = false;
+        for (String8Node* node = roots->first; node; node = node->next)
+        {
+            found = found || string_equal(node->string, absolute);
+        }
+        if (!found) string8_list_push(arena, roots, absolute);
+    }
+}
+
+BUSTER_GLOBAL_LOCAL void clang_analyze_shadow_option_root(Arena* arena, String8List* roots, String8 directory, String8 value)
+{
+    String8 path = path_is_absolute(value) ? value : path_join(arena, directory, value);
+    clang_analyze_shadow_root_add(arena, roots, path);
+}
+
+BUSTER_GLOBAL_LOCAL bool clang_analyze_shadow_command_roots(Arena* arena, ClangAnalyzePlan plan, String8 results, String8 state,
+                                                             String8List* roots, bool* system_context_complete, String8List* reasons)
+{
+    bool valid = true;
+    *system_context_complete = true;
+    for (u64 unit_index = 0; valid && unit_index < plan.count; unit_index += 1)
+    {
+        ClangAnalyzeUnit unit = plan.units[unit_index];
+        String8 directory = os_path_absolute_lexical(arena, unit.entry.directory, true);
+        String8 source = path_is_absolute(unit.entry.file) ? unit.entry.file : path_join(arena, directory, unit.entry.file);
+        source = os_path_absolute_lexical(arena, source, true);
+        clang_analyze_shadow_root_add(arena, roots, directory);
+        clang_analyze_shadow_root_add(arena, roots, path_parent(arena, source));
+        bool nostdinc = false;
+        bool resource_directory_set = false;
+        for (u64 argument_index = 0; argument_index < unit.command.length; argument_index += 1)
+        {
+            String8 argument = unit.command.pointer[argument_index];
+            String8 next = argument_index + 1 < unit.command.length ? unit.command.pointer[argument_index + 1] : (String8){0};
+            String8 prefixes[] = {S8("-I"), S8("-isystem"), S8("-iquote"), S8("-idirafter"), S8("-F"), S8("-iframework"), S8("-include"),
+                                  S8("-imacros"), S8("-resource-dir"), S8("-isysroot"), S8("--sysroot"), S8("--sysroot="),
+                                  S8("-resource-dir="), S8("-fmodule-map-file="), S8("-ivfsoverlay"), S8("-fplugin="), S8("-fplugin")};
+            bool matched = false;
+            for (u64 prefix_index = 0; prefix_index < BUSTER_ARRAY_LENGTH(prefixes); prefix_index += 1)
+            {
+                String8 prefix = prefixes[prefix_index];
+                if (string_equal(argument, prefix) && next.length)
+                {
+                    resource_directory_set = resource_directory_set || string_equal(prefix, S8("-resource-dir"));
+                    String8 root = next;
+                    if (string_equal(prefix, S8("-include")) || string_equal(prefix, S8("-imacros")) ||
+                        string_equal(prefix, S8("-ivfsoverlay")) || string_equal(prefix, S8("-fplugin")))
+                    {
+                        String8 file = path_is_absolute(next) ? next : path_join(arena, directory, next);
+                        root = path_parent(arena, file);
+                    }
+                    clang_analyze_shadow_option_root(arena, roots, directory, root);
+                    argument_index += 1;
+                    matched = true;
+                    break;
+                }
+                if (argument.length > prefix.length && string_starts_with_sequence(argument, prefix) &&
+                    !string_equal(prefix, S8("-include")) && !string_equal(prefix, S8("-imacros")) && !string_equal(prefix, S8("-resource-dir")) &&
+                    !string_equal(prefix, S8("-isysroot")) && !string_equal(prefix, S8("--sysroot")) &&
+                    !string_equal(prefix, S8("-ivfsoverlay")) && !string_equal(prefix, S8("-fplugin")))
+                {
+                    resource_directory_set = resource_directory_set || string_equal(prefix, S8("-resource-dir="));
+                    String8 value = {.pointer = argument.pointer + prefix.length, .length = argument.length - prefix.length};
+                    String8 root = value;
+                    if (string_equal(prefix, S8("-fmodule-map-file=")) || string_equal(prefix, S8("-fplugin=")))
+                    {
+                        String8 file = path_is_absolute(value) ? value : path_join(arena, directory, value);
+                        root = path_parent(arena, file);
+                    }
+                    clang_analyze_shadow_option_root(arena, roots, directory, root);
+                    matched = true;
+                    break;
+                }
+            }
+            if (!matched)
+            {
+                nostdinc = nostdinc || string_equal(argument, S8("-nostdinc"));
+                bool dynamic_builtin = string_contains(argument, S8("__DATE__")) || string_contains(argument, S8("__TIME__")) ||
+                    string_contains(argument, S8("__TIMESTAMP__"));
+                if (dynamic_builtin)
+                {
+                    string8_list_push(arena, reasons, S8("dynamic-time-builtin-option"));
+                    *system_context_complete = false;
+                }
+            }
+            bool virtual_or_plugin = string_equal(argument, S8("-ivfsoverlay")) || string_equal(argument, S8("-fplugin")) ||
+                string_starts_with_sequence(argument, S8("-fplugin=")) || string_starts_with_sequence(argument, S8("-fmodule")) ||
+                string_starts_with_sequence(argument, S8("-fmodules")) || string_starts_with_sequence(argument, S8("-load")) ||
+                string_equal(argument, S8("-Xclang"));
+            if (virtual_or_plugin)
+            {
+                string8_list_push(arena, reasons, S8("unsupported-vfs-plugin-module-or-xclang-option"));
+                *system_context_complete = false;
+            }
+        }
+        if (!resource_directory_set)
+        {
+            string8_list_push(arena, reasons, S8("implicit-compiler-resource-directory-unbounded"));
+            *system_context_complete = false;
+        }
+        if (!nostdinc)
+        {
+            string8_list_push(arena, reasons, S8("implicit-system-include-search-unbounded"));
+            *system_context_complete = false;
+        }
+        // The sidecar does not scan the compiler's dynamic loader/runtime
+        // closure. A compiler checksum records integrity, not provenance.
+        string8_list_push(arena, reasons, S8("compiler-runtime-closure-unavailable"));
+        *system_context_complete = false;
+    }
+    // The result and state artifacts are observations, never inputs. Exclude
+    // only these exact paths when a caller places them under an input root.
+    (void)results;
+    (void)state;
+    return valid;
+}
+
+#if BUSTER_LINUX
+BUSTER_GLOBAL_LOCAL bool clang_analyze_shadow_skip_path(String8 path, String8 results, String8 state)
+{
+    bool result = (results.length && string_equal(path, results)) || (state.length && string_equal(path, state));
+    return result;
+}
+
+BUSTER_GLOBAL_LOCAL void clang_analyze_shadow_reason(Arena* arena, ClangAnalyzeShadowSnapshot* snapshot, String8 reason)
+{
+    if (!snapshot->reason.length) snapshot->reason = string_duplicate_arena(arena, reason, true);
+    snapshot->complete = false;
+}
+
+BUSTER_GLOBAL_LOCAL bool clang_analyze_shadow_path_components(Arena* arena, String8 path, Sha256* hash, ClangAnalyzeShadowSnapshot* snapshot)
+{
+    bool valid = true;
+    for (u64 end = 1; valid && end <= path.length; end += 1)
+    {
+        bool at_end = end == path.length;
+        bool at_separator = !at_end && path_is_separator(path.pointer[end]);
+        if (at_end || at_separator)
+        {
+            String8 prefix = string_slice(path, 0, end);
+            char8* zprefix = string_duplicate_arena(arena, prefix, true).pointer;
+            struct stat status = {0};
+            int stat_result = lstat(zprefix, &status);
+            int stat_error = errno;
+            if (stat_result == 0 && S_ISLNK(status.st_mode))
+            {
+                clang_analyze_shadow_hash_string(hash, S8("symlink-path-component"));
+                clang_analyze_shadow_hash_string(hash, prefix);
+                clang_analyze_shadow_reason(arena, snapshot, S8("symlink-in-input-path"));
+            }
+            else if (stat_result != 0 && stat_error != ENOENT && stat_error != ENOTDIR)
+            {
+                clang_analyze_shadow_reason(arena, snapshot, S8("input-path-component-stat-failed"));
+                valid = false;
+            }
+        }
+    }
+    return valid;
+}
+
+BUSTER_GLOBAL_LOCAL bool clang_analyze_shadow_snapshot_root(Arena* arena, String8 root, String8 results, String8 state,
+                                                             Sha256* hash, ClangAnalyzeShadowSnapshot* snapshot)
+{
+    String8* pending = arena_allocate(arena, String8, BUSTER_ANALYZE_SHADOW_MAX_ENTRIES);
+    String8* children = arena_allocate(arena, String8, BUSTER_ANALYZE_SHADOW_MAX_ENTRIES);
+    u64 pending_count = 1;
+    pending[0] = root;
+    bool valid = clang_analyze_shadow_path_components(arena, root, hash, snapshot);
+    while (valid && pending_count)
+    {
+        String8 directory = pending[--pending_count];
+        if (clang_analyze_shadow_skip_path(directory, results, state)) continue;
+        char8* zpath = string_duplicate_arena(arena, directory, true).pointer;
+        struct stat status = {0};
+        if (lstat(zpath, &status) != 0)
+        {
+            int stat_error = errno;
+            clang_analyze_shadow_hash_string(hash, S8("missing-path"));
+            clang_analyze_shadow_hash_string(hash, directory);
+            if (stat_error != ENOENT && stat_error != ENOTDIR)
+            {
+                clang_analyze_shadow_reason(arena, snapshot, S8("input-path-stat-failed"));
+                valid = false;
+            }
+        }
+        else if (S_ISLNK(status.st_mode))
+        {
+            clang_analyze_shadow_hash_string(hash, S8("symlink"));
+            clang_analyze_shadow_reason(arena, snapshot, S8("symlink-in-input-tree"));
+            char8 target[4096] = {0};
+            ssize_t target_length = readlink(zpath, target, sizeof(target));
+            if (target_length >= 0 && (u64)target_length < sizeof(target))
+            {
+                clang_analyze_shadow_hash_string(hash, (String8){.pointer = target, .length = (u64)target_length});
+            }
+            else
+            {
+                clang_analyze_shadow_reason(arena, snapshot, S8("symlink-target-unavailable"));
+                valid = false;
+            }
+        }
+        else if (S_ISDIR(status.st_mode))
+        {
+            clang_analyze_shadow_hash_string(hash, directory);
+            clang_analyze_shadow_hash_string(hash, S8("directory"));
+            if (snapshot->entries >= BUSTER_ANALYZE_SHADOW_MAX_ENTRIES || pending_count >= BUSTER_ANALYZE_SHADOW_MAX_ENTRIES)
+            {
+                clang_analyze_shadow_reason(arena, snapshot, S8("input-tree-entry-limit"));
+                valid = false;
+                break;
+            }
+            DIR* stream = opendir(zpath);
+            if (!stream)
+            {
+                clang_analyze_shadow_reason(arena, snapshot, S8("input-tree-directory-unreadable"));
+                valid = false;
+                break;
+            }
+            struct dirent* entry = 0;
+            u64 child_count = 0;
+            while (valid && (entry = readdir(stream)))
+            {
+                String8 name = string_duplicate_arena(arena, string_from_pointer(entry->d_name), true);
+                if (!string_equal(name, S8(".")) && !string_equal(name, S8("..")))
+                {
+                    String8 child = path_join(arena, directory, name);
+                    if (!clang_analyze_shadow_skip_path(child, results, state))
+                    {
+                        if (snapshot->entries + child_count >= BUSTER_ANALYZE_SHADOW_MAX_ENTRIES || child_count >= BUSTER_ANALYZE_SHADOW_MAX_ENTRIES)
+                        {
+                            clang_analyze_shadow_reason(arena, snapshot, S8("input-tree-entry-limit"));
+                            valid = false;
+                        }
+                        else
+                        {
+                            children[child_count++] = name;
+                        }
+                    }
+                }
+            }
+            bool close_success = closedir(stream) == 0;
+            valid = valid && close_success;
+            if (!close_success) clang_analyze_shadow_reason(arena, snapshot, S8("input-tree-directory-close-failed"));
+            clang_analyze_shadow_sort(children, child_count);
+            clang_analyze_shadow_hash_string(hash, string_format(arena, S8("directory-entry-count={u64}"), child_count));
+            for (u64 child_index = 0; valid && child_index < child_count; child_index += 1)
+            {
+                String8 name = children[child_index];
+                String8 child = path_join(arena, directory, name);
+                clang_analyze_shadow_hash_string(hash, S8("entry-name"));
+                clang_analyze_shadow_hash_string(hash, name);
+                pending[pending_count++] = child;
+                snapshot->entries += 1;
+            }
+        }
+        else if (S_ISREG(status.st_mode))
+        {
+            clang_analyze_shadow_hash_string(hash, S8("file"));
+            clang_analyze_shadow_hash_string(hash, directory);
+            if (status.st_size < 0 || (u64)status.st_size > BUSTER_ANALYZE_SHADOW_MAX_BYTES - snapshot->bytes)
+            {
+                clang_analyze_shadow_reason(arena, snapshot, S8("input-tree-byte-limit"));
+                valid = false;
+                break;
+            }
+            clang_analyze_shadow_hash_string(hash, string_format(arena, S8("size={u64};mode={u64}"), (u64)status.st_size, (u64)(status.st_mode & 0777)));
+            int descriptor = open(zpath, O_RDONLY | O_CLOEXEC);
+            if (descriptor < 0)
+            {
+                clang_analyze_shadow_reason(arena, snapshot, S8("input-file-unreadable"));
+                valid = false;
+                break;
+            }
+            u8 buffer[16384];
+            u8 overlap[32] = {0};
+            u64 overlap_count = 0;
+            Sha256 content_hash = {0};
+            sha256_init(&content_hash);
+            ssize_t read_count = 0;
+            u64 file_bytes = 0;
+            while (valid && (read_count = read(descriptor, buffer, sizeof(buffer))) > 0)
+            {
+                sha256_add(&content_hash, buffer, (u64)read_count);
+                file_bytes += (u64)read_count;
+                snapshot->bytes += (u64)read_count;
+                u8 combined[16384 + sizeof(overlap)] = {0};
+                memcpy(combined, overlap, overlap_count);
+                memcpy(combined + overlap_count, buffer, (u64)read_count);
+                u64 combined_count = overlap_count + (u64)read_count;
+                String8 file_span = {.pointer = (char8*)combined, .length = combined_count};
