+    bool oversized_written = file_write(oversized_path, BUSTER_SLICE_TO_BYTE_SLICE(oversized_text));
+    ClangAnalyzeShadowState oversized = clang_analyze_shadow_state_read(arena, oversized_path);
+    clang_analyze_shadow_test_check(oversized_written && !oversized.valid && string_equal(oversized.status, S8("unsafe-or-unreadable")),
+                                    S8("oversized-state-is-not-read"), &checks, &failures);
+    String8 link_path = path_join(arena, root, S8("first/link.h"));
+    bool link_created = false;
+#if BUSTER_LINUX
+    link_created = symlink(string_duplicate_arena(arena, early_header, true).pointer, string_duplicate_arena(arena, link_path, true).pointer) == 0;
+#endif
+    ClangAnalyzeShadowSnapshot linked = clang_analyze_shadow_test_snapshot(arena, root);
+    clang_analyze_shadow_test_check(link_created && !linked.complete && linked.reason.length,
+                                    S8("symlink-input-is-ineligible"), &checks, &failures);
+    ClangAnalyzeShadowState matching = {.digest = linked.digest, .elapsed_us = 987, .valid = true, .complete = false};
+    bool record_written = clang_analyze_shadow_write_observation(arena, results, linked, linked, matching, 41, 321, PROCESS_RESULT_SUCCESS);
+    String8 record = clang_analyze_read(arena, path_join(arena, results, S8("shadow-observation.txt")));
+    clang_analyze_shadow_test_check(record_written && string_contains(record, S8("partial_fingerprint_match=1")) &&
+                                    string_contains(record, S8("content_fingerprint_match=0")) &&
+                                    string_contains(record, S8("producer_authentication=unavailable")) &&
+                                    string_contains(record, S8("authoritative_eligible=0")) && string_contains(record, S8("qualified_reuse_us=0")),
+                                    S8("content-match-never-authorizes-reuse"), &checks, &failures);
+    bool removed = remove_path_recursive(arena, root);
+    string_print(S8("SHADOW_SELF_TEST checks={u64} failures={u64} cleanup={S8}\n"), checks, failures, removed ? S8("pass") : S8("fail"));
+    failures += !removed;
+    return failures ? PROCESS_RESULT_FAILED : PROCESS_RESULT_SUCCESS;
+}
+
+BUSTER_GLOBAL_LOCAL ProcessResult clang_analyze_shadow_main(Arena* arena, SliceString8 arguments)
+{
+    ClangAnalyzeOptions options = {.database = S8("build"), .shards = BUSTER_ANALYZE_DEFAULT_SHARDS,
+        .jobs = BUSTER_ANALYZE_DEFAULT_JOBS, .timeout = BUSTER_ANALYZE_TIMEOUT_SECONDS};
+    String8 state_path = {0};
+    String8* forwarded = arena_allocate(arena, String8, arguments.length);
+    u64 forwarded_count = 0;
+    bool valid = true;
+    bool database_set = false;
+    bool self_test = arguments.length == 1 && string_equal(arguments.pointer[0], S8("--self-test"));
+    for (u64 index = 0; valid && !self_test && index < arguments.length; index += 1)
+    {
+        String8 argument = arguments.pointer[index];
+        String8 inline_value = {0};
+        String8 option = argument;
+        bool has_value = build_argument_split_value(argument, &option, &inline_value);
+        if (string_equal(option, S8("--shadow-state")) && (has_value || index + 1 < arguments.length))
+        {
+            state_path = has_value ? inline_value : arguments.pointer[++index];
+        }
+        else
+        {
+            forwarded[forwarded_count++] = argument;
+            if (string_equal(argument, S8("--quiet")) && !has_value) options.quiet = true;
+            else if (!string_starts_with_sequence(argument, S8("--")) && !database_set)
+            {
+                options.database = argument;
+                database_set = true;
+            }
+            else if (has_value || index + 1 < arguments.length)
+            {
+                String8 value = has_value ? inline_value : arguments.pointer[index + 1];
+                if (!has_value) forwarded[forwarded_count++] = arguments.pointer[++index];
+                if (string_equal(option, S8("--config"))) options.config = value;
+                else if (string_equal(option, S8("--clang"))) options.clang = value;
+                else if (string_equal(option, S8("--results"))) options.results = value;
+                else if (string_equal(option, S8("--build-directory"))) options.database = value;
+                else if (string_equal(option, S8("--shards")) || string_equal(option, S8("--jobs")) || string_equal(option, S8("--timeout")))
+                {
+                    u64 number = 0;
+                    valid = text_parse_u64(value, &number);
+                    if (string_equal(option, S8("--shards"))) options.shards = number;
+                    if (string_equal(option, S8("--jobs"))) options.jobs = number;
+                    if (string_equal(option, S8("--timeout"))) options.timeout = number;
+                }
+                else if (string_equal(option, S8("--prepare")) || string_equal(option, S8("--aggregate")) || string_equal(option, S8("--shard")) ||
+                         string_equal(option, S8("--qualify-workers")) || string_equal(option, S8("--expect-rejection")) ||
+                         string_equal(option, S8("--self-test")))
+                {
+                    valid = false;
+                }
+                else valid = false;
+            }
+            else if (string_equal(argument, S8("--prepare")) || string_equal(argument, S8("--aggregate")) || string_equal(argument, S8("--shard")) ||
+                     string_equal(argument, S8("--qualify-workers")) || string_equal(argument, S8("--expect-rejection")) ||
+                     string_equal(argument, S8("--self-test"))) valid = false;
+        }
+    }
+    valid = valid && options.results.length && options.shards && options.shards <= BUSTER_ANALYZE_MAX_SHARDS && options.jobs &&
+        options.jobs <= BUSTER_ANALYZE_MAX_SHARDS && options.timeout && options.timeout <= 86400;
+    ProcessResult result = PROCESS_RESULT_FAILED;
+    if (self_test)
+    {
+        result = clang_analyze_shadow_self_test(arena);
+    }
+    else if (valid)
+    {
+        options.database = os_path_absolute(arena, clang_analyze_compile_commands_path(arena, options.database), true);
+        options.results = os_path_absolute_lexical(arena, options.results, true);
+        if (state_path.length) state_path = os_path_absolute_lexical(arena, state_path, true);
+        u64 discovery_start = os_now_microseconds();
+        ClangAnalyzePlan plan_before = {0};
+        bool planned_before = clang_analyze_plan(arena, options, &plan_before) && plan_before.count;
+        ClangAnalyzeShadowSnapshot before = {0};
+        ClangAnalyzeShadowState previous = {0};
+        if (planned_before)
+        {
+            before = clang_analyze_shadow_snapshot(arena, plan_before, options, options.results, state_path);
+            if (state_path.length) previous = clang_analyze_shadow_state_read(arena, state_path);
+        }
+        u64 discovery_us = os_now_microseconds() - discovery_start;
+        u64 run_start = os_now_microseconds();
+        // Even a shadow planning or state miss cannot suppress the required
+        // analyzer execution. The normal parser remains the verdict authority.
+        ProcessResult fresh_result = clang_analyze_main(arena, (SliceString8){.pointer = forwarded, .length = forwarded_count});
+        u64 full_run_us = os_now_microseconds() - run_start;
+        ClangAnalyzePlan plan_after = {0};
+        ClangAnalyzeShadowSnapshot after = {0};
+        u64 post_start = os_now_microseconds();
+        bool planned_after = clang_analyze_plan(arena, options, &plan_after) && plan_after.count == plan_before.count;
+        if (planned_before && planned_after) after = clang_analyze_shadow_snapshot(arena, plan_after, options, options.results, state_path);
+        discovery_us += os_now_microseconds() - post_start;
+        bool planned = planned_before && planned_after;
+        bool written = planned && clang_analyze_shadow_write_observation(arena, options.results, before, after, previous, discovery_us, full_run_us, fresh_result);
+        bool stable = planned && string_equal(before.digest, after.digest);
+        if (written && state_path.length && stable && fresh_result == PROCESS_RESULT_SUCCESS)
+            written = clang_analyze_shadow_write_state(state_path, after.digest, full_run_us, before.complete && after.complete);
+        result = planned ? (written ? fresh_result : PROCESS_RESULT_FAILED) : PROCESS_RESULT_FAILED;
+    }
+    else
+    {
+        string_print(S8("error: clang_analyze_shadow requires a full fresh run with --results DIR [--shadow-state FILE]; prepare, shard-worker, aggregate and qualify-workers modes are unsupported\n"));
+    }
+    return result;
+}
