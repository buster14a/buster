+    case ci * 16 + 1: type = census_##c##_typeof(machine, result, &preprocess, scope, start, end, tag_only_declaration, declarator_start); break; \
+    case ci * 16 + 2: type = census_##c##_atomic_paren(machine, result, &preprocess, scope, start, end, tag_only_declaration, declarator_start); break; \
+    case ci * 16 + 3: type = census_##c##_alignas(machine, result, &preprocess, scope, start, end, tag_only_declaration, declarator_start); break; \
+    case ci * 16 + 4: type = census_##c##_attribute(machine, result, &preprocess, scope, start, end, tag_only_declaration, declarator_start); break; \
+    case ci * 16 + 5: type = census_##c##_bitint(machine, result, &preprocess, scope, start, end, tag_only_declaration, declarator_start); break; \
+    case ci * 16 + 6: type = census_##c##_tag_reference(machine, result, &preprocess, scope, start, end, tag_only_declaration, declarator_start); break; \
+    case ci * 16 + 7: type = census_##c##_extension(machine, result, &preprocess, scope, start, end, tag_only_declaration, declarator_start); break; \
+    case ci * 16 + 8: type = census_##c##_restrict(machine, result, &preprocess, scope, start, end, tag_only_declaration, declarator_start); break; \
+    case ci * 16 + 9: type = census_##c##_atomic_word(machine, result, &preprocess, scope, start, end, tag_only_declaration, declarator_start); break; \
+    case ci * 16 + 10: type = census_##c##_other_word(machine, result, &preprocess, scope, start, end, tag_only_declaration, declarator_start); break; \
+    case ci * 16 + 11: type = census_##c##_empty(machine, result, &preprocess, scope, start, end, tag_only_declaration, declarator_start); break;
+
