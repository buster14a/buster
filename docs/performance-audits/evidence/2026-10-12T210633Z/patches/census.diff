+__attribute__((destructor)) static void census_print(void)
+{
+    for (u32 c = 0; c < CENSUS_CALLERS; c += 1)
+        for (u32 h = 0; h < CENSUS_SHAPES; h += 1)
+            for (u32 r = 0; r < CENSUS_REASONS; r += 1)
+                if (census_counts[c][h][r]) fprintf(stderr, "CENSUS %s %s reason=%u runs=%llu\n", census_caller_names[c], census_shape_names[h], r, (unsigned long long)census_counts[c][h][r]);
+    for (u32 c = 0; c < CENSUS_CALLERS; c += 1) fprintf(stderr, "CENSUS_TAGREF_PLAIN %s %llu\n", census_caller_names[c], (unsigned long long)census_tagref_plain[c]);
+}
+// tag_reference_plain: a tag reference whose other words are all plain words (no attribute/typeof/etc.)
+static u32 census_classify(CPreprocessResult preprocess, u32 start, u32 end, bool* tag_reference_plain)
+{
+    bool f[CENSUS_SHAPES] = {0};
+    u32 i = start;
+    bool typed = false;
+    bool stop = false;
+    while (!stop && i < end)
+    {
+        CToken const* t = &preprocess.tokens[i];
+        if (t->kind == C_TOKEN_IDENTIFIER)
+        {
+            String8 w = c_token_spelling(preprocess.spelling_base, *t);
+            if (census_eq(w, "struct") || census_eq(w, "union") || census_eq(w, "enum"))
+            {
+                i += 1;
+                i = c_parse_skip_attributes(preprocess, i, end);
+                bool named = i < end && preprocess.tokens[i].kind == C_TOKEN_IDENTIFIER;
+                i += named;
+                u32 a = i;
+                i = c_parse_skip_attributes(preprocess, i, end);
+                f[4] |= a != i;
+                if (i < end && c_token_is_punctuator(&preprocess.tokens[i], C_PUNCTUATOR_LEFT_BRACE))
+                {
+                    f[0] = true;
+                    u32 depth = 0;
+                    for (; i < end; i += 1)
+                    {
+                        if (c_token_is_punctuator(&preprocess.tokens[i], C_PUNCTUATOR_LEFT_BRACE)) depth += 1;
+                        if (c_token_is_punctuator(&preprocess.tokens[i], C_PUNCTUATOR_RIGHT_BRACE)) { depth -= 1; if (!depth) { i += 1; break; } }
+                    }
+                }
+                else
+                {
+                    f[6] = true;
+                }
+                typed = true;
+            }
+            else if (census_eq(w, "__attribute__") || census_eq(w, "__attribute") || census_eq(w, "__declspec") ||
+                     census_eq(w, "_Alignas") || census_eq(w, "alignas") || census_eq(w, "typeof") || census_eq(w, "__typeof__") ||
+                     census_eq(w, "__typeof") || census_eq(w, "typeof_unqual") || census_eq(w, "__typeof_unqual__") || census_eq(w, "_BitInt") ||
+                     (census_eq(w, "_Atomic") && i + 1 < end && c_token_is_punctuator(&preprocess.tokens[i + 1], C_PUNCTUATOR_LEFT_PARENTHESIS)))
+            {
+                u32 shape = (census_eq(w, "_Alignas") || census_eq(w, "alignas")) ? 3 : census_eq(w, "_BitInt") ? 5 : census_eq(w, "_Atomic") ? 2 :
+                            (w.pointer[0] == 't' || census_eq(w, "__typeof__") || census_eq(w, "__typeof") || census_eq(w, "__typeof_unqual__")) ? 1 : 4;
+                f[shape] = true;
+                typed |= shape == 1 || shape == 2 || shape == 5;
+                i += 1;
+                if (i < end && c_token_is_punctuator(&preprocess.tokens[i], C_PUNCTUATOR_LEFT_PARENTHESIS))
+                {
+                    u32 depth = 0;
+                    for (; i < end; i += 1)
+                    {
+                        if (c_token_is_punctuator(&preprocess.tokens[i], C_PUNCTUATOR_LEFT_PARENTHESIS)) depth += 1;
+                        if (c_token_is_punctuator(&preprocess.tokens[i], C_PUNCTUATOR_RIGHT_PARENTHESIS)) { depth -= 1; if (!depth) { i += 1; break; } }
+                    }
+                }
+            }
+            else if (c_parse_type_word_for_dialect_token(preprocess, *t) || census_eq(w, "typedef") || census_eq(w, "extern") || census_eq(w, "static") ||
+                     census_eq(w, "register") || census_eq(w, "_Thread_local") || census_eq(w, "__thread") || census_eq(w, "inline") ||
+                     census_eq(w, "__inline") || census_eq(w, "__inline__") || census_eq(w, "_Noreturn") || census_eq(w, "__extension__") ||
+                     census_eq(w, "restrict") || census_eq(w, "__restrict") || census_eq(w, "__restrict__") || census_eq(w, "_Atomic") ||
+                     census_eq(w, "const") || census_eq(w, "volatile") || census_eq(w, "auto") || census_eq(w, "__const") || census_eq(w, "__volatile__"))
+            {
+                f[7] |= census_eq(w, "__extension__");
+                f[8] |= census_eq(w, "restrict") || census_eq(w, "__restrict") || census_eq(w, "__restrict__");
+                f[9] |= census_eq(w, "_Atomic");
+                typed |= c_parse_type_specifier_token(preprocess, i);
+                i += 1;
+            }
+            else if (!typed)
+            {
+                typed = true; // typedef name
+                i += 1;
+            }
+            else
+            {
+                stop = true;
+            }
+        }
+        else if (c_token_is_punctuator(t, C_PUNCTUATOR_LEFT_BRACKET) && i + 1 < end && c_token_is_punctuator(&preprocess.tokens[i + 1], C_PUNCTUATOR_LEFT_BRACKET))
+        {
+            f[4] = true;
+            u32 depth = 0;
+            for (; i < end; i += 1)
+            {
+                if (c_token_is_punctuator(&preprocess.tokens[i], C_PUNCTUATOR_LEFT_BRACKET)) depth += 1;
+                if (c_token_is_punctuator(&preprocess.tokens[i], C_PUNCTUATOR_RIGHT_BRACKET)) { depth -= 1; if (!depth) { i += 1; break; } }
+            }
+        }
+        else
+        {
+            stop = true;
+        }
+    }
+    u32 shape = 11;
+    for (u32 k = 0; k < 10; k += 1)
+    {
+        if (f[k]) { shape = k; break; }
+    }
+    if (shape == 11 && i > start) shape = 10;
+    *tag_reference_plain = shape == 6;
+    return shape;
+}
+#define CENSUS_WRAP(c, h) __attribute__((noinline)) static CTypeId census_##c##_##h(CTypeParseMachine* machine, CParseResult* result, CPreprocessResult* preprocess, CScopeId scope, u32 start, u32 end, bool tag_only, u32* declarator_start) \
