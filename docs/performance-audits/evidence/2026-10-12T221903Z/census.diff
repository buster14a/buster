+__attribute__((noinline)) BUSTER_C_INTERNAL u32 c_ir_call_argument_separator(CIntegerIrBuilder* builder, u32 index, u32 end)
+{
+    // Keyed by the argument list's remaining range [index, end): a hit means
+    // the rest is one argument (no separator).
+    CensusHit hit = census_classify(builder, CC_ARGUMENT_SEPARATOR, index, end);
+    u32 result = hit.relative != CM_NONE ? (census_gate(builder, index, end, CG_COMMA) ? c_ir_call_argument_separator__hit(builder, index, end) : ((void)CADD(census_gate_hits[CC_ARGUMENT_SEPARATOR], 1), c_ir_call_argument_separator__gate(builder, index, end))) : c_ir_call_argument_separator__miss(builder, index, end);
+    census_check(CC_ARGUMENT_SEPARATOR, hit, (census_region(hit) & CM_COMMA) != 0 && !hit.stripped, result != end, index, end);
+    return result;
+}
