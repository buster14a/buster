+__attribute__((noinline)) BUSTER_C_INTERNAL bool c_ir_query_execute(CIntegerIrBuilder* builder, CIrQueryFrame root, CIrQueryFrame* result_out)
+{
+    bool ranged = root.kind != C_IR_QUERY_FRAME_ARRAY_BOUND;
+    CensusHit hit = ranged ? census_classify(builder, CC_QUERY_EXECUTE, root.start, root.end) : (CensusHit){.relative = CM_NONE};
+    if (!ranged)
+    {
+        CADD(census_calls[CC_QUERY_EXECUTE], 1);
+    }
+    return hit.relative != CM_NONE ? c_ir_query_execute__hit(builder, root, result_out) : c_ir_query_execute__miss(builder, root, result_out);
+}
