+__attribute__((noinline)) BUSTER_C_INTERNAL bool c_ir_has_root_comma(CIntegerIrBuilder* builder, u32 start, u32 end)
+{
+    CensusHit hit = census_classify(builder, CC_HAS_ROOT_COMMA, start, end);
+    bool result = hit.relative != CM_NONE ? (census_gate(builder, start, end, CG_COMMA) ? c_ir_has_root_comma__hit(builder, start, end) : ((void)CADD(census_gate_hits[CC_HAS_ROOT_COMMA], 1), c_ir_has_root_comma__gate(builder, start, end))) : c_ir_has_root_comma__miss(builder, start, end);
+    census_check(CC_HAS_ROOT_COMMA, hit, (census_region(hit) & CM_COMMA) != 0, result, start, end);
+    return result;
+}
+
+__attribute__((noinline)) BUSTER_C_INTERNAL bool c_ir_has_root_assignment(CIntegerIrBuilder* builder, u32 start, u32 end)
+{
+    CensusHit hit = census_classify(builder, CC_HAS_ROOT_ASSIGNMENT, start, end);
+    bool result = hit.relative != CM_NONE ? (census_gate(builder, start, end, CG_ASSIGN) ? c_ir_has_root_assignment__hit(builder, start, end) : ((void)CADD(census_gate_hits[CC_HAS_ROOT_ASSIGNMENT], 1), c_ir_has_root_assignment__gate(builder, start, end))) : c_ir_has_root_assignment__miss(builder, start, end);
+    census_check(CC_HAS_ROOT_ASSIGNMENT, hit, !hit.stripped && (census_region(hit) & CM_ASSIGN) != 0, result, start, end);
+    return result;
+}
+
+__attribute__((noinline)) BUSTER_C_INTERNAL bool c_ir_has_root_question(CIntegerIrBuilder* builder, u32 start, u32 end)
+{
+    CensusHit hit = census_classify(builder, CC_HAS_ROOT_QUESTION, start, end);
+    bool result = hit.relative != CM_NONE ? (census_gate(builder, start, end, CG_QUESTION) ? c_ir_has_root_question__hit(builder, start, end) : ((void)CADD(census_gate_hits[CC_HAS_ROOT_QUESTION], 1), c_ir_has_root_question__gate(builder, start, end))) : c_ir_has_root_question__miss(builder, start, end);
+    census_check(CC_HAS_ROOT_QUESTION, hit, !hit.stripped && (census_region(hit) & CM_QUESTION) != 0, result, start, end);
+    return result;
+}
