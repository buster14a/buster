+__attribute__((noinline)) BUSTER_C_INTERNAL bool c_ir_group_fact(CIntegerIrBuilder* builder, u32 open, u32 close, CIrGroupFact fact)
+{
+    CensusHit hit = census_classify(builder, CC_GROUP_FACT, open + 1, close);
+    u32 classes = fact == C_IR_GROUP_FACT_ROOT_CONTROL || fact == C_IR_GROUP_FACT_ANY_CONTROL ? (CG_QUESTION | CG_LOGICAL)
+                  : fact == C_IR_GROUP_FACT_ROOT_ASSIGNMENT || fact == C_IR_GROUP_FACT_ANY_ASSIGNMENT ? CG_ASSIGN
+                  : fact == C_IR_GROUP_FACT_ROOT_QUESTION ? CG_QUESTION
+                  : fact == C_IR_GROUP_FACT_TOP_COMMA ? CG_COMMA
+                                                       : (CG_QUESTION | CG_LOGICAL | CG_ASSIGN | CG_COMMA);
+    bool opaque = hit.relative != CM_NONE && (fact == C_IR_GROUP_FACT_ANY_ASSIGNMENT || fact == C_IR_GROUP_FACT_ANY_CONTROL) &&
+                  (census_map.any[hit.relative] & CM_OPAQUE);
+    if (opaque)
+    {
+        hit.relative = CM_NONE;
+    }
+    bool result = hit.relative != CM_NONE ? (census_gate(builder, open + 1, close, classes) ? c_ir_group_fact__hit(builder, open, close, fact)
+                                                                                        : ((void)CADD(census_gate_hits[CC_GROUP_FACT], 1), c_ir_group_fact__gate(builder, open, close, fact)))
+                                          : c_ir_group_fact__miss(builder, open, close, fact);
+    u8 region = hit.stripped ? 0 : census_region(hit);
+    u8 any = hit.relative != CM_NONE ? census_map.any[hit.relative] : 0;
+    bool tree = false;
+    bool checkable = true;
+    switch (fact)
+    {
+    case C_IR_GROUP_FACT_ROOT_CONTROL: tree = (region & (CM_QUESTION | CM_LOGICAL)) != 0; break;
+    case C_IR_GROUP_FACT_ROOT_ASSIGNMENT: tree = (region & CM_ASSIGN) != 0; break;
+    case C_IR_GROUP_FACT_ROOT_QUESTION: tree = (region & CM_QUESTION) != 0; break;
+    case C_IR_GROUP_FACT_TOP_COMMA: tree = (region & CM_COMMA) != 0; break;
+    case C_IR_GROUP_FACT_ANY_ASSIGNMENT: tree = (any & CM_ASSIGN) != 0; break;
+    case C_IR_GROUP_FACT_ANY_CONTROL: tree = (any & (CM_QUESTION | CM_LOGICAL)) != 0; break;
+    default: checkable = false; break;
+    }
+    census_last_fact = fact;
+    if (checkable)
+    {
+        census_check(CC_GROUP_FACT, hit, tree, result, open + 1, close);
+    }
+    return result;
+}
