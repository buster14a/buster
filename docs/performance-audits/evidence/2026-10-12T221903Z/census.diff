+__attribute__((noinline)) BUSTER_C_INTERNAL bool c_ir_tree_root_conditional(CIntegerIrBuilder* builder, u32 start, u32 end, u32* expression_start,
+                                                                             u32* question, u32* colon, u32* expression_end)
+{
+    CensusHit hit = census_classify(builder, CC_ROOT_CONDITIONAL, start, end);
+    bool result = hit.relative != CM_NONE ? c_ir_tree_root_conditional__hit(builder, start, end, expression_start, question, colon, expression_end)
+                                          : c_ir_tree_root_conditional__miss(builder, start, end, expression_start, question, colon, expression_end);
+    u32 kind = hit.relative != CM_NONE ? census_map.ast->kinds[census_map.begin + hit.relative] : 0;
+    bool tree = (kind == C_AST_CONDITIONAL || kind == C_AST_CONDITIONAL_OMITTED) &&
+                (kind == C_AST_CONDITIONAL || c_preprocess_dialect_is_gnu(builder->preprocess.dialect));
+    census_check(CC_ROOT_CONDITIONAL, hit, tree, result, start, end);
+    return result;
+}
