+__attribute__((noinline)) BUSTER_C_INTERNAL bool c_ir_prepare_calls_discover(CIntegerIrBuilder* builder, u32 start, u32 end, u32** emission_order_out,
+                                                                              u32* emission_count_out)
+{
+    CensusHit hit = census_classify(builder, CC_PREPARE_DISCOVER, start, end);
+    bool result = hit.relative != CM_NONE ? c_ir_prepare_calls_discover__hit(builder, start, end, emission_order_out, emission_count_out)
+                                          : c_ir_prepare_calls_discover__miss(builder, start, end, emission_order_out, emission_count_out);
+    if (hit.relative != CM_NONE)
+    {
+        // The tree's call count under the node, against the calls found.
+        CADD(census_answered_true[CC_PREPARE_DISCOVER], (census_map.any[hit.relative] & CM_CALL) != 0);
+        CADD(census_result_true[CC_PREPARE_DISCOVER], result && emission_count_out && *emission_count_out);
+    }
+    return result;
+}
