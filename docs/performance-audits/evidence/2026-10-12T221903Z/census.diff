diff --git a/src/buster/lib/compiler/frontend/c/census_frames.inc b/src/buster/lib/compiler/frontend/c/census_frames.inc
new file mode 100644
index 00000000..5d781e55
--- /dev/null
+++ b/src/buster/lib/compiler/frontend/c/census_frames.inc
@@ -0,0 +1,63 @@
+// THROWAWAY CENSUS frames (#3102). Never commit.
+#define CENSUS_FRAME(name, klass, field)                                                       \
+    BUSTER_C_INTERNAL void name##__real(CIntegerIrBuilder* builder);                            \
+    __attribute__((noinline)) static void name##__hit(CIntegerIrBuilder* builder)              \
+    {                                                                                          \
+        name##__real(builder);                                                                 \
+    }                                                                                          \
+    __attribute__((noinline)) static void name##__miss(CIntegerIrBuilder* builder)             \
+    {                                                                                          \
+        name##__real(builder);                                                                 \
+    }                                                                                          \
+    __attribute__((noinline)) BUSTER_C_INTERNAL void name(CIntegerIrBuilder* builder)          \
+    {                                                                                          \
+        CIrLowerFrame* frame = &builder->lower_machine.frames[builder->lower_machine.frame_count - 1]; \
+        CensusHit hit = {.relative = CM_NONE};                                                 \
+        if (frame->stage == C_IR_LOWER_STAGE_BEGIN)                                            \
+        {                                                                                      \
+            hit = census_classify(builder, klass, frame->as.field.start, frame->as.field.end); \
+        }                                                                                      \
+        if (hit.relative != CM_NONE)                                                           \
+        {                                                                                      \
+            name##__hit(builder);                                                              \
+        }                                                                                      \
+        else                                                                                   \
+        {                                                                                      \
+            name##__miss(builder);                                                             \
+        }                                                                                      \
+    }
+
+CENSUS_FRAME(c_ir_lower_expression_step, CC_EXPRESSION_FRAME, expression)
+CENSUS_FRAME(c_ir_lower_logical_value_step, CC_LOGICAL_FRAME, logical)
+CENSUS_FRAME(c_ir_lower_condition_step, CC_CONDITION_FRAME, condition)
+CENSUS_FRAME(c_ir_lower_expression_core_step, CC_CORE_FRAME, expression_core)
+
+#define CENSUS_FRAME2(name, klass, field)                                                      \
+    BUSTER_C_INTERNAL void name##__real(CIntegerIrBuilder* builder, CIrLowerFrame* frame);      \
+    __attribute__((noinline)) static void name##__hit(CIntegerIrBuilder* builder, CIrLowerFrame* frame) \
+    {                                                                                          \
+        name##__real(builder, frame);                                                          \
+    }                                                                                          \
+    __attribute__((noinline)) static void name##__miss(CIntegerIrBuilder* builder, CIrLowerFrame* frame) \
+    {                                                                                          \
+        name##__real(builder, frame);                                                          \
+    }                                                                                          \
+    __attribute__((noinline)) BUSTER_C_INTERNAL void name(CIntegerIrBuilder* builder, CIrLowerFrame* frame) \
+    {                                                                                          \
+        CensusHit hit = {.relative = CM_NONE};                                                 \
+        if (frame->stage == C_IR_LOWER_STAGE_BEGIN)                                            \
+        {                                                                                      \
+            hit = census_classify(builder, klass, frame->as.field.start, frame->as.field.end); \
+        }                                                                                      \
+        if (hit.relative != CM_NONE)                                                           \
+        {                                                                                      \
+            name##__hit(builder, frame);                                                       \
+        }                                                                                      \
+        else                                                                                   \
+        {                                                                                      \
+            name##__miss(builder, frame);                                                      \
+        }                                                                                      \
+    }
+
+CENSUS_FRAME2(c_ir_prepare_control_expressions_step, CC_PREPARE_CONTROL_FRAME, prepare_control)
+CENSUS_FRAME2(c_ir_prepare_calls_step, CC_PREPARE_CALLS_FRAME, prepare_calls)
diff --git a/src/buster/lib/compiler/frontend/c/census_map.inc b/src/buster/lib/compiler/frontend/c/census_map.inc
new file mode 100644
index 00000000..303bd769
--- /dev/null
+++ b/src/buster/lib/compiler/frontend/c/census_map.inc
@@ -0,0 +1,997 @@
+// THROWAWAY CENSUS for a token-to-node map in lowering (#3102). Never commit.
+// Included once into c_gen.c after struct CIntegerIrBuilder.
+#include <stdio.h>
+
+enum
+{
+    CC_ROOT_CONDITIONAL,
+    CC_HAS_ROOT_COMMA,
+    CC_HAS_ROOT_ASSIGNMENT,
+    CC_HAS_ROOT_QUESTION,
+    CC_HAS_ROOT_CONTROL,
+    CC_GROUP_FACT,
+    CC_CORE_CAPACITY,
+    CC_MAY_PREPARE_CONTROL,
+    CC_PREPARE_DISCOVER,
+    CC_ARGUMENT_SEPARATOR,
+    CC_UNEVALUATED_END,
+    CC_UNARY_END,
+    CC_GROUP_TYPE_NAME,
+    CC_QUERY_EXECUTE,
+    CC_SIZEOF_ATTEMPT,
+    CC_EXPRESSION_FRAME,
+    CC_LOGICAL_FRAME,
+    CC_CONDITION_FRAME,
+    CC_CORE_FRAME,
+    CC_PREPARE_CONTROL_FRAME,
+    CC_PREPARE_CALLS_FRAME,
+    CC_COUNT,
+};
+
+static char const* const census_class_names[CC_COUNT] = {
+    "root_conditional", "has_root_comma", "has_root_assignment", "has_root_question", "has_root_control", "group_fact",
+    "core_capacity", "may_prepare_control", "prepare_discover", "argument_separator", "unevaluated_end", "unary_end",
+    "group_type_name", "query_execute", "sizeof_attempt", "expression_frame", "logical_frame", "condition_frame",
+    "core_frame", "prepare_control_frame", "prepare_calls_frame",
+};
+
+#define CM_COMMA 1u
+#define CM_ASSIGN 2u
+#define CM_QUESTION 4u
+#define CM_LOGICAL 8u
+#define CM_CALL 16u
+#define CM_NONE UINT32_MAX
+
+typedef struct CensusMap CensusMap;
+struct CensusMap
+{
+    CAst const* ast;
+    CToken const* tokens;
+    u32 const* matches;
+    u32 token_total;
+    Arena* arena;
+    u64 mark;
+    u32 body_token_start;
+    u32 body_token_count;
+    bool built;
+    bool valid;
+    u32 begin;
+    u32 body;
+    // Design A: dense per-body start chain plus masks.
+    u32* first;
+    u32* end;
+    u32* link;
+    u32* head;
+    u8* region;
+    u8* any;
+    // Design B: sparse table of the nodes whose region holds a split operator.
+    u32* b_first;
+    u32* b_end;
+    u32* b_node;
+    u8* b_region;
+    u8* b_any;
+    u32 b_count;
+};
+
+static BUSTER_THREAD_LOCAL_DECL CensusMap census_map;
+BUSTER_C_INTERNAL u32 c_ir_statement_extents_body_node(CIrStatementExtents const* extents, u32 brace);
+
+static u64 census_calls[CC_COUNT];
+static u64 census_gate_hits[CC_COUNT];
+static u64 census_inbody[CC_COUNT];
+static u64 census_hit_a[CC_COUNT];
+static u64 census_hit_b[CC_COUNT];
+static u64 census_stripped[CC_COUNT];
+static u64 census_agree[CC_COUNT];
+static u64 census_disagree[CC_COUNT];
+static u64 census_result_true[CC_COUNT];
+static u64 census_answered_true[CC_COUNT];
+static u64 census_kinds[CC_COUNT][C_AST_KIND_COUNT];
+static u64 census_bodies;
+static u64 census_refused;
+static u64 census_body_nodes;
+static u64 census_body_tokens;
+static u64 census_spanned_nodes;
+static u64 census_b_entries;
+static u64 census_max_body_nodes;
+static u64 census_max_body_tokens;
+static u64 census_disagree_print;
+static BUSTER_THREAD_LOCAL_DECL u32 census_last_fact;
+
+#define CADD(x, v) __atomic_fetch_add(&(x), (u64)(v), __ATOMIC_RELAXED)
+
+__attribute__((destructor)) static void census_print(void)
+{
+    if (!census_bodies && !census_calls[CC_HAS_ROOT_COMMA])
+    {
+        return;
+    }
+    fprintf(stderr, "CENSUS bodies=%llu refused=%llu body_nodes=%llu body_tokens=%llu spanned=%llu b_entries=%llu max_nodes=%llu max_tokens=%llu\n",
+            (unsigned long long)census_bodies, (unsigned long long)census_refused, (unsigned long long)census_body_nodes,
+            (unsigned long long)census_body_tokens, (unsigned long long)census_spanned_nodes, (unsigned long long)census_b_entries,
+            (unsigned long long)census_max_body_nodes, (unsigned long long)census_max_body_tokens);
+    for (u32 c = 0; c < CC_COUNT; c += 1)
+    {
+        fprintf(stderr, "CENSUS_CLASS %s calls=%llu inbody=%llu hit_a=%llu hit_b=%llu stripped=%llu agree=%llu disagree=%llu result_true=%llu answered_true=%llu gate=%llu kinds=",
+                census_class_names[c], (unsigned long long)census_calls[c], (unsigned long long)census_inbody[c], (unsigned long long)census_hit_a[c],
+                (unsigned long long)census_hit_b[c], (unsigned long long)census_stripped[c], (unsigned long long)census_agree[c],
+                (unsigned long long)census_disagree[c], (unsigned long long)census_result_true[c], (unsigned long long)census_answered_true[c],
+                (unsigned long long)census_gate_hits[c]);
+        for (u32 k = 0; k < C_AST_KIND_COUNT; k += 1)
+        {
+            if (census_kinds[c][k])
+            {
+                String8 name = c_ast_kind_name((CAstKind)k);
+                fprintf(stderr, "%.*s:%llu,", (int)name.length, (char const*)name.pointer, (unsigned long long)census_kinds[c][k]);
+            }
+        }
+        fprintf(stderr, "\n");
+    }
+}
+
+static BUSTER_INLINE u32 census_match(CensusMap const* m, u32 open)
+{
+    u32 close = open < m->token_total ? m->matches[open] - 1 : CM_NONE;
+    return close > open ? close : CM_NONE;
+}
+
+static BUSTER_INLINE bool census_punct(CensusMap const* m, u32 token, CPunctuator punctuator)
+{
+    return token < m->token_total && c_token_is_punctuator(&m->tokens[token], punctuator);
+}
+
+static BUSTER_INLINE u32 census_first_child(CAst const* ast, u32 node)
+{
+    u32 begin = c_ast_subtree_begin(ast, node);
+    u32 child = node - 1;
+    while (c_ast_subtree_begin(ast, child) > begin)
+    {
+        child = c_ast_subtree_begin(ast, child) - 1;
+    }
+    return child;
+}
+
+static BUSTER_INLINE void census_expand(CensusMap const* m, u32 const* first_column, u32 const* end_column, u32 relative, u32* first_out, u32* end_out)
+{
+    u32 first = first_column[relative];
+    u32 end = end_column[relative];
+    if (first != CM_NONE)
+    {
+        while (first > 0 && census_punct(m, first - 1, C_PUNCTUATOR_LEFT_PARENTHESIS) && census_match(m, first - 1) == end)
+        {
+            first -= 1;
+            end += 1;
+        }
+    }
+    *first_out = first;
+    *end_out = end;
+}
+
+static BUSTER_INLINE bool census_wrapped(CensusMap const* m, u32 const* first_column, u32 const* end_column, u32 relative)
+{
+    u32 first = first_column[relative];
+    return first != CM_NONE && first > 0 && census_punct(m, first - 1, C_PUNCTUATOR_LEFT_PARENTHESIS) && census_match(m, first - 1) == end_column[relative];
+}
+
+// The typer's span rules (c_ast_types_span), over the census columns.
+static BUSTER_INLINE void census_span(CensusMap const* m, u32 const* first_column, u32 const* end_column, u32 node, u32 relative, u32* first_out,
+                                      u32* end_out)
+{
+    CAst const* ast = m->ast;
+    u32 kind = ast->kinds[node];
+    u32 token = ast->tokens[node];
+    u32 first = CM_NONE;
+    u32 end = CM_NONE;
+    switch (kind)
+    {
+    case C_AST_IDENTIFIER:
+    case C_AST_NUMBER:
+    case C_AST_CHARACTER:
+    case C_AST_BOOLEAN_CONSTANT:
+    case C_AST_NULLPTR:
+        first = token;
+        end = token + 1;
+        break;
+    case C_AST_STRING:
+        first = token;
+        end = token + ast->data[node];
+        break;
+    case C_AST_LABEL_ADDRESS:
+        first = token ? token - 1 : CM_NONE;
+        end = token + 1;
+        break;
+    case C_AST_STATEMENT_EXPRESSION:
+    case C_AST_INITIALIZER_LIST:
+    {
+        u32 close = census_match(m, token);
+        first = close != CM_NONE ? token : CM_NONE;
+        end = close != CM_NONE ? close + 1 : CM_NONE;
+    }
+    break;
+    case C_AST_GENERIC_SELECTION:
+    case C_AST_SIZEOF_TYPE:
+    case C_AST_ALIGNOF_TYPE:
+    {
+        u32 close = census_match(m, token + 1);
+        first = close != CM_NONE ? token : CM_NONE;
+        end = close != CM_NONE ? close + 1 : CM_NONE;
+    }
+    break;
+    case C_AST_CALL:
+    case C_AST_INDEX:
+    {
+        u32 callee = census_first_child(ast, node);
+        u32 ef = CM_NONE;
+        u32 ee = CM_NONE;
+        census_expand(m, first_column, end_column, callee - m->begin, &ef, &ee);
+        u32 close = census_match(m, token);
+        if (ef != CM_NONE && close != CM_NONE)
+        {
+            first = ef;
+            end = close + 1;
+        }
+    }
+    break;
+    case C_AST_MEMBER:
+    case C_AST_MEMBER_ARROW:
+    case C_AST_POST_INCREMENT:
+    case C_AST_POST_DECREMENT:
+    {
+        u32 ef = CM_NONE;
+        u32 ee = CM_NONE;
+        census_expand(m, first_column, end_column, relative - 1, &ef, &ee);
+        if (ef != CM_NONE)
+        {
+            first = ef;
+            end = token + 1;
+        }
+    }
+    break;
+    case C_AST_COMPOUND_LITERAL:
+    {
+        u32 close = census_match(m, ast->tokens[node - 1]);
+        first = close != CM_NONE ? token : CM_NONE;
+        end = close != CM_NONE ? close + 1 : CM_NONE;
+    }
+    break;
+    default:
+    {
+        if (kind >= C_AST_PRE_INCREMENT && kind <= C_AST_CAST)
+        {
+            u32 ef = CM_NONE;
+            u32 ee = CM_NONE;
+            census_expand(m, first_column, end_column, relative - 1, &ef, &ee);
+            if (ef != CM_NONE)
+            {
+                first = token;
+                end = ee;
+            }
+        }
+        else if (kind >= C_AST_MULTIPLY && kind <= C_AST_COMMA)
+        {
+            u32 leftmost = census_first_child(ast, node);
+            u32 lf = CM_NONE;
+            u32 le = CM_NONE;
+            u32 rf = CM_NONE;
+            u32 re = CM_NONE;
+            census_expand(m, first_column, end_column, leftmost - m->begin, &lf, &le);
+            census_expand(m, first_column, end_column, relative - 1, &rf, &re);
+            if (lf != CM_NONE && re != CM_NONE)
+            {
+                first = lf;
+                end = re;
+            }
+        }
+    }
+    break;
+    }
+    bool valid = first != CM_NONE && end != CM_NONE && first < end && end <= m->token_total;
+    *first_out = valid ? first : CM_NONE;
+    *end_out = valid ? end : CM_NONE;
+}
+
+static BUSTER_INLINE u8 census_own_bit(u32 kind)
+{
+    u8 bit = 0;
+    if (kind == C_AST_COMMA)
+    {
+        bit = CM_COMMA;
+    }
+    else if (kind >= C_AST_ASSIGN && kind <= C_AST_BIT_OR_ASSIGN)
+    {
+        bit = CM_ASSIGN;
+    }
+    else if (kind == C_AST_CONDITIONAL || kind == C_AST_CONDITIONAL_OMITTED)
+    {
+        bit = CM_QUESTION;
+    }
+    else if (kind == C_AST_LOGICAL_AND || kind == C_AST_LOGICAL_OR)
+    {
+        bit = CM_LOGICAL;
+    }
+    else if (kind == C_AST_CALL)
+    {
+        bit = CM_CALL;
+    }
+    return bit;
+}
+
+#define CM_OPAQUE 32u
+enum
+{
+    CK_SKIP,
+    CK_LEAF,
+    CK_BINARY,
+    CK_CONDITIONAL,
+    CK_CONDITIONAL_OMITTED,
+    CK_UNARY,
+    CK_CALL,
+    CK_INDEX,
+    CK_OPAQUE,
+};
+
+static u8 census_kind_class[C_AST_KIND_COUNT];
+
+static void census_kind_classes(void)
+{
+    if (census_kind_class[C_AST_IDENTIFIER])
+    {
+        return;
+    }
+    for (u32 kind = 0; kind < C_AST_KIND_COUNT; kind += 1)
+    {
+        u8 klass = CK_SKIP;
+        if (kind == C_AST_IDENTIFIER || kind == C_AST_NUMBER || kind == C_AST_CHARACTER || kind == C_AST_STRING || kind == C_AST_BOOLEAN_CONSTANT ||
+            kind == C_AST_NULLPTR || kind == C_AST_LABEL_ADDRESS)
+        {
+            klass = CK_LEAF;
+        }
+        else if (kind == C_AST_CONDITIONAL)
+        {
+            klass = CK_CONDITIONAL;
+        }
+        else if (kind == C_AST_CONDITIONAL_OMITTED)
+        {
+            klass = CK_CONDITIONAL_OMITTED;
+        }
+        else if (kind >= C_AST_MULTIPLY && kind <= C_AST_COMMA)
+        {
+            klass = CK_BINARY;
+        }
+        else if (kind == C_AST_CALL)
+        {
+            klass = CK_CALL;
+        }
+        else if (kind == C_AST_INDEX)
+        {
+            klass = CK_INDEX;
+        }
+        else if ((kind >= C_AST_PRE_INCREMENT && kind <= C_AST_CAST && kind != C_AST_SIZEOF_TYPE && kind != C_AST_ALIGNOF_TYPE) || kind == C_AST_MEMBER ||
+                 kind == C_AST_MEMBER_ARROW || kind == C_AST_POST_INCREMENT || kind == C_AST_POST_DECREMENT)
+        {
+            klass = CK_UNARY;
+        }
+        else if (kind == C_AST_STATEMENT_EXPRESSION || kind == C_AST_GENERIC_SELECTION || kind == C_AST_SIZEOF_TYPE || kind == C_AST_ALIGNOF_TYPE ||
+                 kind == C_AST_COMPOUND_LITERAL || kind == C_AST_INITIALIZER_LIST)
+        {
+            klass = CK_OPAQUE;
+        }
+        census_kind_class[kind] = klass;
+    }
+}
+
+static BUSTER_INLINE u8 census_child_region(CensusMap const* m, u32 const* first_column, u32 const* end_column, u8 const* region, u32 relative)
+{
+    return census_wrapped(m, first_column, end_column, relative) ? 0 : region[relative];
+}
+
+// One forward pass over the body's nodes: spans for expression nodes, the
+// root-region mask (operators outside any parenthesis, bracket or brace of the
+// node, as the token scans see depth 0) and the anywhere mask. Statements and
+// declarations are skipped; opaque kinds (statement expressions, compound
+// literals, initializer lists, _Generic, sizeof/alignof of a type) mark the
+// anywhere mask opaque.
+static BUSTER_INLINE void census_pass(CensusMap const* m, u32* first_column, u32* end_column, u8* region, u8* any, u32 count, u64* spanned_out)
+{
+    CAst const* ast = m->ast;
+    u64 spanned = 0;
+    for (u32 relative = 0; relative < count; relative += 1)
+    {
+        u32 node = m->begin + relative;
+        u32 kind = ast->kinds[node];
+        u8 klass = census_kind_class[kind];
+        u32 first = CM_NONE;
+        u32 end = CM_NONE;
+        u8 region_mask = 0;
+        u8 any_mask = 0;
+        if (klass != CK_SKIP)
+        {
+            census_span(m, first_column, end_column, node, relative, &first, &end);
+            u8 own = census_own_bit(kind);
+            region_mask = own;
+            any_mask = own;
+            switch (klass)
+            {
+            case CK_BINARY:
+            {
+                u32 right = relative - 1;
+                u32 left = right - ast->extents[node - 1];
+                region_mask |= census_child_region(m, first_column, end_column, region, left) | census_child_region(m, first_column, end_column, region, right);
+                any_mask |= any[left] | any[right];
+            }
+            break;
+            case CK_CONDITIONAL:
+            {
+                u32 otherwise = relative - 1;
+                u32 then = otherwise - ast->extents[node - 1];
+                u32 condition = then - ast->extents[m->begin + then];
+                region_mask |= census_child_region(m, first_column, end_column, region, condition) |
+                               (u8)((census_child_region(m, first_column, end_column, region, then) |
+                                     census_child_region(m, first_column, end_column, region, otherwise)) &
+                                    ~CM_ASSIGN);
+                any_mask |= any[condition] | any[then] | any[otherwise];
+            }
+            break;
+            case CK_CONDITIONAL_OMITTED:
+            {
+                u32 otherwise = relative - 1;
+                u32 condition = otherwise - ast->extents[node - 1];
+                region_mask |= census_child_region(m, first_column, end_column, region, condition) |
+                               (u8)(census_child_region(m, first_column, end_column, region, otherwise) & ~CM_ASSIGN);
+                any_mask |= any[condition] | any[otherwise];
+            }
+            break;
+            case CK_UNARY:
+                region_mask |= census_child_region(m, first_column, end_column, region, relative - 1);
+                any_mask |= any[relative - 1];
+                break;
+            case CK_INDEX:
+            {
+                u32 subscript = relative - 1;
+                u32 base = subscript - ast->extents[node - 1];
+                region_mask |= census_child_region(m, first_column, end_column, region, base);
+                any_mask |= any[base] | any[subscript];
+            }
+            break;
+            case CK_CALL:
+            {
+                u32 begin = relative + 1 - ast->extents[node];
+                u32 child = relative - 1;
+                while (true)
+                {
+                    any_mask |= any[child];
+                    u32 child_begin = child + 1 - ast->extents[m->begin + child];
+                    if (child_begin == begin)
+                    {
+                        break;
+                    }
+                    child = child_begin - 1;
+                }
+                region_mask |= census_child_region(m, first_column, end_column, region, child);
+            }
+            break;
+            case CK_OPAQUE:
+                any_mask |= CM_OPAQUE;
+                break;
+            default:
+                break;
+            }
+        }
+        first_column[relative] = first;
+        end_column[relative] = end;
+        spanned += first != CM_NONE;
+        region[relative] = region_mask;
+        any[relative] = any_mask;
+    }
+    *spanned_out = spanned;
+}
+
+__attribute__((noinline)) static void census_a_build(CensusMap* m, u64* spanned_out)
+{
+    census_kind_classes();
+    u32 count = m->body - m->begin + 1;
+    m->first = arena_allocate(m->arena, u32, count);
+    m->end = arena_allocate(m->arena, u32, count);
+    m->link = arena_allocate(m->arena, u32, count);
+    m->region = arena_allocate(m->arena, u8, count);
+    m->any = arena_allocate(m->arena, u8, count);
+    m->head = arena_allocate(m->arena, u32, (u64)m->body_token_count + 1);
+    memset(m->head, 0, sizeof(u32) * ((u64)m->body_token_count + 1));
+    census_pass(m, m->first, m->end, m->region, m->any, count, spanned_out);
+    for (u32 relative = 0; relative < count; relative += 1)
+    {
+        u32 first = m->first[relative];
+        u32 offset = first - m->body_token_start;
+        if (first != CM_NONE && first >= m->body_token_start && offset < m->body_token_count)
+        {
+            m->link[relative] = m->head[offset];
+            m->head[offset] = relative + 1;
+        }
+    }
+}
+
+__attribute__((noinline)) static void census_b_build(CensusMap* m)
+{
+    census_kind_classes();
+    u32 count = m->body - m->begin + 1;
+    u64 position = m->arena->position;
+    u32* first_column = arena_allocate(m->arena, u32, count);
+    u32* end_column = arena_allocate(m->arena, u32, count);
+    u8* region = arena_allocate(m->arena, u8, count);
+    u8* any = arena_allocate(m->arena, u8, count);
+    u64 spanned = 0;
+    census_pass(m, first_column, end_column, region, any, count, &spanned);
+    u32 selected = 0;
+    for (u32 relative = 0; relative < count; relative += 1)
+    {
+        selected += first_column[relative] != CM_NONE && region[relative] != 0;
+    }
+    u64* keys = arena_allocate(m->arena, u64, (u64)selected + 1);
+    u64* scratch = arena_allocate(m->arena, u64, (u64)selected + 1);
+    u32 filled = 0;
+    for (u32 relative = 0; relative < count; relative += 1)
+    {
+        if (first_column[relative] != CM_NONE && region[relative] != 0)
+        {
+            keys[filled++] = ((u64)(first_column[relative] - m->body_token_start) << 32) | relative;
+        }
+    }
+    // LSD radix sort by the high 32 bits, 8-bit digits, skipping empty digits.
+    u32 high = m->body_token_count;
+    for (u32 shift = 32; shift < 64 && (high >> (shift - 32)) != 0; shift += 8)
+    {
+        u32 counts[257];
+        memset(counts, 0, sizeof(counts));
+        for (u32 index = 0; index < selected; index += 1)
+        {
+            counts[((keys[index] >> shift) & 0xffu) + 1] += 1;
+        }
+        for (u32 digit = 0; digit < 256; digit += 1)
+        {
+            counts[digit + 1] += counts[digit];
+        }
+        for (u32 index = 0; index < selected; index += 1)
+        {
+            scratch[counts[(keys[index] >> shift) & 0xffu]++] = keys[index];
+        }
+        u64* swap = keys;
+        keys = scratch;
+        scratch = swap;
+    }
+    // Retained compact table; the transient columns are dropped.
+    u32* b_first = arena_allocate(m->arena, u32, (u64)selected + 1);
+    u32* b_end = arena_allocate(m->arena, u32, (u64)selected + 1);
+    u32* b_node = arena_allocate(m->arena, u32, (u64)selected + 1);
+    u8* b_region = arena_allocate(m->arena, u8, (u64)selected + 1);
+    u8* b_any = arena_allocate(m->arena, u8, (u64)selected + 1);
+    for (u32 index = 0; index < selected; index += 1)
+    {
+        u32 relative = (u32)keys[index];
+        b_first[index] = first_column[relative];
+        b_end[index] = end_column[relative];
+        b_node[index] = relative;
+        b_region[index] = region[relative];
+        b_any[index] = any[relative];
+    }
+    (void)position;
+    m->b_first = b_first;
+    m->b_end = b_end;
+    m->b_node = b_node;
+    m->b_region = b_region;
+    m->b_any = b_any;
+    m->b_count = selected;
+}
+
+// Design A lookup: the node whose span is exactly [start, end) after
+// stripping balanced outer parentheses (c_ast_types_locate).
+__attribute__((noinline)) static u32 census_a_locate(CensusMap const* m, u32 start, u32 end, bool* stripped_out)
+{
+    u32 relative = CM_NONE;
+    bool stripped = false;
+    bool searching = start < end && start >= m->body_token_start && end <= m->body_token_start + m->body_token_count;
+    while (searching)
+    {
+        u32 hit = m->head[start - m->body_token_start];
+        while (hit && relative == CM_NONE)
+        {
+            relative = m->end[hit - 1] == end ? hit - 1 : CM_NONE;
+            hit = relative == CM_NONE ? m->link[hit - 1] : 0;
+        }
+        searching = relative == CM_NONE && end > start + 2 && census_punct(m, start, C_PUNCTUATOR_LEFT_PARENTHESIS) && census_match(m, start) + 1 == end;
+        stripped |= searching;
+        start += searching ? 1 : 0;
+        end -= searching ? 1 : 0;
+    }
+    *stripped_out = stripped;
+    return relative;
+}
+
+// Design B lookup: binary search by start, then the entries sharing it.
+__attribute__((noinline)) static u32 census_b_locate(CensusMap const* m, u32 start, u32 end)
+{
+    u32 found = CM_NONE;
+    bool searching = start < end && start >= m->body_token_start && end <= m->body_token_start + m->body_token_count;
+    while (searching)
+    {
+        u32 low = 0;
+        u32 high = m->b_count;
+        while (low < high)
+        {
+            u32 middle = low + (high - low) / 2;
+            low = m->b_first[middle] < start ? middle + 1 : low;
+            high = m->b_first[middle] < start ? high : middle;
+        }
+        for (u32 index = low; index < m->b_count && m->b_first[index] == start && found == CM_NONE; index += 1)
+        {
+            found = m->b_end[index] == end ? index : CM_NONE;
+        }
+        searching = found == CM_NONE && end > start + 2 && census_punct(m, start, C_PUNCTUATOR_LEFT_PARENTHESIS) && census_match(m, start) + 1 == end;
+        start += searching ? 1 : 0;
+        end -= searching ? 1 : 0;
+    }
+    return found;
+}
+
+// Opens the builder's current body in the map, building both designs on the
+// first query of each body. Returns false outside a mapped body.
+__attribute__((noinline)) static bool census_ensure(CIntegerIrBuilder* builder)
+{
+    CIrStatementExtents* extents = builder->statement_extents;
+    CensusMap* m = &census_map;
+    bool ready = false;
+    if (extents && builder->stream_matching_delimiters_plus_one && extents->token_start)
+    {
+        if (!m->arena)
+        {
+            m->arena = c_frontend_arena_create((ArenaCreation){0}, C_FRONTEND_RESERVATION_LOWERING);
+            m->mark = m->arena->position;
+        }
+        if (!m->built || m->body_token_start != extents->token_start || m->ast != extents->ast)
+        {
+            arena_set_position(m->arena, m->mark);
+            m->ast = extents->ast;
+            m->tokens = builder->preprocess.tokens;
+            m->matches = builder->stream_matching_delimiters_plus_one;
+            m->token_total = (u32)builder->preprocess.token_count;
+            m->body_token_start = extents->token_start;
+            m->body_token_count = extents->token_count;
+            m->built = true;
+            u32 body = c_ir_statement_extents_body_node(extents, extents->token_start - 1);
+            m->valid = body != C_AST_NODE_INVALID;
+            if (m->valid)
+            {
+                m->body = body;
+                m->begin = c_ast_subtree_begin(m->ast, body);
+                u64 spanned = 0;
+                census_a_build(m, &spanned);
+                census_b_build(m);
+                u32 count = body - m->begin + 1;
+                CADD(census_bodies, 1);
+                CADD(census_body_nodes, count);
+                CADD(census_body_tokens, m->body_token_count);
+                CADD(census_spanned_nodes, spanned);
+                CADD(census_b_entries, m->b_count);
+                if (count > census_max_body_nodes)
+                {
+                    census_max_body_nodes = count;
+                }
+                if (m->body_token_count > census_max_body_tokens)
+                {
+                    census_max_body_tokens = m->body_token_count;
+                }
+            }
+            else
+            {
+                CADD(census_refused, 1);
+            }
+        }
+        ready = m->valid;
+    }
+    return ready;
+}
+
+typedef struct CensusHit CensusHit;
+struct CensusHit
+{
+    u32 relative;
+    u32 b_index;
+    bool stripped;
+    bool in_body;
+};
+
+__attribute__((noinline)) static CensusHit census_classify(CIntegerIrBuilder* builder, u32 klass, u32 start, u32 end)
+{
+    CensusHit hit = {.relative = CM_NONE, .b_index = CM_NONE};
+    CADD(census_calls[klass], 1);
+    CensusMap* m = &census_map;
+    if (census_ensure(builder) && start < end && start >= m->body_token_start && end <= m->body_token_start + m->body_token_count)
+    {
+        hit.in_body = true;
+        CADD(census_inbody[klass], 1);
+        hit.relative = census_a_locate(m, start, end, &hit.stripped);
+        hit.b_index = census_b_locate(m, start, end);
+        if (hit.relative != CM_NONE)
+        {
+            CADD(census_hit_a[klass], 1);
+            CADD(census_stripped[klass], hit.stripped);
+            CADD(census_kinds[klass][m->ast->kinds[m->begin + hit.relative]], 1);
+        }
+        CADD(census_hit_b[klass], hit.b_index != CM_NONE);
+    }
+    return hit;
+}
+
+static void census_check(u32 klass, CensusHit hit, bool tree_answer, bool result, u32 start, u32 end)
+{
+    CADD(census_result_true[klass], result);
+    if (hit.relative != CM_NONE)
+    {
+        CADD(census_answered_true[klass], tree_answer);
+        if (tree_answer == result)
+        {
+            CADD(census_agree[klass], 1);
+        }
+        else
+        {
+            CADD(census_disagree[klass], 1);
+            if (census_disagree_print < 40)
+            {
+                census_disagree_print += 1;
+                CensusMap* m = &census_map;
+                fprintf(stderr, "CENSUS_DISAGREE %s [%u,%u) kind=%u tree=%d scan=%d stripped=%d fact=%u\n", census_class_names[klass], start, end,
+                        m->ast->kinds[m->begin + hit.relative], tree_answer, result, hit.stripped, census_last_fact);
+            }
+        }
+    }
+}
+
+// The answer each root-token predicate would take from the node: the region
+// mask, false when the range was wrapped in parentheses for the scans that do
+// not strip them.
+static BUSTER_INLINE u8 census_region(CensusHit hit)
+{
+    return hit.relative != CM_NONE ? census_map.region[hit.relative] : 0;
+}
+
+BUSTER_C_INTERNAL bool c_ir_assignment_operator(CToken token);
+
+#define CG_COMMA 1u
+#define CG_ASSIGN 2u
+#define CG_QUESTION 4u
+#define CG_LOGICAL 8u
+
+// Whether [start, end) holds a candidate token of `classes` anywhere, nested
+// or not: a token-count gate (no tree) answers every range that holds none.
+__attribute__((noinline)) static bool census_gate(CIntegerIrBuilder* builder, u32 start, u32 end, u32 classes)
+{
+    bool present = false;
+    for (u32 index = start; index < end && !present; index += 1)
+    {
+        CToken token = builder->preprocess.tokens[index];
+        present = ((classes & CG_COMMA) && c_token_is_punctuator(&token, C_PUNCTUATOR_COMMA)) ||
+                  ((classes & CG_QUESTION) && c_token_is_punctuator(&token, C_PUNCTUATOR_QUESTION)) ||
+                  ((classes & CG_LOGICAL) && (c_token_is_punctuator(&token, C_PUNCTUATOR_AMPERSAND_AMPERSAND) || c_token_is_punctuator(&token, C_PUNCTUATOR_PIPE_PIPE))) ||
+                  ((classes & CG_ASSIGN) && c_ir_assignment_operator(token));
+    }
+    return present;
+}
+BUSTER_C_INTERNAL bool c_ir_assignment_operator(CToken token);
