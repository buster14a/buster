+__attribute__((noinline)) BUSTER_C_INTERNAL bool c_ir_range_may_prepare_control(CIntegerIrBuilder* builder, u32 start, u32 end)
+{
+    CensusHit hit = census_classify(builder, CC_MAY_PREPARE_CONTROL, start, end);
+    return hit.relative != CM_NONE ? c_ir_range_may_prepare_control__hit(builder, start, end) : c_ir_range_may_prepare_control__miss(builder, start, end);
+}
