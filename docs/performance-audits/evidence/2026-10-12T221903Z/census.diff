+__attribute__((noinline)) BUSTER_C_INTERNAL bool c_ir_has_root_control_operator(CIntegerIrBuilder* builder, u32 start, u32 end)
+{
+    CensusHit hit = census_classify(builder, CC_HAS_ROOT_CONTROL, start, end);
+    bool result =
+        hit.relative != CM_NONE ? (census_gate(builder, start, end, CG_QUESTION | CG_LOGICAL) ? c_ir_has_root_control_operator__hit(builder, start, end) : ((void)CADD(census_gate_hits[CC_HAS_ROOT_CONTROL], 1), c_ir_has_root_control_operator__gate(builder, start, end))) : c_ir_has_root_control_operator__miss(builder, start, end);
+    census_check(CC_HAS_ROOT_CONTROL, hit, !hit.stripped && (census_region(hit) & (CM_QUESTION | CM_LOGICAL)) != 0, result, start, end);
+    return result;
+}
