+__attribute__((noinline)) BUSTER_C_INTERNAL IrTypeId c_ir_group_type_name(CIntegerIrBuilder* builder, u32 open, u32 close)
+{
+    // Exact negative: a group whose interior is one expression node holds no
+    // type name, because the tree resolved typedef names when it parsed.
+    CensusHit hit = census_classify(builder, CC_GROUP_TYPE_NAME, open + 1, close);
+    IrTypeId result = hit.relative != CM_NONE ? c_ir_group_type_name__hit(builder, open, close) : c_ir_group_type_name__miss(builder, open, close);
+    census_check(CC_GROUP_TYPE_NAME, hit, false, result.value != IR_ID_UNDERLYING_INVALID, open + 1, close);
+    return result;
+}
