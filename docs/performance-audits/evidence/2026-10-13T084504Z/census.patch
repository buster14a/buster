+__attribute__((noinline)) static void census_tw1_call(void) { __asm__ volatile(""); }
+__attribute__((noinline)) static void census_tw1_true(void) { __asm__ volatile(""); }
+__attribute__((noinline)) static void census_tw1_nosymbol(void) { __asm__ volatile(""); }
+__attribute__((noinline)) static void census_tw1_predefined(void) { __asm__ volatile(""); }
+__attribute__((noinline)) static void census_tw1_mismatch(void) { __asm__ volatile(""); }
+__attribute__((noinline)) static void census_tw2_call(void) { __asm__ volatile(""); }
