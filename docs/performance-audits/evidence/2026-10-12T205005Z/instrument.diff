+BUSTER_GLOBAL_LOCAL void census_plain_member(CTypeParseMachine* machine, CTypeParseFrame* frame, CPreprocessResult preprocess)
+{
+    CAst const* ast = machine->syntax_tree;
+    bool token_plain = true;
+    for (u32 index = frame->start; index < frame->end; index += 1)
+    {
+        CToken token = preprocess.tokens[index];
+        if (token.kind == C_TOKEN_IDENTIFIER)
+        {
+            token_plain &= !census_decoration_spelling(c_token_spelling(preprocess.spelling_base, token));
+        }
+        else if (token.kind != C_TOKEN_PREPROCESSING_NUMBER)
+        {
+            token_plain &= c_token_is_punctuator(&token, C_PUNCTUATOR_STAR) || c_token_is_punctuator(&token, C_PUNCTUATOR_LEFT_BRACKET) ||
+                           c_token_is_punctuator(&token, C_PUNCTUATOR_RIGHT_BRACKET) || c_token_is_punctuator(&token, C_PUNCTUATOR_COMMA);
+        }
+    }
+    u32 node = c_parse_specifier_node(machine, frame->start);
+    u32 why = 0; // 0 plain, 1 no list, 2 other kind, 3 decoration word
+    u32 bad_kind = 0;
+    u32 member_node = C_AST_NODE_INVALID;
+    if (node == C_AST_NODE_INVALID)
+    {
+        why = 1;
+    }
+    else
+    {
+        for (u32 child = c_ast_subtree_begin(ast, node); child <= node && !why; child += 1)
+        {
+            u32 kind = ast->kinds[child];
+            if (kind == C_AST_SPECIFIER_WORD)
+            {
+                u32 word = ast->data[child];
+                why = word == C_AST_WORD_EXTENSION || word == C_AST_WORD_ALIGNAS || word == C_AST_WORD_ATTRIBUTE || word == C_AST_WORD_DECLSPEC ||
+                              word == C_AST_WORD_ASM || word == C_AST_WORD_STATIC_ASSERT
+                          ? 3
+                          : 0;
+            }
+            if (!why && kind != C_AST_DECL_SPECIFIERS &&
+                census_decoration_spelling(c_token_spelling(preprocess.spelling_base, preprocess.tokens[ast->tokens[child]])))
+            {
+                why = 3;
+            }
+        }
+        for (u32 child = node + 1; child < ast->node_count && !why && member_node == C_AST_NODE_INVALID; child += 1)
+        {
+            u32 kind = ast->kinds[child];
+            u32 data = ast->data[child];
+            switch (kind)
+            {
+            case C_AST_MEMBER_DECLARATION:
+                member_node = child;
+                break;
+            case C_AST_MEMBER_DECLARATOR:
+                why = (data & C_AST_PRESENCE_MASK) == 1 ? 0 : 2;
+                break;
+            case C_AST_DECLARATOR_POINTER:
+                why = (data & 1) ? 2 : 0;
+                break;
+            case C_AST_DECLARATOR_ARRAY:
+            case C_AST_DECLARATOR_NAME:
+            case C_AST_NUMBER:
+            case C_AST_CHARACTER:
+            case C_AST_IDENTIFIER:
+            case C_AST_MULTIPLY:
+            case C_AST_DIVIDE:
+            case C_AST_REMAINDER:
+            case C_AST_ADD:
+            case C_AST_SUBTRACT:
+            case C_AST_SHIFT_LEFT:
+            case C_AST_SHIFT_RIGHT:
+            case C_AST_PLUS:
+            case C_AST_NEGATE:
+            case C_AST_BIT_NOT:
+            case C_AST_BIT_AND:
+            case C_AST_BIT_XOR:
+            case C_AST_BIT_OR:
+                break;
+            default:
+                why = 2;
+                bad_kind = kind;
+                break;
+            }
+            if (!why && member_node == C_AST_NODE_INVALID &&
+                census_decoration_spelling(c_token_spelling(preprocess.spelling_base, preprocess.tokens[ast->tokens[child]])))
+            {
+                why = 3;
+            }
+        }
+        why = !why && member_node == C_AST_NODE_INVALID ? 2 : why;
+    }
+    bool tree_plain = why == 0;
+    string_print_error(S8("PLAINCENSUS tree={u32} token={u32} why={u32} kind={S8} start={u32} end={u32}"), (u32)tree_plain, (u32)token_plain, why,
+                       why == 2 && bad_kind ? c_ast_kind_name((CAstKind)bad_kind) : S8("-"), frame->start, frame->end);
+    if (tree_plain != token_plain)
+    {
+        string_print_error(S8(" DISAGREE:"));
+        for (u32 index = frame->start; index < frame->end; index += 1)
+        {
+            string_print_error(S8(" {S8}"), c_token_spelling(preprocess.spelling_base, preprocess.tokens[index]));
+        }
+        if (member_node != C_AST_NODE_INVALID)
+        {
+            static Arena* arena; if (!arena) { arena = arena_create((ArenaCreation){0}); }
+            string_print_error(S8(" TREE: {S8}"), c_ast_dump(arena, ast, preprocess, member_node));
+        }
+    }
+    string_print_error(S8("\n"));
+}
