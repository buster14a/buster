+BUSTER_GLOBAL_LOCAL u32 c_parse_specifier_node(CTypeParseMachine* machine, u32 token);
+BUSTER_GLOBAL_LOCAL bool census_decoration_spelling(String8 s)
+{
+    String8 words[] = {S8("__attribute__"), S8("__attribute"), S8("__declspec"), S8("asm"), S8("__asm"), S8("__asm__"), S8("__extension__"),
+                       S8("_Static_assert"), S8("static_assert"), S8("_Alignas"), S8("alignas"), S8("aligned"), S8("__aligned__"),
+                       S8("__aligned"), S8("vector_size"), S8("__vector_size__")};
+    bool found = false;
+    for (u32 i = 0; i < BUSTER_ARRAY_LENGTH(words); i += 1)
+    {
+        found |= string_equal(s, words[i]);
+    }
+    return found;
+}
