+BUSTER_C_INTERNAL u64 c_lower_census_now_ns(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (u64)ts.tv_sec * 1000000000ull + (u64)ts.tv_nsec;
+}
+BUSTER_C_INTERNAL FILE* c_lower_census_file(void)
+{
+    static FILE* file;
+    static bool opened;
+    if (!opened)
+    {
+        opened = true;
+        char const* path = getenv("BUSTER_LOWER_CENSUS_PATH");
+        file = path ? fopen(path, "a") : 0;
+    }
+    return file;
+}
