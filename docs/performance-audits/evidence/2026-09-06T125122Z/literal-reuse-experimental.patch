+// Exercise the three local aggregate paths that already decode a string
+// while checking its element type: braced arrays, bare array members, and
+// nested braced array subobjects. Exact-size arrays omit only the final NUL;
+// padded arrays retain embedded NULs and zero the remaining elements.
+static int check_braced_string_arrays(void)
+{
+    char exact[3] = {"a" "bc"};
+    char padded[6] = {"a\0" "b",};
+    test_char16 wide_exact[3] = {u"A" u"\U0001f642"};
+    test_char16 wide_padded[6] = {u"A\0" u"\U0001f642",};
+    int valid = exact[0] == 'a' && exact[1] == 'b' && exact[2] == 'c' &&
+                padded[0] == 'a' && padded[1] == 0 && padded[2] == 'b' && padded[3] == 0 && padded[4] == 0 && padded[5] == 0 &&
+                wide_exact[0] == 'A' && wide_exact[1] == 0xd83d && wide_exact[2] == 0xde42 &&
+                wide_padded[0] == 'A' && wide_padded[1] == 0 && wide_padded[2] == 0xd83d && wide_padded[3] == 0xde42 &&
+                wide_padded[4] == 0 && wide_padded[5] == 0;
+    return !valid;
+}
+
+struct LiteralMembers
+{
+    char exact[3];
+    char padded[6];
+    test_char16 wide_exact[3];
+    test_char16 wide_padded[6];
+};
+
+static int check_string_array_members(void)
+{
+    struct LiteralMembers value = {"a" "bc", "a\0" "b", u"A" u"\U0001f642", u"A\0" u"\U0001f642"};
+    int valid = value.exact[0] == 'a' && value.exact[1] == 'b' && value.exact[2] == 'c' &&
+                value.padded[0] == 'a' && value.padded[1] == 0 && value.padded[2] == 'b' && value.padded[3] == 0 &&
+                value.padded[4] == 0 && value.padded[5] == 0 &&
+                value.wide_exact[0] == 'A' && value.wide_exact[1] == 0xd83d && value.wide_exact[2] == 0xde42 &&
+                value.wide_padded[0] == 'A' && value.wide_padded[1] == 0 && value.wide_padded[2] == 0xd83d &&
+                value.wide_padded[3] == 0xde42 && value.wide_padded[4] == 0 && value.wide_padded[5] == 0;
+    return !valid;
+}
+
+struct NestedLiteralMembers
+{
+    struct LiteralMembers inner;
+    int following;
+};
+
+static int check_nested_string_array_members(void)
+{
+    struct NestedLiteralMembers value = {{{"a" "bc"}, {"a\0" "b",}, {u"A" u"\U0001f642"}, {u"A\0" u"\U0001f642",}}, 7};
+    int valid = value.inner.exact[0] == 'a' && value.inner.exact[1] == 'b' && value.inner.exact[2] == 'c' &&
+                value.inner.padded[0] == 'a' && value.inner.padded[1] == 0 && value.inner.padded[2] == 'b' && value.inner.padded[3] == 0 &&
+                value.inner.padded[4] == 0 && value.inner.padded[5] == 0 &&
+                value.inner.wide_exact[0] == 'A' && value.inner.wide_exact[1] == 0xd83d && value.inner.wide_exact[2] == 0xde42 &&
+                value.inner.wide_padded[0] == 'A' && value.inner.wide_padded[1] == 0 && value.inner.wide_padded[2] == 0xd83d &&
+                value.inner.wide_padded[3] == 0xde42 && value.inner.wide_padded[4] == 0 && value.inner.wide_padded[5] == 0 && value.following == 7;
+    return !valid;
+}
