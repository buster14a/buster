[
  {
    "name": "instructions",
    "command": [
      "perf",
      "stat",
      "-e",
      "instructions:u",
      "--",
      "build/Release/ide",
      "cc",
      "-Isrc",
      "-Ibuild/generated",
      "-DBUSTER_UNITY_BUILD=1",
      "-DBUSTER_INCLUDE_TESTS=0",
      "-g",
      "-v",
      "-fsource-metrics=build/round2-profile.metrics",
      "src/buster/apps/ide/ide.c",
      "-lm",
      "-o",
      "build/round2-profile"
    ],
    "exit_code": 0
