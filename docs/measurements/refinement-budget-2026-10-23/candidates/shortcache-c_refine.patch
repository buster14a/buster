+typedef struct RefineShortCache RefineShortCache;
+struct RefineShortCache
+{
+    uint64_t words[256] __attribute__((aligned(64)));
+    uint32_t ids[256] __attribute__((aligned(64)));
+};
+
+// Exact source words for short identifiers. Each gather is bounded by the source; its token tail is zeroed.
+// Non-identifiers and spellings that are too long or too near EOF return zero, which is never an identifier key.
+BUSTER_INLINE __m512i refine_short_words(const uint8_t* source, uint64_t length, __m256i starts, __m256i lengths, __mmask8 lanes)
+{
+    __m512i result = _mm512_setzero_si512();
+    if (length >= 8)
+    {
+        const __m512i wide_starts = _mm512_cvtepu32_epi64(starts);
+        const __mmask8 short_names = _mm256_mask_cmple_epu32_mask(lanes, lengths, _mm256_set1_epi32(8));
+        const __mmask8 readable = _mm512_mask_cmple_epu64_mask(short_names, wide_starts, _mm512_set1_epi64((long long)(length - 8)));
+        const __m512i bytes = _mm512_mask_i64gather_epi64(_mm512_setzero_si512(), readable, wide_starts, source, 1);
+        const __m256i shifts = _mm256_slli_epi32(_mm256_sub_epi32(_mm256_set1_epi32(8), lengths), 3);
+        result = _mm512_and_si512(bytes, _mm512_srlv_epi64(_mm512_set1_epi64(-1), _mm512_cvtepu32_epi64(shifts)));
+    }
+    return result;
+}
+
+BUSTER_INLINE __m256i refine_short_indices(__m512i words)
+{
+    return _mm512_cvtepi64_epi32(_mm512_srli_epi64(_mm512_mullo_epi64(words, _mm512_set1_epi64((long long)BUSTER_INTERN_SECRET0)), 56));
+}
+
+BUSTER_INLINE void refine_filter_names(const uint8_t* source, uint64_t length, RefineIdentifiers* identifiers, uint32_t* values, const RefineShortCache* cache)
+{
+    const uint32_t total = identifiers->count;
+    uint32_t remaining = 0;
+    for (uint32_t first = 0; first < total; first += 8)
+    {
+        const __mmask8 lanes = total - first >= 8 ? 0xFF : (__mmask8)_bzhi_u32(0xFF, total - first);
+        const __m256i starts = _mm256_loadu_si256((const __m256i*)(identifiers->starts + first));
+        const __m256i lengths = _mm256_loadu_si256((const __m256i*)(identifiers->lengths + first));
+        const __m256i positions = _mm256_loadu_si256((const __m256i*)(identifiers->positions + first));
+        const __m512i words = refine_short_words(source, length, starts, lengths, lanes);
+        const __m256i indices = refine_short_indices(words);
+        const __mmask8 short_names = _mm512_mask_cmpneq_epi64_mask(lanes, words, _mm512_setzero_si512());
+        const __m512i cached = _mm512_mask_i32gather_epi64(_mm512_setzero_si512(), short_names, indices, cache->words, 8);
+        const __mmask8 matches = _mm512_mask_cmpeq_epi64_mask(short_names, words, cached);
+        const __m256i ids = _mm256_mmask_i32gather_epi32(_mm256_setzero_si256(), matches, indices, cache->ids, 4);
+        const __mmask8 missing = _mm256_mask_cmpeq_epi32_mask(lanes, ids, _mm256_setzero_si256());
+        _mm256_mask_i32scatter_epi32(values, lanes & ~missing, positions, ids, 4);
+        _mm256_storeu_si256((__m256i*)(identifiers->starts + remaining), _mm256_maskz_compress_epi32(missing, starts));
+        _mm256_storeu_si256((__m256i*)(identifiers->lengths + remaining), _mm256_maskz_compress_epi32(missing, lengths));
+        _mm256_storeu_si256((__m256i*)(identifiers->positions + remaining), _mm256_maskz_compress_epi32(missing, positions));
+        _mm512_storeu_si512(identifiers->cache_words + remaining, _mm512_maskz_compress_epi64(missing, words));
+        remaining += (uint32_t)__builtin_popcount(missing);
+    }
+    identifiers->count = remaining;
+}
+
+// Keep one source/ID pair per cache slot. Conflict detection chooses the first lane of every duplicate group before
+// either scatter, so separate key and ID stores cannot pick different spellings for the same slot.
+BUSTER_INLINE void refine_update_short_cache(const RefineIdentifiers* identifiers, RefineShortCache* cache)
+{
+    for (uint32_t first = 0; first < identifiers->count; first += 8)
+    {
+        const __mmask8 lanes = identifiers->count - first >= 8 ? 0xFF : (__mmask8)_bzhi_u32(0xFF, identifiers->count - first);
+        const __m512i words = _mm512_loadu_si512(identifiers->cache_words + first);
+        const __m256i ids = _mm256_loadu_si256((const __m256i*)(identifiers->ids + first));
+        const __mmask8 short_names = _mm512_mask_cmpneq_epi64_mask(lanes, words, _mm512_setzero_si512());
+        const __m256i indices = _mm256_mask_mov_epi32(_mm256_setr_epi32(-1, -2, -3, -4, -5, -6, -7, -8), short_names, refine_short_indices(words));
+        const __mmask8 unique = _mm256_mask_cmpeq_epi32_mask(short_names, _mm256_conflict_epi32(indices), _mm256_setzero_si256());
+        _mm512_mask_i32scatter_epi64(cache->words, unique, indices, words, 8);
+        _mm256_mask_i32scatter_epi32(cache->ids, unique, indices, ids, 4);
+    }
+}
