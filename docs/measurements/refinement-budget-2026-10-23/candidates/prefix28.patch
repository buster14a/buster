+// intern_bucket_matches', from a compare without its mask. Compress the matching id dwords from the already loaded
+// bucket: the lowest lane is the first match's id, or zero when no prefix matches. This needs no dependent scalar
+// load, outcome branch or sentinel read on a miss.
+BUSTER_INLINE IdentId refine_probe(const uint8_t* bucket, __m256i key)
+{
+    const __m512i slots = _mm512_load_si512(bucket);
+    const uint32_t matches = (_mm512_cmpeq_epi32_mask(slots, intern_bucket_key(key)) + 0x0101) & 0x8080;
+    const __m512i ids = _mm512_maskz_compress_epi32((__mmask16)matches, slots);
+    return (IdentId)_mm_cvtsi128_si32(_mm512_castsi512_si128(ids));
