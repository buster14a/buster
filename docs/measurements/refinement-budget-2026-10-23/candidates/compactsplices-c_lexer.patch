+// Conservatively marks source-relative 64-byte regions that may contain a backslash. The caller clears the bitmap
+// once; overlapping vector attempts and scalar restarts only add bits, so an abandoned prefix cannot lose evidence.
+BUSTER_INLINE void c_tokenize_mark_regions(uint64_t* regions, uint64_t begin, uint64_t end)
+{
+    if (regions != 0 && begin < end)
+    {
+        const uint64_t first = begin / 64;
+        const uint64_t last = (end - 1) / 64;
+        for (uint64_t word = first / 64; word <= last / 64; word += 1)
+        {
+            const uint32_t low = word == first / 64 ? first % 64 : 0;
+            const uint32_t high = word == last / 64 ? last % 64 : 63;
+            regions[word] |= _bzhi_u64(~0ull, high + 1) & ~_bzhi_u64(~0ull, low);
+        }
+    }
+}
