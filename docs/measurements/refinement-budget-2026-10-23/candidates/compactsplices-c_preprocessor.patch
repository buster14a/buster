+#ifndef BUSTER_REFINE_SOURCE_CHUNK
+#define BUSTER_REFINE_SOURCE_CHUNK 65536
+#endif
+
+// The same preparation, consuming completed logical lines while their columns and source are still cached. The
+// unfinished line is lexed again in the next window. Mode splitting stays within that complete prefix. Only complete
+// refinement blocks are published until EOF, so previous ends and leading-space word boundaries remain intact.
+static PPPrepareStatus pp_prepare_chunks(const PPPrepare* prepare, InternTable* table, Arena* columns, Arena* arena, PPFileData* data, uint64_t* ticks,
+                                         uint64_t chunk_bytes)
+{
+    const uint64_t capacity = BUSTER_C_TOKENIZER_CAPACITY((uint64_t)data->length);
+    data->kinds = arena_push(&columns[0], capacity, 64);
+    data->starts = arena_push_array(&columns[1], capacity, sizeof(uint32_t), 64);
+    data->values = arena_push_array(&columns[2], capacity, sizeof(uint32_t), 64);
+    const bool pushed = data->kinds != 0 && data->starts != 0 && data->values != 0;
+    uint64_t tick = ticks != 0 ? __rdtsc() : 0;
+    Scratch scratch = scratch_begin(arena);
+    uint64_t* space = arena_push_array(scratch.arena, capacity / 64 + 2, sizeof(uint64_t), 64);
+    RefineProgress progress = {
+        .previous_ends = _mm512_setzero_si512(),
+        .backslash_chunks = arena_push_array(scratch.arena, ((uint64_t)data->length + 4095) / 4096 + 1, sizeof(uint64_t), 64),
+        .prefiltered = (prepare->refine_flags & (C_TOKENIZER_CPLUSPLUS | C_TOKENIZER_NO_DIGRAPHS | C_TOKENIZER_NO_LINE_COMMENTS |
+                                               C_TOKENIZER_TRIGRAPHS | C_TOKENIZER_NO_DOLLARS)) == 0,
+    };
+    bool refined = pushed && space != 0 && progress.backslash_chunks != 0;
+    if (refined && progress.prefiltered)
+    {
+        memset(progress.backslash_chunks, 0, (((uint64_t)data->length + 4095) / 4096 + 1) * sizeof(uint64_t));
+    }
+    PPPrepareStatus result = !pushed ? PP_PREPARE_NO_COLUMNS : PP_PREPARE_NO_MEMORY;
+    uint64_t at = 0;
+    uint64_t count = 0;
+    uint64_t completed = 0;
+    uint64_t window = chunk_bytes;
+    bool final = false;
+    if (ticks != 0)
+    {
+        ticks[PP_PHASE_REFINE] += __rdtsc() - tick;
+    }
+    while (refined && !final)
+    {
+        tick = ticks != 0 ? __rdtsc() : 0;
+        const uint64_t bytes = data->length - at < window ? data->length - at : window;
+        int64_t keep = refine_lex_prefix_with_regions(data->bytes, at + bytes, at, data->kinds + count, data->starts + count, data->values + count,
+                                                     prepare->refine_flags, progress.prefiltered ? progress.backslash_chunks : 0);
+        refined = keep >= 0;
+        final = at + bytes == data->length;
+        if (refined && !final)
+        {
+            const uint64_t lexed = (uint64_t)keep;
+            keep = 0;
+            for (uint64_t i = lexed; keep == 0 && i > 1; i -= 1)
+            {
+                if ((data->kinds[count + i - 1] & BUSTER_C_TOKEN_START_OF_LINE) != 0)
+                {
+                    keep = (int64_t)i - 1;
+                }
+            }
+        }
+        if (refined && (keep != 0 || final))
+        {
+            const uint64_t next = final ? data->length : data->starts[count + (uint64_t)keep];
+            keep = keep > 0 ? pp_lex_for_mode(prepare, data->bytes, data->length, data->kinds + count, data->starts + count, data->values + count,
+                                             (uint32_t)keep, true) : keep;
+            refined = keep >= 0;
+            if (refined && final && keep > 0 && pp_is_unterminated_comment(data->bytes, data->kinds[count + keep - 1], data->starts[count + keep - 1]))
+            {
+                const uint64_t last = count + (uint64_t)keep - 1;
+                data->unterminated_comment = data->starts[last] + 1;
+                data->unterminated_comment_starts_line = (data->kinds[last] & BUSTER_C_TOKEN_START_OF_LINE) != 0;
+                keep -= 1;
+            }
+            count += refined ? (uint64_t)keep : 0;
+            const uint64_t complete = final ? count : count / BUSTER_REFINE_BLOCK_TOKENS * BUSTER_REFINE_BLOCK_TOKENS;
+            if (ticks != 0)
+            {
+                const uint64_t now = __rdtsc();
+                ticks[PP_PHASE_LEX] += now - tick;
+                tick = now;
+            }
+            refined = refined && refine_blocks(table, data->bytes, data->length, data->kinds, data->starts, data->values, count, data->values, space,
+                                                prepare->refine_flags, completed, complete, &progress);
+            if (ticks != 0)
+            {
+                ticks[PP_PHASE_REFINE] += __rdtsc() - tick;
+            }
+            completed = complete;
+            at = next;
+            window = chunk_bytes;
+        }
+        else
+        {
+            window *= 2;
+            if (ticks != 0)
+            {
+                ticks[PP_PHASE_LEX] += __rdtsc() - tick;
+            }
+        }
+    }
+    tick = ticks != 0 ? __rdtsc() : 0;
+    if (refined)
+    {
+        data->token_count = (uint32_t)count;
+        const uint64_t kept = count + BUSTER_C_TOKENIZER_OUTPUT_SLACK;
+        arena_pop_to(&columns[0], (uint64_t)(data->kinds - columns[0].base) + kept);
+        arena_pop_to(&columns[1], (uint64_t)((uint8_t*)data->starts - columns[1].base) + kept * sizeof(uint32_t));
+        arena_pop_to(&columns[2], (uint64_t)((uint8_t*)data->values - columns[2].base) + kept * sizeof(uint32_t));
+        data->space = arena_push_array(&columns[0], count / 64 + 2, sizeof(uint64_t), 64);
+        refined = data->space != 0 && pp_prepare_raw_errors(prepare, arena, data);
+        if (refined)
+        {
+            memcpy(data->space, space, (count + 63) / 64 * sizeof(uint64_t));
+        }
+    }
+    scratch_end(scratch);
+    if (ticks != 0)
+    {
+        const uint64_t now = __rdtsc();
+        ticks[PP_PHASE_REFINE] += now - tick;
+        tick = now;
+    }
+    if (refined)
+    {
+        data->prepared = pp_directive_table(true, arena, data);
+        result = data->prepared ? PP_PREPARE_DONE : PP_PREPARE_NO_MEMORY;
+    }
+    if (ticks != 0)
+    {
+        ticks[PP_PHASE_DIRECTIVES] += __rdtsc() - tick;
+    }
+    return result;
+}
+
+static PPPrepareStatus pp_prepare_into(const PPPrepare* prepare, InternTable* table, Arena* columns, Arena* arena, PPFileData* data, uint64_t* ticks)
+{
+    const bool chunked = prepare->vectorized && !prepare->dollar_punctuation && data->length >= 2 * BUSTER_REFINE_SOURCE_CHUNK &&
+                         data->length <= UINT32_MAX - BUSTER_C_TOKENIZER_OUTPUT_SLACK &&
+                         (prepare->refine_flags & (C_TOKENIZER_CPLUSPLUS | C_TOKENIZER_TRIGRAPHS | C_TOKENIZER_NO_DOLLARS)) == 0;
+    return chunked ? pp_prepare_chunks(prepare, table, columns, arena, data, ticks, BUSTER_REFINE_SOURCE_CHUNK)
+                   : pp_prepare_into_whole(prepare, table, columns, arena, data, ticks);
+}
