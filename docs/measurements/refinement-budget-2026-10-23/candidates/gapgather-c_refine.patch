+// State carried across completed blocks. The previous ends survive the in-place values, and scanned source chunks
+// stay available for the first gap of the next block. Calls end on block boundaries except for the file's final call.
+typedef struct RefineProgress RefineProgress;
+struct RefineProgress
+{
+    __m512i previous_ends;
+    uint64_t* backslash_chunks;
+    uint64_t scanned;
+};
