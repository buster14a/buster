+// Existing lexer range kernels retain absolute offsets. `begin` starts a logical line; scalar-only modes use the
+// caller's complete-file fallback. Like c_tokenize, a vector decline restarts the preceding line with the scalar lexer.
+static __attribute__((unused)) int64_t refine_lex_prefix(const uint8_t* source, uint64_t end, uint64_t begin, uint8_t* kinds, uint32_t* starts, uint32_t* ends, uint32_t flags)
+{
+    if (begin == 0 && end >= 3 && source[0] == 0xEF && source[1] == 0xBB && source[2] == 0xBF)
+    {
+        begin = 3;
+    }
+    uint64_t count = 0;
+    int64_t result = begin == end ? 0 : -1;
+    while (result < 0)
+    {
+        uint64_t written;
+        uint64_t restart;
+        uint64_t scalar_until;
+        const int64_t vectorized = tokenize_with_flags(flags, source, end, begin, kinds + count, starts + count, ends + count, &written, &restart, &scalar_until);
+        if (vectorized >= 0)
+        {
+            result = (int64_t)count + vectorized;
+        }
+        else
+        {
+            count = c_tokenize_scalar_range(source, end, restart, true, scalar_until, kinds, starts, ends, count + written, flags, &begin);
+            if (begin >= end)
+            {
+                result = (int64_t)count;
+            }
+        }
+    }
+    return result;
