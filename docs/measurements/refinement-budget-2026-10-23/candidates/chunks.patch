+    RefineProgress progress = {
+        .previous_ends = _mm512_setzero_si512(),
+        .backslash_chunks = arena_push_array(scratch.arena, (length + 4095) / 4096 + 1, sizeof(uint64_t), 64),
+    };
+    const bool result = refine_range_with(table, source, length, kinds, starts, ends, count, values, space, flags, trigraphs, batch, fused, 0, count, &progress);
@@ -957,0 +986,8 @@
+static __attribute__((unused)) bool refine_blocks(InternTable* table, const uint8_t* source, uint64_t length, const uint8_t* kinds, const uint32_t* starts, const uint32_t* ends,
+                                                uint64_t count, uint32_t* values, uint64_t* space, uint32_t flags, uint64_t begin, uint64_t end, RefineProgress* progress)
+{
