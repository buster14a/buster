+// Main's full hosted coverage is independent of paths and of other main runs (#1271). This checks the workflow's
+// actual trigger, concurrency and hosted-job contract; the evidence glue's fixtures separately prove that every push
+// emits scope=full and hosted=run, including native reuse and either nightly mode. Like the other workflow policies,
+// this recognizes the repository's explicit layout, not arbitrary YAML or an Actions expression interpreter.
+static bool changes_main_policy(Text workflow)
+{
+    bool in_push = false;
+    bool main = false;
+    bool filtered = false;
+    bool group = false;
+    bool cancellation = false;
+    bool tests = false;
+    bool sanitizers = false;
+    bool extra_rows = false;
+    bool test_fail_fast = false;
+    bool fuzz = false;
+    bool fuzz_revision = false;
+    uint32_t job = 0;
+    size_t offset = 0;
+    Text line;
+    while (text_next_line(workflow, &offset, &line))
+    {
+        const size_t indent = changes_indent(line);
+        Text value = changes_skip(line, "");
+        if (value.length != 0 && value.data[0] != '#' && indent <= 2)
+        {
+            in_push = text_equal_c(line, "  push:");
+        }
+        main |= in_push && text_equal_c(line, "    branches: [main]");
+        filtered |= in_push && (text_starts_with(value, "paths:") || text_starts_with(value, "paths-ignore:") || text_starts_with(value, "branches-ignore:"));
+        group |= text_equal_c(line, "  group: buster-fast-9700x-${{ github.event.pull_request.number || (github.event_name == 'push' && github.run_id) || (github.event_name == 'schedule' && 'schedule') || github.ref }}");
+        cancellation |= text_equal_c(line, "  cancel-in-progress: ${{ github.event_name == 'pull_request' }}");
+        if (text_equal_c(line, "  test:"))
+        {
+            job = 1;
+        }
+        else if (text_equal_c(line, "  fuzz:"))
+        {
+            job = 2;
+        }
+        else if (value.length != 0 && value.data[0] != '#' && indent <= 2)
+        {
+            job = 0;
+        }
+        tests |= job == 1 && text_equal_c(line, "    if: ${{ !cancelled() && github.repository_id == '1421805693' && needs.evidence.result == 'success' && needs.evidence.outputs.hosted == 'run' && (needs.changes.result == 'skipped' || (needs.changes.result == 'success' && needs.changes.outputs.code != 'false')) && (github.event_name != 'pull_request' || (needs.agent-guide-size.result == 'success' && needs.dco-hooks.result == 'success')) }}");
+        sanitizers |= job == 1 && text_equal_c(line, "        sanitizer: ${{ fromJSON((github.event_name == 'pull_request' || needs.evidence.outputs.scope == 'plain') && '[\"none\"]' || '[\"none\", \"address\", \"undefined\", \"thread\", \"memory\"]') }}");
+        // changes_shard_policy also verifies the complete O1 entries, architectures and shard counts.
+        extra_rows |= job == 1 && text_starts_with(line, "          ${{ fromJSON((github.event_name == 'pull_request' || needs.evidence.outputs.scope == 'plain') && '[]' || '[{");
+        test_fail_fast |= job == 1 && text_equal_c(line, "      fail-fast: ${{ github.event_name == 'pull_request' }}");
+        fuzz |= job == 2 && text_equal_c(line, "    if: ${{ !cancelled() && github.repository_id == '1421805693' && github.event_name != 'pull_request' && needs.evidence.result == 'success' && needs.evidence.outputs.hosted == 'run' && needs.evidence.outputs.scope == 'full' && (needs.changes.result == 'skipped' || (needs.changes.result == 'success' && needs.changes.outputs.code != 'false')) }}");
+        fuzz_revision |= job == 2 && text_equal_c(line, "          ref: ${{ github.sha }}");
+    }
+    return main && !filtered && group && cancellation && tests && sanitizers && extra_rows && test_fail_fast && fuzz && fuzz_revision;
+}
+
+static void changes_test_main_policy(ChangesTest* test, Text workflow)
+{
+    changes_expect(test, changes_main_policy(workflow), "main policy: every push keeps a full hosted run of its own revision", (Text){ 0 });
+    static const struct
+    {
+        const char* before;
+        const char* after;
+    } mutants[] = {
+        { "    branches: [main]\n", "    branches: [main]\n    paths-ignore: ['docs/**', '**.md']\n" },
+        { "    branches: [main]\n", "    branches: [main]\n    paths: ['src/**']\n" },
+        { "    branches: [main]\n", "    branches: [other]\n" },
+        { "(github.event_name == 'push' && github.run_id) || ", "" },
+        { "(github.event_name == 'push' && github.run_id)", "(github.event_name == 'push' && github.ref)" },
+        { "  cancel-in-progress: ${{ github.event_name == 'pull_request' }}", "  cancel-in-progress: true" },
+        { "'[\"none\", \"address\", \"undefined\", \"thread\", \"memory\"]'", "'[\"none\", \"address\", \"undefined\", \"thread\"]'" },
+        { "'[\"none\", \"address\", \"undefined\", \"thread\", \"memory\"]'", "'[\"none\"]'" },
+        { "          ${{ fromJSON((github.event_name == 'pull_request' || needs.evidence.outputs.scope == 'plain') && '[]'", "          ${{ fromJSON((github.event_name == 'pull_request' || github.event_name == 'push' || needs.evidence.outputs.scope == 'plain') && '[]'" },
+        { "      fail-fast: ${{ github.event_name == 'pull_request' }}", "      fail-fast: true" },
+        { "needs.evidence.outputs.hosted == 'run' && (needs.changes.result", "github.event_name == 'pull_request' && (needs.changes.result" },
+        { "needs.evidence.outputs.scope == 'full' && (needs.changes.result", "needs.evidence.outputs.scope == 'plain' && (needs.changes.result" },
+    };
+    const char* original = text_terminated(workflow);
+    for (uint32_t i = 0; i < sizeof(mutants) / sizeof(mutants[0]); i += 1)
+    {
+        const char* found = strstr(original, mutants[i].before);
+        Text changed = workflow;
+        if (found != NULL)
+        {
+            const size_t prefix = (size_t)(found - original);
+            const size_t suffix = prefix + strlen(mutants[i].before);
+            changed = text_concat(text_concat((Text){ .data = workflow.data, .length = prefix }, text_c(mutants[i].after)),
+                                  (Text){ .data = workflow.data + suffix, .length = workflow.length - suffix });
+        }
+        changes_expect(test, found != NULL && !changes_main_policy(changed), "main policy rejects lost or reduced post-merge coverage", text_c(mutants[i].before));
+    }
+    const char* job = strstr(original, "\n  fuzz:\n");
+    const char* revision = "          ref: ${{ github.sha }}";
+    const char* found = job != NULL ? strstr(job, revision) : NULL;
+    Text changed = workflow;
+    if (found != NULL)
+    {
+        const size_t prefix = (size_t)(found - original);
+        const size_t suffix = prefix + strlen(revision);
+        changed = text_concat(text_concat((Text){ .data = workflow.data, .length = prefix }, text_c("          ref: main")),
+                              (Text){ .data = workflow.data + suffix, .length = workflow.length - suffix });
+    }
+    changes_expect(test, found != NULL && !changes_main_policy(changed), "main policy rejects fuzzing a later main tip", (Text){ 0 });
+}
