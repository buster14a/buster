     String8 nested_prefix = S8("static int identity(int value)"
diff --git a/tests/basic_c_qualified_compound.c b/tests/basic_c_qualified_compound.c
new file mode 100644
index 0000000..a119ce0
--- /dev/null
+++ b/tests/basic_c_qualified_compound.c
@@ -0,0 +1,12 @@
+int update(volatile int* value)
+{
+    *value += 3;
+    return *value;
+}
+
+int main(void)
+{
+    volatile int value = 4;
+    int result = update(&value);
+    return result != 7 || value != 7;
+}
