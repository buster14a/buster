*.c     text eol=lf
*.h     text eol=lf
*.cpp   text eol=lf
*.hpp   text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.bat    text eol=lf
*.cmake text eol=lf
*.md    text eol=lf
*.bbb   text eol=lf

# Binary files - never touch
*.png   binary
*.jpg   binary
*.zip   binary
*.exe   binary

# The audit index takes a one-line insert per audit, always at the top, from
# branches that are open at the same time. Union merge keeps both lines instead
# of conflicting; the audits themselves are one file each and never collide.
PERFORMANCE_AUDITS.md merge=union
