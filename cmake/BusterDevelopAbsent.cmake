#
# The Develop configuration's stand-ins for the benchmark units it leaves out (docs/commands/build.md, "Develop";
# BusterSettings.cmake's BUSTER_DEVELOP_ON_DEMAND):
# cmake -DOUTPUT=OBJECT -DSOURCES=UNIT.c;... -DCLANG=CLANG -DFLAGS=FLAG;... -P BusterDevelopAbsent.cmake
#
# Every entry point a left-out unit defines for main.c, `int run_NAME(int argc, char** argv)` at the start of a line,
# gets a definition that says on standard error which configurations have its command, and fails: the executable then
# links, and a benchmark command run on it names its remedy rather than failing to link. A unit with no such entry fails
# the step, as does any other definition main.c takes from one, which the link then reports as undefined: such a unit
# serves more than benchmarks and stays in Develop (test-floors-input's floors_benchmark.c does).

cmake_minimum_required(VERSION 3.25)
foreach(name OUTPUT SOURCES CLANG FLAGS)
    if(NOT DEFINED ${name})
        message(FATAL_ERROR "BusterDevelopAbsent.cmake: ${name} is required")
    endif()
endforeach()

set(text "// Generated by cmake/BusterDevelopAbsent.cmake: the Develop configuration's stand-ins for the benchmark units it\n")
string(APPEND text "// leaves out (docs/commands/build.md, \"Develop\").\n\n#include <stdio.h>\n\n")
string(APPEND text "static int buster_develop_absent(const char* unit)\n{\n")
string(APPEND text "    fprintf(stderr, \"buster: this command is in the Release and Debug configurations' executables; Develop's leaves %s out (docs/commands/build.md, \\\"Develop\\\"): build Release with ./build.sh\\n\", unit);\n")
string(APPEND text "    return 1;\n}\n")
set(entries "")
foreach(source IN LISTS SOURCES)
    get_filename_component(unit "${source}" NAME)
    file(STRINGS "${source}" lines REGEX "^int run_[a-z0-9_]+\\(int argc, char\\*\\* argv\\)$")
    if(NOT lines)
        message(FATAL_ERROR "BusterDevelopAbsent.cmake: ${unit} defines no `int run_NAME(int argc, char** argv)` entry")
    endif()
    list(REMOVE_DUPLICATES lines)
    foreach(line IN LISTS lines)
        string(REGEX REPLACE "^int (run_[a-z0-9_]+)\\(.*$" "\\1" entry "${line}")
        if(entry IN_LIST entries)
            message(FATAL_ERROR "BusterDevelopAbsent.cmake: two left-out units define ${entry}")
        endif()
        list(APPEND entries "${entry}")
        string(APPEND text "\nint ${entry}(int argc, char** argv);\nint ${entry}(int argc, char** argv)\n{\n")
        string(APPEND text "    (void)argc;\n    (void)argv;\n    return buster_develop_absent(\"${unit}\");\n}\n")
    endforeach()
endforeach()

set(source "${OUTPUT}.c")
get_filename_component(directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
file(WRITE "${source}.partial" "${text}")
file(RENAME "${source}.partial" "${source}")
execute_process(COMMAND "${CLANG}" ${FLAGS} -c "${source}" -o "${OUTPUT}.partial" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    file(REMOVE "${OUTPUT}.partial")
    message(FATAL_ERROR "BusterDevelopAbsent.cmake: couldn't compile ${source}")
endif()
file(RENAME "${OUTPUT}.partial" "${OUTPUT}")
