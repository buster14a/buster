{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Skill",
      "mcp__github",
      "mcp__claude-code-remote",
      "Bash(gh api -X PUT repos/buster14a/buster/pulls/*/ccr/auto_merge -f merge_method=merge)",
      "Bash(git push origin HEAD:*)",
      "Bash(git -C * push origin HEAD:*)",
      "Bash(tailscale ssh david@benchpress:*)",
      "Bash(tailscale status:*)",
      "Bash(tailscaled --tun=userspace-networking:*)",
      "Bash(nohup tailscaled --tun=userspace-networking:*)",
      "Bash(tailscale up:*)",
      "Bash(tailscale --socket=/tmp/claude-0/ts/sock up:*)",
      "Bash(tailscale --socket=/tmp/claude-0/ts/sock status:*)",
      "Bash(tailscale --socket=/tmp/claude-0/ts/sock ssh david@benchpress:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/join-tailnet.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
