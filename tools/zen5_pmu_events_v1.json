          "semantics": "Any data-cache fill from every defined source."
        },
        {
          "key": "fills_local_l2",
          "selector": "cpu/event=0x44,umask=0x01,name=fills_local_l2/u",
          "output_names": ["fills_local_l2", "fills_local_l2:u"],
          "perf_type": 4,
          "event_code_hex": "0x44",
          "umask_hex": "0x01",
          "config_hex": "0x144",
          "scope": "user",
          "required": true,
          "source_path": "tools/perf/pmu-events/arch/x86/amdzen5/load-store.json",
          "source_event_name": "ls_any_fills_from_sys.local_l2",
          "semantics": "Any data-cache fill from the local L2."
        },
        {
          "key": "fills_dram_io_all",
          "selector": "cpu/event=0x44,umask=0x48,name=fills_dram_io_all/u",
          "output_names": ["fills_dram_io_all", "fills_dram_io_all:u"],
          "perf_type": 4,
          "event_code_hex": "0x44",
          "umask_hex": "0x48",
          "config_hex": "0x4844",
          "scope": "user",
          "required": true,
          "source_path": "tools/perf/pmu-events/arch/x86/amdzen5/load-store.json",
          "source_event_name": "ls_any_fills_from_sys.dram_io_all",
          "semantics": "Any data-cache fill from DRAM or MMIO in any NUMA node."
        }
      ]
    },
    {
      "id": "data-tlb",
      "description": "Zen 5 L1 data-TLB misses and the subset that requests page-table walks.",
      "events": [
        {
          "key": "instructions",
          "selector": "instructions:u",
          "output_names": ["instructions", "instructions:u"],
          "perf_type": 0,
          "config_hex": "0x1",
          "scope": "user",
          "required": true,
          "source_path": "include/uapi/linux/perf_event.h",
          "source_event_name": "PERF_COUNT_HW_INSTRUCTIONS",
          "semantics": "Retired-instruction denominator for this diagnostic replay."
