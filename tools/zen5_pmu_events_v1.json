        {
          "key": "l1_dtlb_miss_l2_miss",
          "selector": "cpu/event=0x45,umask=0xf0,name=l1_dtlb_miss_l2_miss/u",
          "output_names": ["l1_dtlb_miss_l2_miss", "l1_dtlb_miss_l2_miss:u"],
          "perf_type": 4,
          "event_code_hex": "0x45",
          "umask_hex": "0xf0",
          "config_hex": "0xf045",
          "scope": "user",
          "required": true,
          "source_path": "tools/perf/pmu-events/arch/x86/amdzen5/load-store.json",
