        {
          "key": "l1_dtlb_miss_all",
          "selector": "cpu/event=0x45,umask=0xff,name=l1_dtlb_miss_all/u",
          "output_names": ["l1_dtlb_miss_all", "l1_dtlb_miss_all:u"],
          "perf_type": 4,
          "event_code_hex": "0x45",
          "umask_hex": "0xff",
          "config_hex": "0xff45",
          "scope": "user",
          "required": true,
          "source_path": "tools/perf/pmu-events/arch/x86/amdzen5/load-store.json",
          "source_event_name": "ls_l1_d_tlb_miss.all",
