{
    OS_PROCESS_SPAWN_TEST_FILE_ACTIONS_INIT,
    OS_PROCESS_SPAWN_TEST_ATTRIBUTES_INIT,
    OS_PROCESS_SPAWN_TEST_PIPE,
    OS_PROCESS_SPAWN_TEST_PIPE_CONFIGURATION,
    OS_PROCESS_SPAWN_TEST_FILE_ACTION,
    OS_PROCESS_SPAWN_TEST_ATTRIBUTE,
    OS_PROCESS_SPAWN_TEST_HANDLE_DUPLICATION,
    OS_PROCESS_SPAWN_TEST_HANDLE_LIST,
    OS_PROCESS_SPAWN_TEST_SPAWN,
    OS_PROCESS_SPAWN_TEST_OPERATION_COUNT,
} OsProcessSpawnTestOperation;

BUSTER_F_DECL void os_process_spawn_test_fail_on_call(OsProcessSpawnTestOperation operation, u64 call_index);
BUSTER_F_DECL bool os_process_spawn_test_end(void);
BUSTER_F_DECL u64 os_process_spawn_test_resource_count(void);
#endif

'''
text = replace_once(text, marker, insert + marker, path)
write(path, text)

# A Windows environment block is always double-NUL terminated, including empty.
path = "src/buster/lib/string.c"
text = read(path)
text = replace_once(
    text,
    "WindowsStringList windows_environment_from_keys_and_values(Arena* arena, SliceString8 keys, SliceString8 values)\n{\n",
    "WindowsStringList windows_environment_from_keys_and_values(Arena* arena, SliceString8 keys, SliceString8 values)\n{\n    BUSTER_VALIDATE(keys.length == values.length);\n",
    path,
)
text = replace_once(
    text,
    "    *arena_allocate(arena, char16, 1) = 0;\n\n    return result;\n}\n\nSliceString8 slice_string_from_posix_string_list",
    "    if (!keys.length)\n    {\n        *arena_allocate(arena, char16, 1) = 0;\n    }\n    *arena_allocate(arena, char16, 1) = 0;\n\n    return result;\n}\n\nSliceString8 slice_string_from_posix_string_list",
    path,
)
text = replace_once(
    text,
    "    *arena_allocate(arena, char16, 1) = 0;\n    return result;\n}\n\nchar** slice_string8_to_null_terminated_array_char",
    "    if (!environment.length)\n    {\n        *arena_allocate(arena, char16, 1) = 0;\n    }\n    *arena_allocate(arena, char16, 1) = 0;\n    return result;\n}\n\nchar** slice_string8_to_null_terminated_array_char",
    path,
)
write(path, text)

# Every existing caller that explicitly inherits the process environment also
# states the legacy PATH-search policy. Exact paths bypass lookup in the runtime.
for source in list((ROOT / "src").rglob("*.c")) + list((ROOT / "tools").rglob("*.c")):
    source_text = source.read_text(encoding="utf-8")
    updated = source_text.replace(".use_process_environment = 1", ".use_process_environment = 1, .search_path = 1")
    updated = updated.replace(".use_process_environment = true", ".use_process_environment = true, .search_path = true")
    if updated != source_text:
        source.write_text(updated, encoding="utf-8")

# Replace the process boundary as one transaction.
path = "src/buster/lib/os.c"
text = read(path)
spawn_implementation = read("tools/issue84_spawn_impl.txt")
text = replace_between(text, "ProcessSpawnResult os_process_spawn(", "// Captured pipe output", spawn_implementation, path)
write(path, text)

# Test-only entry probe reaches the process boundary before the test suite.
path = "src/buster/apps/ide/ide.c"
text = read(path)
text = replace_once(text, "#include <buster/lib/arena.h>\n", "#include <buster/lib/arena.h>\n#include <buster/lib/os.h>\n#include <buster/lib/system_headers.h>\n", path)
text = replace_once(text, "ProcessResult entry_point(void)\n{\n", r'''#if BUSTER_INCLUDE_TESTS
BUSTER_GLOBAL_LOCAL ProcessResult compiler_process_spawn_probe(String8 mode)
{
    bool success = false;
    if (string_equal(mode, S8("descriptor")))
    {
        String8 value = os_get_environment_variable(S8("BUSTER_OS_SPAWN_PROBE_VALUE"));
        IntegerParsingU64 parsed = string8_parse_u64_decimal(value);
        bool valid = parsed.status == INTEGER_PARSING_SUCCESS && parsed.length == value.length;
        if (valid)
        {
#if BUSTER_WINDOWS
            DWORD flags = 0;
            SetLastError(ERROR_SUCCESS);
            BOOL present = GetHandleInformation((HANDLE)(uintptr_t)parsed.value, &flags);
            success = !present && GetLastError() == ERROR_INVALID_HANDLE;
#else
            errno = 0;
            success = fcntl((int)parsed.value, F_GETFD) < 0 && errno == EBADF;
#endif
        }
    }
    else if (string_equal(mode, S8("environment")))
    {
        success = string_equal(os_get_environment_variable(S8("BUSTER_OS_SPAWN_EXPECTED")), S8("present")) &&
                  string_equal(os_get_environment_variable(S8("PATH")), S8("hostile-path")) &&
                  !os_get_environment_variable(S8("BUSTER_OS_SPAWN_FORBIDDEN")).length &&
                  !os_get_environment_variable(S8("HOME")).length && !os_get_environment_variable(S8("USERPROFILE")).length;
    }
    else if (string_equal(mode, S8("closed-stdio")))
    {
#if BUSTER_WINDOWS
        DWORD identifiers[] = {STD_INPUT_HANDLE, STD_OUTPUT_HANDLE, STD_ERROR_HANDLE};
        HANDLE closed[BUSTER_ARRAY_LENGTH(identifiers)] = {0};
        u32 closed_count = 0;
