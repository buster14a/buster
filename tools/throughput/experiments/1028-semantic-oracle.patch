+// DIAGNOSTIC PATCH (#1028 semantic-reuse boundary experiment). Never part of
+// a production build.
+#include <stdio.h>
+#include <stdlib.h>
+BUSTER_GLOBAL_LOCAL FILE* c_ir_trace_file(void)
+{
+    static FILE* file;
+    static bool resolved;
+    if (!resolved)
+    {
+        resolved = true;
+        char const* path = getenv("BUSTER_SEMANTIC_TRACE");
+        if (path && *path) file = fopen(path, "a");
+        if (file) setvbuf(file, 0, _IOLBF, 1u << 16);
+    }
+    return file;
+}
+
+BUSTER_GLOBAL_LOCAL void c_ir_trace_type_signature(FILE* file, IrProgram* program, IrTypeId type)
+{
+    u32 depth = 0;
+    IrType* record = ir_type_from_id(&program->types, type);
+    while (record && depth < 16)
+    {
+        fprintf(file, "%s%u", depth ? ">" : "", (u32)record->kind);
+        if (record->kind == IR_TYPE_INTEGER || record->kind == IR_TYPE_FLOAT) fprintf(file, ":%u%s", record->bit_width, record->is_signed ? "s" : "u");
+        if (record->is_volatile) fprintf(file, "v");
+        if (record->is_atomic) fprintf(file, "a");
+        if (record->kind == IR_TYPE_POINTER || record->kind == IR_TYPE_ARRAY || record->kind == IR_TYPE_VECTOR)
+        {
+            if (record->kind != IR_TYPE_POINTER) fprintf(file, "[%llu]", (unsigned long long)record->element_count);
+            record = ir_type_from_id(&program->types, record->element_type);
+        }
+        else if (record->kind == IR_TYPE_STRUCT || record->kind == IR_TYPE_UNION || record->kind == IR_TYPE_ENUM || record->kind == IR_TYPE_FUNCTION)
+        {
+            IrTypeId base = record->id;
+            u32 hops = 0;
+            IrType* walk = record;
+            while (walk && walk->unqualified_type.value != IR_ID_UNDERLYING_INVALID && walk->unqualified_type.value != walk->id.value && hops < 8)
+            {
+                base = walk->unqualified_type;
+                walk = ir_type_from_id(&program->types, base);
+                hops += 1;
+            }
+            fprintf(file, "#%u", base.value);
+            record = 0;
+        }
+        else
+        {
+            record = 0;
+        }
+        depth += 1;
+    }
+    if (type.value == IR_ID_UNDERLYING_INVALID) fprintf(file, "-");
+}
