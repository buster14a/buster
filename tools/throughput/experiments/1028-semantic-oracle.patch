+// DIAGNOSTIC PATCH (#1028 semantic-reuse boundary experiment): trace every
+// root expression-type query and recompute each cache hit with publication
+// bypassed. Never part of a production build.
+#include <stdio.h>
+#include <stdlib.h>
+BUSTER_GLOBAL_LOCAL FILE* c_semantic_trace_file(void)
+{
+    static FILE* file;
+    static bool resolved;
+    if (!resolved)
+    {
+        resolved = true;
+        char const* path = getenv("BUSTER_SEMANTIC_TRACE");
+        if (path && *path) file = fopen(path, "a");
+        if (file) setvbuf(file, 0, _IOLBF, 1u << 16);
+    }
+    return file;
+}
+
+// Compact structural signature: kind and qualifiers per level, element chain
+// through pointers/arrays; aggregates/enums/functions by their unqualified
+// record id so a fresh copy of the same record compares equal.
+BUSTER_GLOBAL_LOCAL void c_semantic_trace_type_signature(FILE* file, CParseResult* result, CTypeId type)
+{
+    u32 depth = 0;
+    while (type.value < result->type_count && depth < 16)
+    {
+        CType* record = result->types + type.value;
+        fprintf(file, "%s%u%s%s%s%s", depth ? ">" : "", (u32)record->kind, record->is_const ? "c" : "", record->is_volatile ? "v" : "",
+                record->is_restrict ? "r" : "", record->is_atomic ? "a" : "");
+        if (record->kind == C_TYPE_POINTER || record->kind == C_TYPE_ARRAY || record->kind == C_TYPE_VECTOR)
+        {
+            if (record->kind == C_TYPE_ARRAY) fprintf(file, "[b%u]", record->array_bound);
+            type = record->element_type;
+        }
+        else if (record->kind == C_TYPE_STRUCT || record->kind == C_TYPE_UNION || record->kind == C_TYPE_ENUM || record->kind == C_TYPE_FUNCTION)
+        {
+            CTypeId base = type;
+            u32 hops = 0;
+            while (base.value < result->type_count && result->types[base.value].has_unqualified_type && hops < 8)
+            {
+                base = result->types[base.value].unqualified_type;
+                hops += 1;
+            }
+            fprintf(file, "#%u", base.value);
+            type = C_TYPE_ID_INVALID;
+        }
+        else
+        {
+            type = C_TYPE_ID_INVALID;
+        }
+        depth += 1;
+    }
+    if (type.value != C_ID_UNDERLYING_INVALID) fprintf(file, ">?");
+}
+
+BUSTER_GLOBAL_LOCAL bool c_parse_expression_type_query_compute(CTypeParseMachine* machine, Arena* arena, CPreprocessResult preprocess,
+                                                               CParseResult* result, CScopeId scope, u32 start, u32 end, CTypeId* type_out,
+                                                               u32* diagnostics_added)
+{
+    u32 frame_start = machine->frame_count;
+    CParseResult checkpoint = *result;
+    u32 mutation_mark = machine->mutation_count;
+    machine->mutation_type_limit = checkpoint.type_count;
+    machine->result_valid = false;
+    bool pushed = c_type_parse_frame_push(machine, (CTypeParseFrame){
+                                              .result = result,
+                                              .preprocess = preprocess,
+                                              .arena = arena,
+                                              .scope = scope,
+                                              .start = start,
+                                              .end = end,
+                                              .kind = C_TYPE_PARSE_FRAME_SIZEOF,
+                                          });
+    if (pushed)
+    {
+        c_type_parse_machine_run(machine, frame_start);
+    }
+    bool valid = c_type_parse_root_finish(machine, result, checkpoint, mutation_mark,
+                                          machine->failed && start < preprocess.token_count ? c_preprocess_token_location(&preprocess, preprocess.tokens[start]) : (CSourceLocation){0});
+    if (valid)
+    {
+        *type_out = machine->result_type;
+    }
+    *diagnostics_added = result->diagnostic_count - checkpoint.diagnostic_count;
+    return valid;
+}
