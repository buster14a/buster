[Unit]
Description=Buster benchmark authenticated service
Documentation=file:/usr/local/share/doc/buster/bench_service/README.md
Requires=buster-bench.slice
After=local-fs.target
ConditionPathIsDirectory=/opt/buster-bench/installed
ConditionPathIsDirectory=/var/lib/buster-bench/workspaces
ConditionPathExists=/etc/buster-bench/installed.sha256
ConditionPathExists=/etc/buster-bench/lease.identity
ConditionPathExists=/etc/buster-bench/host.identity

[Service]
Type=exec
User=buster-bench
Group=buster-bench
SupplementaryGroups=buster-bench-candidate
Slice=buster-bench.slice
UMask=0077
RuntimeDirectory=buster-bench
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
WorkingDirectory=/
Restart=no
# '+' keeps the trusted preflight privileged so it can verify root-only sudoers
# and policy identities before the unprivileged long-lived process is entered.
ExecStartPre=+/usr/local/libexec/buster-bench-verify preflight
ExecStart=/usr/local/libexec/buster-bench-service serve /var/lib/buster-bench/queue /run/buster-bench/control.sock /opt/buster-bench/installed /var/lib/buster-bench/workspaces /var/lib/buster-bench/lease/host.lock 2
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectHome=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ReadOnlyPaths=/opt/buster-bench/installed
ReadOnlyPaths=/etc/buster-bench
ReadWritePaths=/var/lib/buster-bench
ReadWritePaths=/run/buster-bench
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Installation never enables or starts this unit. The operator must run the
# live verifier successfully before repository dispatch can be enabled.
