[Unit]
Description=Buster benchmark authenticated service (repository reference only)
Documentation=file:/usr/local/share/doc/buster/bench_service/README.md
Requires=buster-bench.slice
Requires=buster-bench-systemd-broker.socket
After=local-fs.target
After=buster-bench-systemd-broker.socket
ConditionPathIsDirectory=/opt/buster-bench/installed
ConditionPathIsDirectory=/var/lib/buster-bench/workspaces

[Service]
Type=exec
User=buster-bench
Group=buster-bench
UMask=0077
RuntimeDirectory=buster-bench
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
WorkingDirectory=/
Restart=no
ExecStart=/usr/local/libexec/buster-bench-service serve /var/lib/buster-bench/queue /run/buster-bench/control.sock /opt/buster-bench/installed /var/lib/buster-bench/workspaces /var/lib/buster-bench/lease/host.lock 2
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectHome=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ReadOnlyPaths=/opt/buster-bench/installed
ReadWritePaths=/var/lib/buster-bench
ReadWritePaths=/run/buster-bench
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# This unit is intentionally not enabled by repository automation. The
# operator must complete VALIDATE_BUSTER_V1.md before starting it. RuntimeDirectory
# owns only the endpoint lifetime, never the durable queue, results or lease.
# A service stop/restart is not evidence that sibling job/stage units are absent.
