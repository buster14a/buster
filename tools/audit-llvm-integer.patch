diff --git a/tests/basic_c_llvm_integer_constants.c b/tests/basic_c_llvm_integer_constants.c
new file mode 100644
index 0000000..d34ba61
--- /dev/null
+++ b/tests/basic_c_llvm_integer_constants.c
@@ -0,0 +1,79 @@
+/* Compile this side to Buster bitcode; compile the independent caller with
+   Clang so a corrupted expected constant cannot hide a corrupted result. */
+_Bool llvm_integer_true = 1;
+unsigned char llvm_integer_u8 = 128;
+unsigned short llvm_integer_u16 = 32768;
+unsigned int llvm_integer_u32 = 2147483648U;
+unsigned long long llvm_integer_u64 = 9223372036854775808ULL;
+
+int llvm_integer_not(int value)
+{
+    return !value;
+}
+
+unsigned char llvm_integer_return_u8(void)
+{
+    return 128;
+}
+
+unsigned short llvm_integer_return_u16(void)
+{
+    return 32768;
+}
+
+unsigned int llvm_integer_return_u32(void)
+{
+    return 2147483648U;
+}
+
+unsigned long long llvm_integer_return_u64(void)
+{
+    return 9223372036854775808ULL;
+}
+
+signed char llvm_integer_return_s8(void)
+{
+    return -128;
+}
+
+short llvm_integer_return_s16(void)
+{
+    return -32768;
+}
+
+int llvm_integer_return_s32(void)
+{
+    return -2147483647 - 1;
+}
+
+long long llvm_integer_return_s64(void)
+{
+    return -9223372036854775807LL - 1;
+}
+
+unsigned int llvm_integer_adjacent(unsigned int index)
+{
+    unsigned int result;
+    if (index == 0)
+    {
+        result = 2147483647U;
+    }
+    else if (index == 1)
+    {
+        result = 2147483648U;
+    }
+    else if (index == 2)
+    {
+        result = 2147483649U;
+    }
+    else
+    {
+        result = 4294967295U;
+    }
+    return result;
+}
+
+#if defined(__SIZEOF_INT128__)
+/* Each word of WIDE_INTEGER uses the 64-bit signed-rotation contract. */
+unsigned __int128 llvm_integer_u128 = ((unsigned __int128)9223372036854775808ULL << 64) | 9223372036854775808ULL;
+#endif
diff --git a/tests/basic_c_llvm_integer_constants_caller.c b/tests/basic_c_llvm_integer_constants_caller.c
new file mode 100644
index 0000000..053da8a
--- /dev/null
+++ b/tests/basic_c_llvm_integer_constants_caller.c
@@ -0,0 +1,48 @@
+extern _Bool llvm_integer_true;
+extern unsigned char llvm_integer_u8;
+extern unsigned short llvm_integer_u16;
+extern unsigned int llvm_integer_u32;
+extern unsigned long long llvm_integer_u64;
+extern int llvm_integer_not(int value);
+extern unsigned char llvm_integer_return_u8(void);
+extern unsigned short llvm_integer_return_u16(void);
+extern unsigned int llvm_integer_return_u32(void);
+extern unsigned long long llvm_integer_return_u64(void);
+extern signed char llvm_integer_return_s8(void);
+extern short llvm_integer_return_s16(void);
+extern int llvm_integer_return_s32(void);
+extern long long llvm_integer_return_s64(void);
+extern unsigned int llvm_integer_adjacent(unsigned int index);
+#if defined(__SIZEOF_INT128__)
+extern unsigned __int128 llvm_integer_u128;
+#endif
+
+int main(void)
+{
+    int result = 0;
+    result |= llvm_integer_true != 1;
+    result |= llvm_integer_u8 != 128;
+    result |= llvm_integer_u16 != 32768;
+    result |= llvm_integer_u32 != 2147483648U;
+    result |= llvm_integer_u64 != 9223372036854775808ULL;
+    result |= llvm_integer_return_u8() != 128;
+    result |= llvm_integer_return_u16() != 32768;
+    result |= llvm_integer_return_u32() != 2147483648U;
+    result |= llvm_integer_return_u64() != 9223372036854775808ULL;
+    result |= llvm_integer_return_s8() != -128;
+    result |= llvm_integer_return_s16() != -32768;
+    result |= llvm_integer_return_s32() != (-2147483647 - 1);
+    result |= llvm_integer_return_s64() != (-9223372036854775807LL - 1);
+    result |= llvm_integer_not(0) != 1;
+    result |= llvm_integer_not(1) != 0;
+    result |= llvm_integer_not(-1) != 0;
+    result |= llvm_integer_adjacent(0) != 2147483647U;
+    result |= llvm_integer_adjacent(1) != 2147483648U;
+    result |= llvm_integer_adjacent(2) != 2147483649U;
+    result |= llvm_integer_adjacent(3) != 4294967295U;
+#if defined(__SIZEOF_INT128__)
+    result |= (unsigned long long)llvm_integer_u128 != 9223372036854775808ULL;
+    result |= (unsigned long long)(llvm_integer_u128 >> 64) != 9223372036854775808ULL;
+#endif
+    return result;
+}
