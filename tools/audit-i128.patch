diff --git a/tests/basic_c_i128_division.c b/tests/basic_c_i128_division.c
new file mode 100644
index 0000000..ae227c9
--- /dev/null
+++ b/tests/basic_c_i128_division.c
@@ -0,0 +1,57 @@
+/* Signed division must restore quotient and remainder signs independently.
+   Recomposition alone is not an oracle: q=0, r=dividend also recomposes. */
+typedef unsigned __int128 DivisionUnsigned;
+typedef __int128 DivisionSigned;
+
+static volatile unsigned long long division_seed = 1;
+
+int main(void)
+{
+    DivisionUnsigned one = division_seed;
+    DivisionSigned high = (DivisionSigned)(one << 64);
+    DivisionSigned quarter = (DivisionSigned)(one << 126);
+    DivisionSigned maximum = (quarter - 1) + quarter;
+    struct DivisionCase
+    {
+        DivisionSigned dividend;
+        DivisionSigned divisor;
+        DivisionSigned quotient;
+        DivisionSigned remainder;
+    };
+    struct DivisionCase cases[] = {
+        {100, 7, 14, 2},
+        {98, 7, 14, 0},
+        {3, 7, 0, 3},
+        {0, 7, 0, 0},
+        {100, 1, 100, 0},
+        {(high + 13) * 7 + 5, 7, high + 13, 5},
+        {((DivisionSigned)(one << 35)) * (high + 3) + 7, high + 3, (DivisionSigned)(one << 35), 7},
+        {maximum, 2, quarter - 1, 1},
+        {maximum, quarter, 1, quarter - 1},
+    };
+    int result = 0;
+    for (unsigned int index = 0; index < sizeof(cases) / sizeof(cases[0]); index += 1)
+    {
+        for (unsigned int negative_dividend = 0; negative_dividend < 2; negative_dividend += 1)
+        {
+            for (unsigned int negative_divisor = 0; negative_divisor < 2; negative_divisor += 1)
+            {
+                DivisionSigned dividend = negative_dividend ? -cases[index].dividend : cases[index].dividend;
+                DivisionSigned divisor = negative_divisor ? -cases[index].divisor : cases[index].divisor;
+                DivisionSigned expected_quotient = negative_dividend != negative_divisor ? -cases[index].quotient : cases[index].quotient;
+                DivisionSigned expected_remainder = negative_dividend ? -cases[index].remainder : cases[index].remainder;
+                DivisionSigned quotient = dividend / divisor;
+                DivisionSigned remainder = dividend % divisor;
+                result |= quotient != expected_quotient || remainder != expected_remainder;
+            }
+        }
+    }
+    /* Form MIN without overflowing a signed shift or negating MIN itself.
+       MIN/-1 and division by zero are deliberately absent: they are undefined. */
+    DivisionSigned minimum = -quarter - quarter;
+    DivisionSigned signed_one = (DivisionSigned)one;
+    result |= minimum / signed_one != minimum || minimum % signed_one != 0;
+    result |= minimum / (signed_one + signed_one) != -quarter || minimum % (signed_one + signed_one) != 0;
+    result |= minimum / (-signed_one - signed_one) != quarter || minimum % (-signed_one - signed_one) != 0;
+    return result;
+}
