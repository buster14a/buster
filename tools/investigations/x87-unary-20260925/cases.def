/* C17, x86-64 SysV LP64. Expected values are exact integers in binary80. */
CASE(paren_uint, -(1u), 4294967295.0L, 0)
CASE(nested_uint, -((1u)), 4294967295.0L, 0)
CASE(minus_plus_uint, -+1u, 4294967295.0L, 0)
CASE(paren_plus_uint, -(+1u), 4294967295.0L, 0)
CASE(double_minus_uint, -(-1u), 1.0L, 0)
CASE(paren_uint_max, -(0xffffffffu), 1.0L, 0)
CASE(paren_uint_high, -(0x80000000u), 2147483648.0L, 0)
CASE(paren_ulong, -(1ul), 18446744073709551615.0L, 0)
CASE(paren_ullong, -(1ull), 18446744073709551615.0L, 0)
CASE(mixed_sum, 0.0L + -(1u), 4294967295.0L, 0)
CASE(mixed_product, 1.0L * -(1u), 4294967295.0L, 0)
CASE(macro_uint, NEGATE(1u), 4294967295.0L, 0)
CASE(integer_zero, -(0), 0.0L, 0)
CASE(unsigned_zero, -(0u), 0.0L, 0)
CASE(direct_uint_control, -1u, 4294967295.0L, 1)
CASE(outer_parens_control, (-1u), 4294967295.0L, 1)
CASE(plus_minus_control, +-1u, 4294967295.0L, 1)
CASE(direct_ullong_control, -1ull, 18446744073709551615.0L, 1)
CASE(signed_control, -(1), -1.0L, 1)
CASE(real_control, -(1.0L), -1.0L, 1)
CASE(real_unsigned_conversion_control, -(1u * 1.0L), -1.0L, 1)
CASE(real_negative_zero_control, -(0.0L), -0.0L, 1)
CASE(direct_integer_zero_control, -0, 0.0L, 1)
