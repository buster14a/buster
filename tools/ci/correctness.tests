# The correctness inventory, which every correctness build runs through its executable's parallel runner
# (docs/commands/parallel.md): CI's jobs and CTest's `correctness` test (CMakeLists.txt). The runner gives each command
# BUSTER_COMPILER, its own executable's path, so that the commands test the configuration that runs them; run one by
# hand with BUSTER_COMPILER set to a build's executable, such as build/compiler.

== Check unity fixture ownership without rebuilding
# The existing compiler's dependency graph keeps private fixtures, arbitrary nested includes and test headers in
# one main unit. Exact shared exceptions and shared-root structure may not grow silently; stale/incomplete records
# fail closed. Internally guarded roots also retain their complete standalone preprocessing.
# It reads the build's tree, not the executable. A hosted shard that runs its row's shared compiler (BUSTER_PRODUCT,
# docs/ci.md's "Shared row products") has no such tree: the job that built the product ran this heading on its tree
# before packing it (tools/ci/hosted-product.sh ownership), and the product records that it passed.
if [ -z "${BUSTER_PRODUCT:-}" ]; then
cc -std=c17 -O2 -Wall -Wextra -Werror -o build/build-regression tools/ci/build_regression.c
build/build-regression --ownership-only "$BUSTER_COMPILER"
else
test "$(head -n 1 "$BUSTER_PRODUCT/provenance/ownership")" = passed
printf 'SKIP: unity fixture ownership, which passed on the shared product'"'"'s build tree (%s)\n' "$BUSTER_PRODUCT"
exit 77
fi
== Test the foreign inputs [8 CPUs]
# Generated programs' objects split into archives and compiled C and C++ cases, resolved by both paths on 1,
# 2, 3 and 8 lanes; --cross-check also links each with GNU ld and lld and compares the members they load, the
# winners, the COMDAT groups and -y's lines with the resolution's.
"$BUSTER_COMPILER" test-foreign --cross-check
== Check the no-recursion rule on the call graph [8 CPUs]
# Captures the translation units' LLVM IR in the build's tree (its call-graph-ir target) and fails on any cycle not in
# the allowlist; the check runs BUSTER_COMPILER.
"$BUSTER_COMPILER" test-call-graph
./build.sh check-call-graph
== Test the calling convention [8 CPUs]
# --cross-check also links random signatures between our side, encoded and written as objects, and C that
# clang and GCC compile, at 16-, 32- and 64-byte vectors, and checks every argument, result and va_arg both
# ways; in its compiled runs (#137), our side is C that this compiler compiles, by both paths into one object.
"$BUSTER_COMPILER" test-calling-convention --cross-check
== Test the static executables with libc [8 CPUs]
# Each program bound against the system's static runtime and written as a static executable by 1, 2, 3 and 8
# lanes and by the writer's exact twins must be the same file, run as cc -static's link of the same object
# does, and with --cross-check as lld's does, with as many IRELATIVE relocations and the same TLS segment's
# alignment and init and fini arrays' sizes.
"$BUSTER_COMPILER" test-static --cross-check
== Test the functions' lanes [8 CPUs]
# #151: generated programs and failing ones emitted on 1, 2, 3 and 8 lanes and with a slow lane, each one
# lane's object or failure, with -g's rows and unwind tables and without; and the driver's objects and
# executables by --lanes and by default, by both paths, each one lane's. #153: each compiled again with its
# identifiers' ids in another order (--id-order, 153 by default), in-process and by the driver, the same.
"$BUSTER_COMPILER" test-check-lanes
== Test the dynamic PIEs [8 CPUs]
# --cross-check also links each bound program's objects with ld.lld as a PIE and compares the two files'
# dynamic symbols and relocations.
"$BUSTER_COMPILER" test-dynamic --cross-check
== Test the foreign linker against lld and mold [8 CPUs]
# Original C and C++ programs, each compiled by gcc and by clang, linked from one command line by
# link-foreign, lld and mold: their runs, symbols and sizes, dynamic sections, versions and relocations must
# agree but for each reference linker's documented choices.
"$BUSTER_COMPILER" test-foreign-corpus
== Test the per-file jobs [8 CPUs]
# The cache filled on 1, 2, 3 and 8 lanes must give the same tables, records and translation units' streams,
# -E text and diagnostics, and each unit the spellings it gives alone; and again with the shared table's ids
# in another order (#153's --id-order, 153 by default), the same records, -E text, diagnostics and
# locations, each id spelled the same. Its forms with paths (the translation units, src flat) do the same.
"$BUSTER_COMPILER" test-files
== Test the per-file jobs on the frozen C library corpus, flat [8 CPUs]
unset CPATH C_INCLUDE_PATH
"$BUSTER_COMPILER" test-files --flat $BUSTER_CORPUS/libc
== Test the runtime snapshot [8 CPUs]
"$BUSTER_COMPILER" test-snapshot
== Test the floors' shared-libc input
# Discovery and ELF-envelope validation, with real and original synthetic inputs; no timings or CPU pinning.
# The same entry runs in the plain static builds and the sanitizer builds' dynamic hosts.
"$BUSTER_COMPILER" test-floors-input
== Test the per-file jobs on the frozen sqlite3.c [8 CPUs]
unset CPATH C_INCLUDE_PATH
"$BUSTER_COMPILER" test-files $BUSTER_CORPUS/sqlite/sqlite3.c
== Test SQLite's shell by both tiers against clang's [4 CPUs]
# #146: the frozen corpus's sqlite3.c and shell.c built into the sqlite3 shell by Tier 0, --tier1 and clang -O0; SQLite's
# own CLI tests (test/shellB.test's .sql files, from the tree fetch-sqlite.sh fetches) must pass, and they and
# tests/sqlite's scripts must print clang's shell's output, byte for byte (docs/commands/c-testsuite.md). The harness's
# own cases: the work directory is relative and the scripts' and tests' paths have blanks (the shells run in directories
# of their own); a script that prints nothing passes (its run proves itself by a sentinel line, not its output); and a
# dangling link, a directory, a FIFO without a writer (within a minute, not hung) or an unreadable file named as a script
# fails the command before any build.
unset CPATH C_INCLUDE_PATH
directory=$(mktemp -d "build/test sqlite.XXXXXX")
trap 'rm -rf "$directory"' EXIT
mkdir "$directory/sqlite scripts" "$directory/sqlite tests" "$directory/bad scripts" "$directory/bad scripts/directory.sql"
cp tests/sqlite/*.sql "$directory/sqlite scripts/"
printf 'CREATE TABLE t(x);\n' > "$directory/sqlite scripts/silent.sql"
cp build/sqlite/test/*.sql "$directory/sqlite tests/"
cp tests/sqlite/core.sql "$directory/bad scripts/"
ln -s missing "$directory/bad scripts/dangling.sql"
# A file it may not read, but for root, who may read any file.
cp tests/sqlite/core.sql "$directory/bad scripts/unreadable.sql"
chmod 000 "$directory/bad scripts/unreadable.sql"
# A FIFO without a writer, which a blocking open would wait on forever.
mkfifo "$directory/bad scripts/hang.sql"
expected=4
if [ "$(id -u)" = 0 ]; then expected=3; fi
if timeout 60 "$BUSTER_COMPILER" test-sqlite --clang clang --sqlite "$BUSTER_CORPUS/sqlite" --tests "$directory/sqlite tests" --scripts "$directory/bad scripts" \
    --directory "$directory" > "$directory/bad.txt" 2>&1; then exit 1; fi
test "$(grep -c ': not a readable regular file (FAILED)$' "$directory/bad.txt")" -eq "$expected"
grep -q 'bad scripts/dangling.sql: not a' "$directory/bad.txt"
grep -q 'bad scripts/directory.sql: not a' "$directory/bad.txt"
grep -q 'bad scripts/hang.sql: not a' "$directory/bad.txt"
if grep -q "shell by\|shell: built" "$directory/bad.txt"; then exit 1; fi
"$BUSTER_COMPILER" test-sqlite --clang clang --sqlite "$BUSTER_CORPUS/sqlite" --tests "$directory/sqlite tests" --scripts "$directory/sqlite scripts" \
    --directory "$directory" > "$directory/good.txt" 2>&1 || { cat "$directory/good.txt"; exit 1; }
cat "$directory/good.txt"
grep -q "^test-sqlite: silent.sql: every build's output is clang -O0's$" "$directory/good.txt"
grep -q "^test-sqlite: 9 of SQLite's CLI tests and 5 scripts: every build agrees with clang -O0's$" "$directory/good.txt"
== Test SQLite's Tcl suite's pinned subset through testfixture by both tiers against clang's [4 CPUs]
# #146: testfixture (tclsqlite.c, SQLite's test sources and the amalgamation its Makefile generates, which must be the
# frozen corpus's sqlite3.c) built by SQLite's configure and Makefile with clang -O0, Tier 0 and --tier1, against Tcl 8.6's
# distribution package (hosted: Ubuntu 26.04's tcl8.6-dev, pinned below); each runs tests/sqlite/testfixture-subset.txt's
# scripts of SQLite's `full` permutation, which clang's must all pass, and the other builds' every script must have
# clang's state, errors and test count (docs/commands/c-testsuite.md). The full permutation runs on main, in a job of its
# own (hosted-correctness.yml's `sqlite-full`). A host without Tcl's development package skips it, but a hosted runner.
unset CPATH C_INCLUDE_PATH
tcl=$(bash tools/ci/tcl-config.sh) || exit $?
"$BUSTER_COMPILER" test-sqlite-testfixture --clang clang --tree build/sqlite --tcl "$tcl" --amalgamation "$BUSTER_CORPUS/sqlite/sqlite3.c" \
    --subset tests/sqlite/testfixture-subset.txt --jobs "${CORES:-4}" --directory build
== Test the direct path's executables [8 CPUs]
"$BUSTER_COMPILER" test-executable
== Test the lanes [8 CPUs]
"$BUSTER_COMPILER" test-lanes
== Test the per-file jobs on the repository's sources, flat [8 CPUs]
"$BUSTER_COMPILER" test-files --flat src
== Test the link representation [8 CPUs]
"$BUSTER_COMPILER" test-link
== Compile c-testsuite's programs as the units of one command [8 CPUs]
# #152: every program at once with -c by 8 lanes, each one's object and diagnostics its own alone, in order.
# The heading is the parallel runner's scheduling budget, not an affinity mask: the command's children each take up
# to eight lanes, so declaring two CPUs let the runner co-schedule other two-CPU commands on the same cores.
"$BUSTER_COMPILER" test-check-units --corpus build/c-testsuite/tests/single-exec
== Test the driver's commands of several source files [8 CPUs]
# #152: generated programs of several units, and one of synth's shape, compiled by one command into executables
# that run as clang's builds of them do and define what cc's links of their units' objects do, at every lane count
# and by both paths; each unit's -c object its own alone; diagnostics in the command line's order; refusals; and
# lanes that don't start.
# #153: changed IDs in the poisoned/debug output comparisons, canonical fatal-prefix diagnostics at 1/2/3/8 lanes
# through both paths, and the sequential multi-input -E command's text and diagnostics against standalone bytes.
# Its children take up to eight lanes; the heading is the parallel runner's scheduling budget, not an affinity mask.
"$BUSTER_COMPILER" test-check-units
== Test mixed-tier single- and multi-file determinism [8 CPUs]
# #149/#153: compare each host path with its own one-lane bytes at every available count through eight.
# Require actual command-team and mixed-tier receipts, fresh outputs, usable -c objects, and independently checked
# execution, with changed IDs for both single- and multi-file commands. Multi-file repeats also poison the arenas.
# The two units-test headings above are eight-CPU budgets for the same reason: their children take up to
# eight lanes, so the runner must not co-schedule other two-CPU commands on the same cores.
mapfile -d '' -t sanitizer_flags < <(./build.sh print-sanitizer-flags)
mapfile -d '' -t host_flags < <(./build.sh print-host-flags)
test "${#host_flags[@]}" -gt 0
clang -std=c17 -O2 "${host_flags[@]}" -Wall -Wextra -Werror -fno-strict-aliasing "${sanitizer_flags[@]}" tests/driver/multicore.c -o build/test-driver-multicore
./build/test-driver-multicore "$BUSTER_COMPILER"
== Test c-testsuite's programs end to end [4 CPUs]
# #145: each program checked, lowered, compiled by Tier 0 and linked by the direct path, by the vector paths and
# the scalar twins, these with the identifiers' ids in another order (#153's --id-order), into the same bytes,
# then run; --cross-check also writes each as an object that cc links, whose functions and objects must be
# clang -O0 -c's (#129). The declared subset must pass. A worker per CPU of the heading's.
"$BUSTER_COMPILER" test-c-testsuite --cross-check --clang clang --jobs "$BUSTER_PARALLEL_CPUS" --subset tests/c-testsuite/subset.txt build/c-testsuite
== Test c-testsuite's programs with Tier 1's code [4 CPUs]
# #140 and #138: each program compiled by the driver's --tier1 (each function Tier 1's pipeline takes by Tier 1, the
# others by Tier 0, with both tiers' unwind tables, #177), by both paths, whose allocators assign registers differently,
# both programs run; the scalar path's executable the same bytes with the ids in source order and in another (#153).
# The declared subset must pass.
"$BUSTER_COMPILER" test-c-testsuite --tier1 --jobs "$BUSTER_PARALLEL_CPUS" --subset tests/c-testsuite/subset.txt build/c-testsuite
== Reject unfinished SSA-source runs and preserve normal program exits [4 CPUs]
# #925: real C preparation/promotions and all three child processes, no expected-output sidecar. Normal return and
# native exits (including255) pass; alarms, interpreter limits and real record-write failure fail, with every process
# status and record checked.
"$BUSTER_COMPILER" test-ssa-source --typed --tier1 --self-test
== Promote and run random C programs of structured and unstructured control flow [4 CPUs]
# #134: programs whose functions have gotos into and out of loops, switches whose cases fall through and breaks and
# continues at depth, each built by clang -O0 and run for its output, then checked as c-testsuite's programs are.
# --tier1 also compiles both host paths strictly, without Tier 0 fallback, and compares their native runs with the
# interpreted forms. Native builds and runs follow the interpreter children, within this group's CPU grant.
"$BUSTER_COMPILER" test-ssa-source --typed --tier1 --generate 48 --clang clang
== Promote random C programs with their blocks' lifetimes, as --tier1 does [3 CPUs]
# #141: the same programs' generator at a seed of its own, the IR with its blocks' lifetime markers, at whose starts
# promotion makes a block's locals undefined; each block's own locals are assigned and read under one condition, and
# all three forms must give clang -O0's output.
"$BUSTER_COMPILER" test-ssa-source --tier1 --generate 24 --seed 141 --lifetimes --clang clang
== Test the preprocessor on the repository's translation units against clang [2 CPUs]
# --clang also preprocesses each unit with clang -E, with clang's predefines for its options, and compares the
# tokens. -target and its triple (clang's default) go to both. clang's runs go to the job's clang server where it built
# one (#2071), compared as the cases' parts' are, but the guard counts' (-print-stats, LLVM's counters), as children.
mapfile -d '' -t host_flags < <(./build.sh print-host-flags)
test "${#host_flags[@]}" -gt 0
"$BUSTER_COMPILER" test-preprocessor --clang -target x86_64-pc-linux-gnu "${host_flags[@]}" -Isrc -fwrapv -funsigned-char -DBUSTER_COMPLETE_DRIVER=1 src/buster/compiler/main.c src/buster/compiler/*_benchmark.c ${BUSTER_CLANG_SERVER:+--clang-server "$BUSTER_CLANG_SERVER"} ${BUSTER_DRIVER_DIFFERENTIAL:+--differential}
== Compare c-testsuite's typed streams, SSA and strict Tier 1 programs [4 CPUs]
# #134: each function -c compiles lowered with every local in memory and promoted by both of ssa_ir.c's paths, with
# ssa.c's verifier on each promotion and no trivial phi left, then each program run by the shared IR's interpreter
# in its three forms at once (all locals in memory, and each path's SSA), which must agree with each other and with
# the program's expected output. Both strict Tier 1 builds must then give that same status and output; unsupported
# compilation, a timeout or abnormal native execution fails rather than falling back to Tier 0 or leaving a test out.
"$BUSTER_COMPILER" test-ssa-source --typed --tier1 $(sed -n 's|^\([0-9][0-9]*\)$|build/c-testsuite/tests/single-exec/\1.c|p' tests/c-testsuite/subset.txt)
== Run typed aggregate, variadic and indirect source calls and linked units [4 CPUs]
# Preserve the interpreter's 520-byte aggregate; Tier 1 admits stack arguments up to 512 bytes, so compare a 64-long
# variant strictly through both native paths as well (docs/tier1-selection.md, "By-value aggregates").
"$BUSTER_COMPILER" test-ssa-source --typed tests/interpreter/source.c
"$BUSTER_COMPILER" test-ssa-source --typed --tier1 -DBUSTER_INTERPRETER_LARGE_WORDS=64 tests/interpreter/source.c
"$BUSTER_COMPILER" interpret-c tests/interpreter/units-main.c tests/interpreter/units-library.c > build/interpreter-units.out && printf 'typed units: 1\n' | cmp - build/interpreter-units.out
== Test native fixed-frame CFI and generated GDB/perf consumers [2 CPUs]
"$BUSTER_COMPILER" test-unwind --cross-check
== Test the preprocessor's cases against clang (part 1 of 4)
# --clang also preprocesses each case with clang -E and compares the tokens. --part deals the checks (the cases,
# the header sets, the predefines' option sets in four slices, the fuzz batch's own checks and each of its modes)
# to 4 parts by their weights (pp_test_sections), one CPU each, which the runner packs beside the other commands:
# whole, on 2 CPUs, the command took 295 s on a hosted runner and 44 s on the 9700X, the list's longest. The four
# parts together run each check once. A part's fuzz workers and clang processes run on its CPU (--jobs, and
# test_process_cpus from BUSTER_PARALLEL_CPUS); the fuzz cases don't depend on --jobs. The oracle cache's clang runs, the
# fuzz batch's and the checks' own (the history's and system warnings' diagnostics, the directives' commands) go to the
# job's clang server where it built one (#2071), and with BUSTER_DRIVER_DIFFERENTIAL each also runs as before: a
# difference fails the command. A forked part stops its own server as it ends, so that its CPU time is the command's.
# The release fixture's wrapper script and the predefines' shell commands, through other programs, the location option's
# nested runs of the compiler and the guard counts (-print-stats, LLVM's counters) run their clang as before.
"$BUSTER_COMPILER" test-preprocessor --clang --jobs "$BUSTER_PARALLEL_CPUS" --part 1/4 ${BUSTER_CLANG_SERVER:+--clang-server "$BUSTER_CLANG_SERVER"} ${BUSTER_DRIVER_DIFFERENTIAL:+--differential}
# --part's refusals, each before any check runs: no value, a part outside 1 to N, N past the checks' 128, other than
# digits on either side of one '/', and a second --part.
if "$BUSTER_COMPILER" test-preprocessor --part; then exit 1; fi
for part in '' 4 0/4 5/4 1/0 1/129 x/4 1/ /4 1/4/4 '1/ 4' 1/+4 +1/4 ' 1/4'; do
    if "$BUSTER_COMPILER" test-preprocessor --part "$part"; then exit 1; fi
done
if "$BUSTER_COMPILER" test-preprocessor --part 1/4 --part 2/4; then exit 1; fi
== Test the preprocessor's cases against clang (part 2 of 4)
"$BUSTER_COMPILER" test-preprocessor --clang --jobs "$BUSTER_PARALLEL_CPUS" --part 2/4 ${BUSTER_CLANG_SERVER:+--clang-server "$BUSTER_CLANG_SERVER"} ${BUSTER_DRIVER_DIFFERENTIAL:+--differential}
== Test the preprocessor's cases against clang (part 3 of 4)
"$BUSTER_COMPILER" test-preprocessor --clang --jobs "$BUSTER_PARALLEL_CPUS" --part 3/4 ${BUSTER_CLANG_SERVER:+--clang-server "$BUSTER_CLANG_SERVER"} ${BUSTER_DRIVER_DIFFERENTIAL:+--differential}
== Test the preprocessor's cases against clang (part 4 of 4)
"$BUSTER_COMPILER" test-preprocessor --clang --jobs "$BUSTER_PARALLEL_CPUS" --part 4/4 ${BUSTER_CLANG_SERVER:+--clang-server "$BUSTER_CLANG_SERVER"} ${BUSTER_DRIVER_DIFFERENTIAL:+--differential}
== Test the parser's snippets against clang
# The snippets, each also checked against clang, the generated inputs and the driver's checks. The second command
# checks the file alone (--files-only): the checks without input are the first's, with the same language and seed.
# clang's runs go to the job's clang server where it built one (#2071), compared as the preprocessor's parts are.
"$BUSTER_COMPILER" test-parser --clang ${BUSTER_CLANG_SERVER:+--clang-server "$BUSTER_CLANG_SERVER"} ${BUSTER_DRIVER_DIFFERENTIAL:+--differential}
"$BUSTER_COMPILER" test-parser --clang --files-only tests/parser-handoff/pragma-heavy.c ${BUSTER_CLANG_SERVER:+--clang-server "$BUSTER_CLANG_SERVER"} ${BUSTER_DRIVER_DIFFERENTIAL:+--differential}
== Test the semantic driver's diagnostics and emission against clang (part 1 of 4)
# --part deals the driver test's checks (sections, and the cases of its two long sweeps) in turn to 4 parts, one CPU
# each, which the runner packs beside the other commands: alone, the command took 197 s on a hosted runner and 48 s
# on the 9700X, the list's longest. The four parts together run each check once. Buster's runs are this process's,
# and the oracle clang's go to the job's clang server where it built one (#2071); with BUSTER_DRIVER_DIFFERENTIAL, each
# also runs as a child, and a difference fails the command.
"$BUSTER_COMPILER" test-checker-driver --executable "$BUSTER_COMPILER" --part 1/4 --in-process ${BUSTER_CLANG_SERVER:+--clang-server "$BUSTER_CLANG_SERVER"} ${BUSTER_DRIVER_DIFFERENTIAL:+--differential}
== Test the semantic driver's diagnostics and emission against clang (part 2 of 4)
"$BUSTER_COMPILER" test-checker-driver --executable "$BUSTER_COMPILER" --part 2/4 --in-process ${BUSTER_CLANG_SERVER:+--clang-server "$BUSTER_CLANG_SERVER"} ${BUSTER_DRIVER_DIFFERENTIAL:+--differential}
== Test the semantic driver's diagnostics and emission against clang (part 3 of 4)
"$BUSTER_COMPILER" test-checker-driver --executable "$BUSTER_COMPILER" --part 3/4 --in-process ${BUSTER_CLANG_SERVER:+--clang-server "$BUSTER_CLANG_SERVER"} ${BUSTER_DRIVER_DIFFERENTIAL:+--differential}
== Test the semantic driver's diagnostics and emission against clang (part 4 of 4)
"$BUSTER_COMPILER" test-checker-driver --executable "$BUSTER_COMPILER" --part 4/4 --in-process ${BUSTER_CLANG_SERVER:+--clang-server "$BUSTER_CLANG_SERVER"} ${BUSTER_DRIVER_DIFFERENTIAL:+--differential}
== Check narrow-unsigned sign comparisons and admitted deferred diagnostics [2 CPUs]
# This focused route compiles two bodies, requests two lanes and asserts the reported deferred admission.
"$BUSTER_COMPILER" test-checker-driver --executable "$BUSTER_COMPILER" --sign-compare-only --in-process ${BUSTER_CLANG_SERVER:+--clang-server "$BUSTER_CLANG_SERVER"} ${BUSTER_DRIVER_DIFFERENTIAL:+--differential}
== Test the per-file jobs on the frozen musl units
# #262's corpora: musl's 1,355 units with its build's options, the cache filled on 1, 2, 3 and 8 lanes and with
# the ids in another order, as test-files does for the repository's units.
unset CPATH C_INCLUDE_PATH
corpus=$BUSTER_CORPUS
musl="$corpus/libc/musl"
"$BUSTER_COMPILER" test-files -std=c99 -nostdinc -ffreestanding -D_XOPEN_SOURCE=700 -I "$musl/arch/x86_64" -I "$musl/arch/generic" \
  -I "$corpus/musl-generated/obj/src/internal" -I "$musl/src/include" -I "$musl/src/internal" -I "$corpus/musl-generated/obj/include" -I "$musl/include" \
  "$musl"/src/*/*.c "$musl"/src/*/x86_64/*.c
== Test the per-file jobs on the repository's translation units
# The predefines follow the options as clang's do (c_predefines.c).
mapfile -d '' -t host_flags < <(./build.sh print-host-flags)
test "${#host_flags[@]}" -gt 0
"$BUSTER_COMPILER" test-files -target x86_64-pc-linux-gnu "${host_flags[@]}" -Isrc -fwrapv -funsigned-char -DBUSTER_COMPLETE_DRIVER=1 src/buster/compiler/main.c src/buster/compiler/*_benchmark.c
== Test the parser on the repository's translation units
# Both paths, which must agree kernel by kernel, and accept each unit the build compiles (build.sh print-sources),
# but main_unit_*.c, which are main.c again with another BUSTER_UNIT. clang has accepted each, with -Wall -Werror, in
# the build, so asking clang -fsyntax-only again (--clang) only repeats that. The checks without input are the
# snippets' command's (--files-only), with the same language and seed.
sources_file=$(mktemp)
./build.sh print-sources > "$sources_file"
mapfile -d '' -t sources < "$sources_file"
rm "$sources_file"
units=()
for unit in "${sources[@]}"; do
    [[ "${unit##*/}" == main_unit_* ]] || units+=("$unit")
done
test "${#units[@]}" -gt 0
mapfile -d '' -t host_flags < <(./build.sh print-host-flags)
test "${#host_flags[@]}" -gt 0
"$BUSTER_COMPILER" test-parser --files-only "${host_flags[@]}" -Isrc -fwrapv -funsigned-char --predefines build/predefines.h "${units[@]}"
== Test Tier 0
# Generated programs compiled by both paths, which must agree, run against an interpreter of the typed stream;
# --cross-check also runs them beside clang -O0's builds of the same programs as C, and links those that pass
# structs and unions by value with clang's functions, calls crossing both ways.
"$BUSTER_COMPILER" test-tier0 --cross-check
== Test Tier 0's inlining of always_inline functions
# #1398: the driver fixture's bodies and the compiler's own main.c spliced by the vector path and its scalar twin,
# which must give the same streams, each accepted by tier0_validate and compiled.
"$BUSTER_COMPILER" test-tier0-inline
mapfile -d '' -t host_flags < <(./build.sh print-host-flags)
test "${#host_flags[@]}" -gt 0
"$BUSTER_COMPILER" test-tier0-inline "${host_flags[@]}" -Isrc -fwrapv -funsigned-char -fno-strict-aliasing -DBUSTER_COMPLETE_DRIVER=1 src/buster/compiler/main.c
== Check the repository's translation units with the checker
# #619: run in both hosted variants and the target suite, using the build's expanded arguments (including
# its configured host ISA, target defaults and optimization) rather than shell text from build.sh.
flags_file=$(mktemp)
sources_file=$(mktemp)
BUSTER_DEBUG_INFO=0 ./build.sh print-compile-flags > "$flags_file"
./build.sh print-sources > "$sources_file"
mapfile -d '' -t flags < "$flags_file"
mapfile -d '' -t sources < "$sources_file"
test "${#flags[@]}" -gt 0
test "${#sources[@]}" -gt 0
# #1423: host-only detector and frame controls don't belong to a semantic request. Keep -fsanitize= and -fPIE,
# which affect source feature queries and predefines, and every other build argument. The compiler running this
# check is still instrumented; these exact exclusions don't admit unsupported options to the driver.
check_flags=()
for flag in "${flags[@]}"; do
    case "$flag" in
        -fsanitize-address-use-after-scope|-fsanitize-address-use-after-return=always|-fsanitize-memory-track-origins=2|\
        -fno-sanitize-recover=all|-fno-sanitize-trap=all|-fno-omit-frame-pointer|-fno-optimize-sibling-calls) ;;
        *) check_flags+=("$flag") ;;
    esac
done
for unit in "${sources[@]}"; do
    [[ "${unit##*/}" == main_unit_* ]] && continue
    "$BUSTER_COMPILER" -fsyntax-only "${check_flags[@]}" "$unit"
done
rm "$flags_file" "$sources_file"
== Compare -c's functions and objects with clang -O0 -c's on frozen musl sources
# #129: each source the checker accepts is written as -c writes it, and must define what clang -O0 -c's object
# does, but for the three documented reasons (docs/c-lowering.md); a file the backend refuses is counted with the
# feature it names. Its acceptance against clang -fsyntax-only is compared too, as for any corpus. These eight
# directories' 542 files that the backend lowers, with every explained difference of musl's (math's), must all
# be compared: a backend that came to refuse them would otherwise pass by comparing none.
unset CPATH C_INCLUDE_PATH
export SOURCE_DATE_EPOCH=1792454400
corpus=$BUSTER_CORPUS
musl="$corpus/libc/musl"
"$BUSTER_COMPILER" test-checker-corpus --clang clang --symbols-minimum 542 --no-default-config --target=x86_64-linux-gnu -march=znver5 -std=c99 -ffreestanding -nostdinc -D_XOPEN_SOURCE=700 -Os -pipe \
  -I "$musl/arch/x86_64" -I "$musl/arch/generic" -I "$corpus/musl-generated/obj/src/internal" -I "$musl/src/include" -I "$musl/src/internal" -I "$corpus/musl-generated/obj/include" -I "$musl/include" \
  "$musl/src/math" "$musl/src/string" "$musl/src/stdlib" "$musl/src/fenv" "$musl/src/legacy" "$musl/src/process" "$musl/src/signal" "$musl/src/multibyte"
