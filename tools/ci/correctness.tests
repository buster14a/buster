== Dispatch Tier 1's program measurement and refuse its incomplete commands
# #1189's measure-tier1-programs runs on the 9700X only where `tier1_programs` changes (Tier 1's input and pipeline, and
# the measurement), so its dispatch in main.c is checked here, on every run, without timing anything: a command without
# its inputs must print the command's usage and fail, and one whose inputs aren't there must fail its first build.
errors=$(mktemp)
directory=$(mktemp -d)
if "$BUSTER_COMPILER" measure-tier1-programs --runs 1 > /dev/null 2> "$errors"; then exit 1; fi
grep -q '^usage: measure-tier1-programs --clang PATH' "$errors"
if "$BUSTER_COMPILER" measure-tier1-programs --runs 1 --clang clang --sqlite "$directory/none" --speedtest "$directory/none" --lua "$directory/none" \
    --scripts "$directory/none" --directory "$directory" > "$errors" 2>&1; then exit 1; fi
grep -q "^measure-tier1-programs: Tier 0's builds FAILED$" "$errors"
rm -rf "$errors" "$directory"
== Measure the frames and keep the frame pointer on request
# #177: measure-frames reads each function's frame from an object's code, and -fno-omit-frame-pointer keeps one in every
# function, by Tier 0 and by Tier 1, a leaf among them, which -momit-leaf-frame-pointer leaves out; without the option
# neither tier keeps one. The depth follows the control flow (#1415's review): an early return's epilogue takes nothing
# from the deeper path after it (168 bytes, where the instructions' address order would say 128), a jump table's target
# takes its indirect jump's depth (assumed), and two paths that join at different depths are unresolved and left out of
# the comparison. rbp's depth is each path's too: two arms that set it at different depths, each with its own `leave`,
# make an 80-byte frame, resolved. A command without files prints its usage and fails.
directory=$(mktemp -d)
printf 'int g(char*);\nint f(int x) { char b[4096]; b[x & 4095] = 1; return g(b); }\nint leaf(int x) { return x + 1; }\n' > "$directory/f.c"
"$BUSTER_COMPILER" -c -o "$directory/t0.o" "$directory/f.c"
"$BUSTER_COMPILER" -c -fno-omit-frame-pointer -o "$directory/t0fp.o" "$directory/f.c"
"$BUSTER_COMPILER" --tier1 --tier1-strict -c -fno-omit-frame-pointer -o "$directory/t1fp.o" "$directory/f.c"
"$BUSTER_COMPILER" --tier1 --tier1-strict -c -fno-omit-frame-pointer -momit-leaf-frame-pointer -o "$directory/t1leaf.o" "$directory/f.c"
"$BUSTER_COMPILER" measure-frames --functions t0="$directory/t0.o" t0fp="$directory/t0fp.o" t1fp="$directory/t1fp.o" t1leaf="$directory/t1leaf.o" > "$directory/frames.txt"
grep -q "$(printf '^frame\tt0\tleaf\t0\t0\t0\t0\tresolved$')" "$directory/frames.txt"
grep -q "$(printf '^frame\tt0fp\tleaf\t8\t0\t1\t0\tresolved$')" "$directory/frames.txt"
grep -q "$(printf '^frame\tt1fp\tleaf\t8\t0\t1\t0\tresolved$')" "$directory/frames.txt"
grep -q "$(printf '^frame\tt1leaf\tleaf\t0\t0\t0\t0\tresolved$')" "$directory/frames.txt"
awk -F'\t' '$1 == "frame" && $3 == "f" && $4 > 4096 && ($2 == "t0") == ($6 == 0) && $8 == "resolved" { found += 1 } END { exit found != 4 }' "$directory/frames.txt"
grep -q "$(printf '^frames\tt1leaf\tfunctions=2\tbytes=[0-9]*\tassumed=0\tunresolved=0\tpartial=0\t')" "$directory/frames.txt"
printf '%s\n' '    .text' '    .globl early' '    .type early, @function' 'early:' '    push %rbp' '    sub $32, %rsp' '    test %edi, %edi' '    je 1f' \
    '    add $32, %rsp' '    pop %rbp' '    ret' '1:' '    sub $128, %rsp' '    add $160, %rsp' '    pop %rbp' '    ret' '    .size early, .-early' \
    '    .globl table' '    .type table, @function' 'table:' '    push %rbx' '    sub $16, %rsp' '    lea 2f(%rip), %rax' '    jmp *%rax' '    int3' '2:' \
    '    sub $64, %rsp' '    add $80, %rsp' '    pop %rbx' '    ret' '    .size table, .-table' '    .globl conflict' '    .type conflict, @function' \
    'conflict:' '    test %edi, %edi' '    je 3f' '    push %rbx' '3:' '    ret' '    .size conflict, .-conflict' '    .globl tail' '    .type tail, @function' \
    'tail:' '    push %rbx' '    test %edi, %edi' '    je 4f' '    pop %rbx' '    jmp elsewhere' '4:' '    sub $16, %rsp' '    add $16, %rsp' '    pop %rbx' '    ret' \
    '    .size tail, .-tail' '    .globl padded' '    .type padded, @function' 'padded:' '    push %rbx' '    test %edi, %edi' '    je 5f' '    jmp 6f' '    nop' \
    '7:' '    dec %rdi' '6:' '    cmp $0, %rdi' '    jne 7b' '    pop %rbx' '    jmp *(%rax)' '5:' '    pop %rbx' '    ret' '    .size padded, .-padded' \
    '    .globl split' '    .type split, @function' 'split:' '    test %edi, %edi' '    je 8f' '    push %rbp' '    mov %rsp, %rbp' '    sub $32, %rsp' '    leave' \
    '    ret' '8:' '    push %rbx' '    push %rbp' '    mov %rsp, %rbp' '    sub $64, %rsp' '    leave' '    pop %rbx' '    ret' '    .size split, .-split' > "$directory/paths.s"
"$BUSTER_COMPILER" -c -o "$directory/paths.o" "$directory/paths.s"
"$BUSTER_COMPILER" measure-frames --functions paths="$directory/paths.o" > "$directory/paths.txt"
grep -q "$(printf '^frame\tpaths\tearly\t168\t0\t0\t0\tresolved$')" "$directory/paths.txt"
grep -q "$(printf '^frame\tpaths\ttable\t88\t0\t0\t0\tassumed$')" "$directory/paths.txt"
grep -q "$(printf '^frame\tpaths\tconflict\t[0-9]*\t0\t0\t0\tunresolved$')" "$directory/paths.txt"
# A tail call's jump, whose displacement an object leaves to its relocation, leaves the function: no edge to the next
# instruction, whose depth the other path gives.
grep -q "$(printf '^frame\tpaths\ttail\t24\t0\t0\t0\tresolved$')" "$directory/paths.txt"
# An indirect tail call gives the code no edge reaches its depth, but not the nop that pads a loop's head after a jump.
grep -q "$(printf '^frame\tpaths\tpadded\t8\t0\t0\t0\tresolved$')" "$directory/paths.txt"
# Each arm sets rbp at its own depth (8 and 16) and its `leave` goes back to it: the deeper arm's 80 bytes, resolved.
grep -q "$(printf '^frame\tpaths\tsplit\t80\t0\t1\t0\tresolved$')" "$directory/paths.txt"
grep -q "$(printf '^frames\tpaths\tfunctions=6\tbytes=[0-9]*\tassumed=1\tunresolved=1\tpartial=0\tagainst=paths\tcommon=5\texcluded=1\t')" "$directory/paths.txt"
if "$BUSTER_COMPILER" measure-frames > /dev/null 2> "$directory/errors"; then exit 1; fi
grep -q '^usage: compiler measure-frames' "$directory/errors"
rm -rf "$directory"
== Dispatch Tier 1's vector code measurement and refuse its incomplete commands
# #1283's measure-tier1-rows runs on the 9700X only where `tier1_programs` changes, so its dispatch is checked here, on
# every run, without timing anything: a command without --clang must print its usage and fail, and one whose --base isn't
# there must fail that build, after this compiler's Tier 0 builds (compiled for x86-64-v4 on any host, never run).
errors=$(mktemp)
directory=$(mktemp -d)
if "$BUSTER_COMPILER" measure-tier1-rows --runs 1 > /dev/null 2> "$errors"; then exit 1; fi
grep -q '^usage: measure-tier1-rows --clang PATH' "$errors"
if "$BUSTER_COMPILER" measure-tier1-rows --runs 1 --clang clang --base "$directory/none" --march x86-64-v4 --directory "$directory" > "$errors" 2>&1; then exit 1; fi
grep -q "^measure-tier1-rows: Tier 0's builds built$" "$errors"
grep -q "^measure-tier1-rows: --tier1 (base)'s builds FAILED$" "$errors"
rm -rf "$errors" "$directory"
== Test dominators, frontiers and natural loops
"$BUSTER_COMPILER" test-dominators
"$BUSTER_COMPILER" test-ir-source --dominators tests/ir-source/dominators.c
== Test fences and atomic loads and stores through the IR's lowerings, promotion, text and interpreter against clang
# #1059: each fence of a constant order is the typed stream's FENCE and the IR's fence, which both lowerings, both
# promotions and the text's round trip keep, and which the program's run in the IR's three forms passes through.
"$BUSTER_COMPILER" test-ir-source --dominators tests/ir-source/fences.c
"$BUSTER_COMPILER" test-ssa-source --clang clang tests/ir-source/fences.c
# Each aligned atomic load and store of a constant order is the typed stream's marked LOAD or SET and the IR's atomic
# access, which promotion leaves in memory and the run passes through alike. Seq_cst stores become xchg at emission.
"$BUSTER_COMPILER" test-ir-source --dominators tests/ir-source/atomics.c
"$BUSTER_COMPILER" test-ssa-source --clang clang tests/ir-source/atomics.c
# #1396: initializing stores and assignment results, with the desired value live past xchg, through both interpreters
# and both native Tier 1 paths. Unit tests also keep undefined-byte checking enabled for the initializing stores.
"$BUSTER_COMPILER" test-ir-source --dominators tests/ir-source/atomic-stores.c
"$BUSTER_COMPILER" test-ssa-source --typed --tier1 --clang clang tests/ir-source/atomic-stores.c
# The verifier refuses an atomic access aligned below its size; the long's store and load, lowered and promoted,
# print their natural alignment.
test "$("$BUSTER_COMPILER" test-ir-source --print published tests/ir-source/atomics.c | grep -c 'align=8 atomic')" -eq 4
# Each compare-exchange of the fixture's (GNU's, __sync's, C11's and the generic one, twice each, and three implicit
# objects' loops) is the typed stream's ATOMIC_CAS and the IR's `rmw ... cas`, none a helper's call, in both forms.
test "$("$BUSTER_COMPILER" test-ir-source --print exchanged tests/ir-source/atomics.c | grep -c ' cas ')" -eq 26
# Each bitwise, minimum and maximum read/modify/write of the fixture's (twelve, GNU's, __sync's and C11's) is a loop of
# compare-exchanges, the IR's `rmw ... cas`, none a helper's call, in both forms.
test "$("$BUSTER_COMPILER" test-ir-source --print fetched tests/ir-source/atomics.c | grep -c ' cas ')" -eq 24
