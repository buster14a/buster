./build/compiler test-ssa-ir
== Lower every function of c-testsuite's programs and the frozen SQLite and musl sources into the IR
# #131: each function -c compiles lowered by both paths, which must agree and verify, then promoted by both of
# ssa_ir.c's paths, whose results verify with dominance. sqlite3.c with benchmark-backend-source's options, and
# musl's 1,355 units with its build's (of which -c compiles 1,049; it refuses the others' features by name).
unset CPATH C_INCLUDE_PATH
export SOURCE_DATE_EPOCH=1792454400
corpus=$BUSTER_CORPUS
musl="$corpus/libc/musl"
./build/compiler test-ir-source --dominators $(sed -n 's|^\([0-9][0-9]*\)$|build/c-testsuite/tests/single-exec/\1.c|p' tests/c-testsuite/subset.txt)
./build/compiler test-ir-source --dominators --predefines "$corpus/provenance/gnu17-pinned-predefines.txt" --no-default-config --target=x86_64-linux-gnu -march=znver5 -std=gnu17 -nostdinc -isystem "$corpus/headers/usr/lib/clang/23/include" -isystem "$corpus/headers/usr/local/include" -isystem "$corpus/headers/usr/include" "$corpus/sqlite/sqlite3.c"
./build/compiler test-ir-source --dominators --no-default-config --target=x86_64-linux-gnu -march=znver5 -std=c99 -ffreestanding -nostdinc -D_XOPEN_SOURCE=700 -Os \
  -I "$musl/arch/x86_64" -I "$musl/arch/generic" -I "$corpus/musl-generated/obj/src/internal" -I "$musl/src/include" -I "$musl/src/internal" -I "$corpus/musl-generated/obj/include" -I "$musl/include" \
  "$musl"/src/*/*.c "$musl"/src/*/x86_64/*.c
== Allocate every function of c-testsuite's programs and the frozen SQLite and musl sources over its CFG
# #140: each function -c compiles, lowered and promoted as test-ir-source does, adapted to an allocation problem
# (tier1_cfg_ir.c's machine model), allocated by both of tier1_cfg.c's paths and checked by tier1_cfg_verify.
unset CPATH C_INCLUDE_PATH
export SOURCE_DATE_EPOCH=1792454400
corpus=$BUSTER_CORPUS
musl="$corpus/libc/musl"
./build/compiler test-tier1-cfg-source $(sed -n 's|^\([0-9][0-9]*\)$|build/c-testsuite/tests/single-exec/\1.c|p' tests/c-testsuite/subset.txt)
# #179: #732's SIMD functions, which the SSA promoter refuses, allocated as lowered, their vcmp masks in the opmask class,
# and the _k* builtins' functions of masks alone, which it promotes, allocated as any other.
./build/compiler test-tier1-cfg-source --simd -march=x86-64-v4 tests/ir/vector-i32.c tests/ir/mask-builtins.c
./build/compiler test-tier1-cfg-source --predefines "$corpus/provenance/gnu17-pinned-predefines.txt" --no-default-config --target=x86_64-linux-gnu -march=znver5 -std=gnu17 -nostdinc -isystem "$corpus/headers/usr/lib/clang/23/include" -isystem "$corpus/headers/usr/local/include" -isystem "$corpus/headers/usr/include" "$corpus/sqlite/sqlite3.c"
./build/compiler test-tier1-cfg-source --no-default-config --target=x86_64-linux-gnu -march=znver5 -std=c99 -ffreestanding -nostdinc -D_XOPEN_SOURCE=700 -Os \
  -I "$musl/arch/x86_64" -I "$musl/arch/generic" -I "$corpus/musl-generated/obj/src/internal" -I "$musl/src/include" -I "$musl/src/internal" -I "$corpus/musl-generated/obj/include" -I "$musl/include" \
  "$musl"/src/*/*.c "$musl"/src/*/x86_64/*.c
