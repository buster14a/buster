#!/bin/sh
# Git's commit-msg hook (AGENTS.md, "David's sign-off"). sign-off-lib.sh
# resolves David's opt-in: a present BUSTER_DCO_SIGN_OFF decides, else Git
# configuration may opt out, else this worktree's marker opts in. Where it is
# on, end the message with his sign-off once, after existing trailers, as
# CONTRIBUTING.md authorizes. Otherwise do nothing, including during rebases
# and cherry-picks: copies keep their existing certifications.
#
# git interpret-trailers runs outside the repository with no configuration, so
# that no trailer.* setting changes the line it adds, but the comment prefix,
# which git stripspace gives as Git itself resolves core.commentChar and
# core.commentString. It runs with --no-divider, since in a commit message a
# "---" line ends nothing. A merge's message has no final newline, and without
# one git interpret-trailers leaves out the blank line before a new trailer
# block. With core.commentChar or core.commentString set to auto, git commit
# picks the comment character of the message it writes, which a hook can't
# learn, nor even whether it wrote comments (GIT_EDITOR=: may be the caller's
# no-op editor), so the hook refuses the commit rather than guess.

. "$(dirname "$0")/sign-off-lib.sh"

dco_consent
if [ "$dco_on" = yes ] && ! dco_copying; then
    if dco_automatic; then
        echo "commit-msg: core.commentChar (or core.commentString) is auto, so this hook can't tell comments from the message. Select an explicit comment prefix for this commit (git -c core.commentChar=# commit ...), or suppress this session's trailer with BUSTER_DCO_SIGN_OFF=off (AGENTS.md, \"David's sign-off\")." >&2
        false
    else
        message="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
        prefix="$(echo x | git stripspace --comment-lines)"
        [ -z "$(tail -c 1 "$message")" ] || echo >> "$message"
        cd / && env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR -u GIT_CONFIG_PARAMETERS -u GIT_CONFIG_COUNT GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null git -c core.commentChar="${prefix% x}" interpret-trailers --in-place --no-divider --where end --if-exists addIfDifferent --if-missing add --trailer "Signed-off-by: David Gonzalez Martin <davidgmbb@gmail.com>" "$message"
    fi
fi
