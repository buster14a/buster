+// Non-atomic op= must retain the RHS type until the corresponding binary
+// operation. This examines canonical IR before any shared preparation pass.
+BUSTER_GLOBAL_LOCAL UnitTestResult c_test_compound_conversion_ir(UnitTestArguments* arguments)
