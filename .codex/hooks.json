{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/.claude/hooks/join-tailnet.sh",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/.githooks/enable-sign-off.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/.claude/hooks/llm-memory.sh start",
            "timeout": 320
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/.claude/hooks/llm-memory.sh stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
